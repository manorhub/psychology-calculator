---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import Card from '@/components/ui/Card.astro';
import { getD1Database } from '@/lib/db/client';
import { NotificationService } from '@/services/notifications/notification.service';

export const prerender = false;

const currentUser = Astro.locals.user;
if (!currentUser) {
  return Astro.redirect('/login');
}

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const notificationService = new NotificationService(db);

const url = new URL(Astro.request.url);
const unreadOnly = url.searchParams.get('unread') === 'true';

const { notifications, total, unreadCount } = await notificationService.getUserNotifications(
  currentUser.id,
  50,
  0,
  unreadOnly
);
---

<DashboardLayout title="Notification Center">
  <div class="space-y-6 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <a href="/dashboard" class="text-xs font-semibold text-teal-600 hover:underline">Dashboard</a>
          <span class="text-xs text-slate-400">/</span>
          <span class="text-xs font-semibold text-slate-600">Notifications</span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Notifications & Activity</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Stay updated on your assessments, AI report synthesis, and account alerts.
        </p>
      </div>

      <div class="flex items-center gap-3">
        {unreadCount > 0 && (
          <button
            id="mark-all-read-btn"
            class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-colors cursor-pointer"
          >
            ✓ Mark All as Read
          </button>
        )}
        <a
          href="/dashboard/settings/notifications"
          class="px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold rounded-xl transition-colors shadow-xs"
        >
          ⚙️ Preferences
        </a>
      </div>
    </div>

    <!-- Filter Pills -->
    <div class="flex items-center gap-2">
      <a
        href="/dashboard/notifications"
        class={`px-3 py-1.5 rounded-full text-xs font-semibold transition-colors ${
          !unreadOnly ? 'bg-teal-600 text-white' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'
        }`}
      >
        All ({total})
      </a>
      <a
        href="/dashboard/notifications?unread=true"
        class={`px-3 py-1.5 rounded-full text-xs font-semibold transition-colors ${
          unreadOnly ? 'bg-teal-600 text-white' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'
        }`}
      >
        Unread ({unreadCount})
      </a>
    </div>

    <!-- Notifications List -->
    {notifications.length === 0 ? (
      <Card class="p-12 text-center border-slate-200 bg-white shadow-xs">
        <span class="text-4xl mb-3 block">🔔</span>
        <h3 class="text-base font-bold text-slate-900 mb-1">
          {unreadOnly ? 'No unread notifications' : 'No notifications yet'}
        </h3>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">
          {unreadOnly
            ? 'You are all caught up! Switch to "All" to view previous history.'
            : 'Notifications regarding your test results, AI report generations, and billing will appear here.'}
        </p>
      </Card>
    ) : (
      <div class="space-y-3">
        {notifications.map((n) => {
          const isUnread = !n.read_at;
          const icon =
            n.type === 'ai_report_ready'
              ? '✨'
              : n.type === 'assessment_completed'
                ? '🎯'
                : n.type === 'subscription_updated'
                  ? '💳'
                  : n.type === 'payment_failed'
                    ? '⚠️'
                    : 'ℹ️';

          return (
            <Card
              class={`p-4 border transition-all ${
                isUnread
                  ? 'bg-teal-50/40 border-teal-200 hover:border-teal-300'
                  : 'bg-white border-slate-200 hover:border-slate-300'
              }`}
            >
              <div class="flex items-start justify-between gap-4">
                <div class="flex items-start gap-3.5">
                  <div class={`w-10 h-10 rounded-xl flex items-center justify-center text-lg shrink-0 ${
                    isUnread ? 'bg-teal-100 text-teal-700' : 'bg-slate-100 text-slate-600'
                  }`}>
                    {icon}
                  </div>

                  <div class="space-y-1">
                    <div class="flex items-center gap-2 flex-wrap">
                      <h4 class="text-sm font-bold text-slate-900">{n.title}</h4>
                      {isUnread && (
                        <span class="w-2 h-2 rounded-full bg-teal-600 shrink-0"></span>
                      )}
                    </div>

                    <p class="text-xs text-slate-600 leading-relaxed">
                      {n.message}
                    </p>

                    <div class="text-[10px] text-slate-400 font-mono pt-1">
                      {new Date(n.created_at).toLocaleString()}
                    </div>
                  </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                  {n.link && (
                    <a
                      href={n.link}
                      onclick={`markRead('${n.id}')`}
                      class="px-3 py-1.5 bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold rounded-lg transition-colors shadow-2xs"
                    >
                      View →
                    </a>
                  )}
                  {isUnread && (
                    <button
                      onclick={`markRead('${n.id}')`}
                      class="p-1.5 text-slate-400 hover:text-slate-700 text-xs font-semibold cursor-pointer"
                      title="Mark as read"
                    >
                      ✓
                    </button>
                  )}
                </div>
              </div>
            </Card>
          );
        })}
      </div>
    )}
  </div>

  <script is:inline>
    async function markRead(id) {
      try {
        await fetch('/api/v1/dashboard/notifications', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'mark_read', id })
        });
        window.location.reload();
      } catch (err) {
        console.error('Failed to mark notification read', err);
      }
    }

    document.getElementById('mark-all-read-btn')?.addEventListener('click', async () => {
      try {
        await fetch('/api/v1/dashboard/notifications', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'mark_all_read' })
        });
        window.location.reload();
      } catch (err) {
        console.error('Failed to mark all notifications read', err);
      }
    });
  </script>
</DashboardLayout>
