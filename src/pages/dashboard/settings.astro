---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Input from '@/components/ui/Input.astro';
import Button from '@/components/ui/Button.astro';

const currentUser = Astro.locals.user;
if (!currentUser) return Astro.redirect('/login?redirect=/dashboard/settings');
---

<DashboardLayout title="Account Settings & Security" description="Manage account credentials, verification, and privacy">
  <div class="max-w-3xl space-y-8">
    <div>
      <h1 class="text-2xl font-black text-slate-900 tracking-tight">Account Settings & Security</h1>
      <p class="text-xs text-slate-500 mt-1">
        Manage your sign-in credentials, verification status, and privacy preferences.
      </p>
    </div>

    <!-- Email & Verification Card -->
    <Card class="p-6 sm:p-8 space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-base font-bold text-slate-900">Email Address</h2>
          <p class="text-xs text-slate-500 font-mono mt-0.5">{currentUser.email}</p>
        </div>

        <Badge variant={currentUser.emailVerified ? 'success' : 'warning'}>
          {currentUser.emailVerified ? 'Verified ✓' : 'Pending Verification'}
        </Badge>
      </div>

      {!currentUser.emailVerified && (
        <div class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-900 flex items-center justify-between">
          <span>Please verify your email to ensure account recovery access.</span>
          <button
            type="button"
            id="resend-verification-btn"
            class="font-bold underline hover:text-amber-950 cursor-pointer"
          >
            Resend Email
          </button>
        </div>
      )}
    </Card>

    <!-- Change Password Card -->
    <Card class="p-6 sm:p-8 space-y-6">
      <div>
        <h2 class="text-base font-bold text-slate-900">Change Password</h2>
        <p class="text-xs text-slate-500 mt-0.5">
          Ensure your account uses a secure password of at least 8 characters.
        </p>
      </div>

      <div id="pwd-msg" class="hidden p-3 rounded-xl text-xs font-bold"></div>

      <form id="change-pwd-form" class="space-y-4">
        <Input
          id="currentPassword"
          name="currentPassword"
          type="password"
          label="Current Password"
          placeholder="••••••••"
          required
          autocomplete="current-password"
        />

        <Input
          id="newPassword"
          name="newPassword"
          type="password"
          label="New Password"
          placeholder="At least 8 characters"
          required
          autocomplete="new-password"
        />

        <Input
          id="confirmNewPassword"
          name="confirmNewPassword"
          type="password"
          label="Confirm New Password"
          placeholder="••••••••"
          required
          autocomplete="new-password"
        />

        <div class="pt-2">
          <Button type="submit" variant="primary" size="sm" id="change-pwd-btn">
            Update Password
          </Button>
        </div>
      </form>
    </Card>

    <!-- Privacy & AI Data Controls -->
    <Card class="p-6 sm:p-8 space-y-4">
      <h2 class="text-base font-bold text-slate-900">Privacy & Data Controls</h2>
      <p class="text-xs text-slate-600 leading-relaxed">
        Psychology Calculator strictly adheres to data minimization. Your assessment answers and scores are evaluated deterministically and AI reports are processed through secure server-side isolation. We never sell or share your personal evaluations.
      </p>
      <div class="flex items-center gap-4 text-xs text-teal-700 font-bold pt-1">
        <a href="/privacy" class="hover:underline">Privacy Policy →</a>
        <a href="/terms" class="hover:underline">Terms of Service →</a>
      </div>
    </Card>

    <!-- Danger Zone: Account Deletion -->
    <Card class="p-6 sm:p-8 space-y-4 border-rose-200 bg-rose-50/20">
      <div>
        <h2 class="text-base font-bold text-rose-900">Danger Zone: Delete Account</h2>
        <p class="text-xs text-slate-600 mt-0.5">
          Permanently delete your personal profile data, assessment histories, and revoke all active sessions. This action cannot be reversed.
        </p>
      </div>

      <div id="delete-msg" class="hidden p-3 rounded-xl text-xs font-bold bg-rose-50 text-rose-800 border border-rose-200"></div>

      <form id="delete-account-form" class="space-y-3 pt-2">
        <Input
          id="passwordConfirmation"
          name="passwordConfirmation"
          type="password"
          label="Confirm Password to Delete"
          placeholder="Enter password to confirm"
          required
        />

        <div class="pt-1">
          <Button type="submit" variant="danger" size="sm" id="delete-btn">
            Permanently Delete Account
          </Button>
        </div>
      </form>
    </Card>
  </div>
</DashboardLayout>

<script is:inline>
  // Password change
  const pwdForm = document.getElementById('change-pwd-form');
  const pwdMsg = document.getElementById('pwd-msg');
  const pwdBtn = document.getElementById('change-pwd-btn');

  pwdForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!pwdBtn || !pwdMsg) return;

    const formData = new FormData(pwdForm);
    const currentPassword = String(formData.get('currentPassword') || '');
    const newPassword = String(formData.get('newPassword') || '');
    const confirmNewPassword = String(formData.get('confirmNewPassword') || '');

    if (newPassword !== confirmNewPassword) {
      pwdMsg.className = 'p-3 rounded-xl text-xs font-bold bg-rose-50 text-rose-800 border border-rose-200 block';
      pwdMsg.innerText = 'New passwords do not match.';
      return;
    }

    pwdBtn.disabled = true;

    try {
      const res = await fetch('/api/auth/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ currentPassword, newPassword })
      });
      const data = await res.json();

      if (data.success) {
        pwdForm.reset();
        pwdMsg.className = 'p-3 rounded-xl text-xs font-bold bg-emerald-50 text-emerald-800 border border-emerald-200 block';
        pwdMsg.innerText = '✓ Password changed successfully!';
      } else {
        pwdMsg.className = 'p-3 rounded-xl text-xs font-bold bg-rose-50 text-rose-800 border border-rose-200 block';
        pwdMsg.innerText = data.error?.message || 'Failed to update password.';
      }
    } catch {
      pwdMsg.className = 'p-3 rounded-xl text-xs font-bold bg-rose-50 text-rose-800 border border-rose-200 block';
      pwdMsg.innerText = 'Network error occurred.';
    } finally {
      pwdBtn.disabled = false;
    }
  });

  // Account deletion
  const deleteForm = document.getElementById('delete-account-form');
  const deleteMsg = document.getElementById('delete-msg');
  const deleteBtn = document.getElementById('delete-btn');

  deleteForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!confirm('Are you absolutely sure you want to permanently delete your account? All progress will be lost.')) {
      return;
    }
    if (!deleteBtn || !deleteMsg) return;

    deleteBtn.disabled = true;
    const formData = new FormData(deleteForm);
    const passwordConfirmation = String(formData.get('passwordConfirmation') || '');

    try {
      const res = await fetch('/api/auth/delete-account', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ passwordConfirmation })
      });
      const data = await res.json();

      if (data.success) {
        window.location.href = '/';
      } else {
        deleteMsg.className = 'p-3 rounded-xl text-xs font-bold bg-rose-50 text-rose-800 border border-rose-200 block';
        deleteMsg.innerText = data.error?.message || 'Account deletion failed.';
        deleteBtn.disabled = false;
      }
    } catch {
      deleteMsg.className = 'p-3 rounded-xl text-xs font-bold bg-rose-50 text-rose-800 border border-rose-200 block';
      deleteMsg.innerText = 'Network error occurred.';
      deleteBtn.disabled = false;
    }
  });
</script>
