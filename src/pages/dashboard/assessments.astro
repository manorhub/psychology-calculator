---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import { getD1Database } from '@/lib/db/client';
import { DashboardService } from '@/services/dashboard.service';

const currentUser = Astro.locals.user;
if (!currentUser) return Astro.redirect('/login?redirect=/dashboard/assessments');

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const dashboardService = new DashboardService(db);

const filter = (Astro.url.searchParams.get('filter') as 'all' | 'completed' | 'in_progress') || 'all';
const assessments = await dashboardService.getUserAssessments(currentUser.id, filter);
---

<DashboardLayout title="My Assessments" description="All your assessment attempts, progress, and history">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">My Assessments</h1>
        <p class="text-xs text-slate-500 mt-1">
          Track all ongoing and past psychometric assessment attempts.
        </p>
      </div>

      <!-- Status Filter Tabs -->
      <div class="flex items-center gap-2 bg-white p-1 border border-slate-200 rounded-xl text-xs font-bold">
        <a
          href="/dashboard/assessments?filter=all"
          class={`px-3 py-1.5 rounded-lg transition-colors ${
            filter === 'all' ? 'bg-teal-600 text-white' : 'text-slate-600 hover:text-slate-900'
          }`}
        >
          All
        </a>
        <a
          href="/dashboard/assessments?filter=in_progress"
          class={`px-3 py-1.5 rounded-lg transition-colors ${
            filter === 'in_progress' ? 'bg-teal-600 text-white' : 'text-slate-600 hover:text-slate-900'
          }`}
        >
          In Progress
        </a>
        <a
          href="/dashboard/assessments?filter=completed"
          class={`px-3 py-1.5 rounded-lg transition-colors ${
            filter === 'completed' ? 'bg-teal-600 text-white' : 'text-slate-600 hover:text-slate-900'
          }`}
        >
          Completed
        </a>
      </div>
    </div>

    <!-- Assessments List -->
    {assessments.length === 0 ? (
      <Card class="p-10 text-center space-y-3">
        <div class="text-3xl">📋</div>
        <h3 class="text-sm font-bold text-slate-800">No assessments found for filter "{filter}".</h3>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">
          Start exploring psychology calculators and assessments to discover insights.
        </p>
        <div class="pt-2">
          <a
            href="/assessments"
            class="inline-flex px-4 py-2 bg-teal-600 text-white rounded-xl text-xs font-bold hover:bg-teal-700"
          >
            Browse All Assessments
          </a>
        </div>
      </Card>
    ) : (
      <Card class="p-0 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-600">
            <thead class="bg-slate-50 text-slate-700 font-bold border-b border-slate-200">
              <tr>
                <th class="p-4">Assessment Name</th>
                <th class="p-4">Category</th>
                <th class="p-4">Status</th>
                <th class="p-4">Progress</th>
                <th class="p-4">Started Date</th>
                <th class="p-4 text-right">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {assessments.map((a) => (
                <tr class="hover:bg-slate-50/50">
                  <td class="p-4 font-bold text-slate-900">{a.assessmentName}</td>
                  <td class="p-4 text-slate-500">{a.categoryName}</td>
                  <td class="p-4">
                    <Badge variant={a.status === 'completed' ? 'success' : 'default'} size="sm">
                      {a.status === 'in_progress' ? 'In Progress' : a.status}
                    </Badge>
                  </td>
                  <td class="p-4 font-mono text-[11px]">
                    {a.status === 'completed' ? (
                      <span class="text-emerald-700 font-bold">100% (Completed)</span>
                    ) : (
                      <span>{a.answeredCount} / {a.totalQuestions} questions</span>
                    )}
                  </td>
                  <td class="p-4 font-mono text-[11px] text-slate-400">
                    {new Date(a.createdAt).toLocaleDateString()}
                  </td>
                  <td class="p-4 text-right">
                    {a.status === 'completed' ? (
                      <a
                        href={`/results/${a.attemptId}`}
                        class="px-3 py-1.5 bg-teal-50 hover:bg-teal-100 text-teal-800 font-bold rounded-lg text-xs"
                      >
                        View Result →
                      </a>
                    ) : (
                      <a
                        href={`/assessments/${a.assessmentSlug}`}
                        class="px-3 py-1.5 bg-teal-600 hover:bg-teal-700 text-white font-bold rounded-lg text-xs shadow-2xs"
                      >
                        Resume →
                      </a>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </Card>
    )}
  </div>
</DashboardLayout>
