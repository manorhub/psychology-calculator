---
import DashboardLayout from '@/layouts/DashboardLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import { getD1Database } from '@/lib/db/client';
import { DashboardService } from '@/services/dashboard.service';

const currentUser = Astro.locals.user;
if (!currentUser) return Astro.redirect('/login?redirect=/dashboard/reports');

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const dashboardService = new DashboardService(db);

const reports = await dashboardService.getUserReports(currentUser.id);
---

<DashboardLayout title="My AI Reports" description="In-depth AI psychological narrative reports and synthesis">
  <div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">Personalized AI Reports</h1>
        <p class="text-xs text-slate-500 mt-1">
          Deep psychological narrative interpretations, interpersonal insights, and growth suggestions.
        </p>
      </div>

      <a
        href="/dashboard/results"
        class="inline-flex items-center justify-center px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold shadow-xs transition-all"
      >
        ✨ Generate from Results
      </a>
    </div>

    {reports.length === 0 ? (
      <Card class="p-10 text-center space-y-3">
        <div class="text-3xl">✨</div>
        <h3 class="text-sm font-bold text-slate-800">No AI reports generated yet.</h3>
        <p class="text-xs text-slate-500 max-w-sm mx-auto">
          You can generate an in-depth AI report for any of your completed assessments.
        </p>
        <div class="pt-2">
          <a
            href="/dashboard/results"
            class="inline-flex px-4 py-2 bg-teal-600 text-white rounded-xl text-xs font-bold hover:bg-teal-700"
          >
            Go to Completed Results
          </a>
        </div>
      </Card>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {reports.map((rep) => (
          <Card class="p-6 space-y-4 hover:border-indigo-400 transition-colors flex flex-col justify-between">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-700">
                  ✨ Comprehensive Report
                </span>
                <Badge variant={rep.status === 'completed' ? 'success' : 'default'} size="sm">
                  {rep.status}
                </Badge>
              </div>

              <h2 class="text-base font-bold text-slate-900">{rep.assessmentName}</h2>

              <div class="p-3 bg-indigo-50/50 border border-indigo-100 rounded-xl space-y-0.5">
                <span class="text-[10px] text-indigo-900 font-bold block">Assessed Profile</span>
                <span class="text-xs font-semibold text-slate-800 block">{rep.primaryArchetype}</span>
              </div>
            </div>

            <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
              <span class="text-[10px] text-slate-400 font-mono">
                {new Date(rep.generatedAt).toLocaleDateString()}
              </span>
              <div class="flex items-center gap-1.5">
                <a
                  href={`/api/v1/reports/${rep.reportId}/pdf`}
                  download
                  class="px-2.5 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-semibold rounded-lg transition-all"
                  title="Download Detailed PDF"
                >
                  📑 PDF
                </a>
                <a
                  href={`/reports/${rep.reportId}`}
                  class="px-3 py-1.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-lg shadow-2xs transition-all"
                >
                  Read Report →
                </a>
              </div>
            </div>
          </Card>
        ))}
      </div>
    )}
  </div>
</DashboardLayout>
