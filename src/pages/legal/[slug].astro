---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getD1Database } from '@/lib/db/client';
import { SettingsService } from '@/services/settings/settings.service';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const settingsService = new SettingsService(db);

const page = await settingsService.getLegalPageBySlug(slug);
if (!page || page.is_published !== 1) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
---

<BaseLayout
  title={page.title}
  description={`Official ${page.title} for Psychology Calculator (psychologycalculator.com).`}
>
  <div class="py-12 bg-slate-50 min-h-[70vh]">
    <div class="max-w-4xl mx-auto px-4 sm:px-6">
      <div class="bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-sm space-y-6">
        <div class="border-b border-slate-100 pb-6">
          <div class="text-xs font-bold text-indigo-600 uppercase tracking-widest mb-2">Legal & Compliance</div>
          <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">{page.title}</h1>
          <p class="text-xs text-slate-400 mt-2">Last updated: {new Date(page.updated_at).toLocaleDateString()}</p>
        </div>

        <div class="prose prose-slate max-w-none text-sm leading-relaxed space-y-4" set:html={page.content_html} />
      </div>
    </div>
  </div>
</BaseLayout>
