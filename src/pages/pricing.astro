---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import { PlanService } from '@/services/billing/plan.service';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = env?.DB || null;

const planService = new PlanService(db);
const plans = await planService.getActivePlans();
const user = Astro.locals.user || null;

const freePlan = plans.find((p) => p.slug === 'free') || {
  name: 'Free Explorer',
  slug: 'free',
  description: 'Essential psychological self-discovery tools and baseline standardized scoring.',
  price: 0,
  features: [
    'Access to all 8 core psychometric assessments',
    'Instant deterministic scoring & dimensional breakdowns',
    'Standard result summary',
    'Community self-reflection guidelines'
  ]
};

const monthlyPlan = plans.find((p) => p.billing_interval === 'monthly' && p.price > 0) || {
  name: 'Psychology Calculator Pro (Monthly)',
  slug: 'pro-monthly',
  description: 'Full access to advanced AI psychological synthesis, in-depth reports, and PDF downloads.',
  price: 14.99,
  features: [
    'Unlimited access to all psychometric assessments',
    'Detailed AI-synthesized narrative reports',
    'Personalized strength & growth opportunities',
    'Export high-resolution vector PDF reports',
    '50 monthly AI interpretation credits included',
    'Priority psychometric support'
  ]
};

const annualPlan = plans.find((p) => p.billing_interval === 'yearly' && p.price > 0) || {
  name: 'Psychology Calculator Pro (Annual)',
  slug: 'pro-annual',
  description: 'Best value. Unlimited psychological insights, AI synthesis, and permanent report archiving.',
  price: 119.99,
  features: [
    'Save over 33% compared to monthly plan',
    'Unlimited access to all psychometric assessments',
    'Detailed AI-synthesized narrative reports',
    'Personalized strength & growth opportunities',
    'Export high-resolution vector PDF reports',
    '100 monthly AI interpretation credits included',
    'Permanent cloud report history & comparisons',
    'Priority psychometric support'
  ]
};
---

<BaseLayout
  title="Pricing & Plans — Psychology Calculator"
  description="Transparent, scientific psychometric subscription plans. Free assessments, in-depth AI psychological interpretations, and exportable reports."
>
  <div class="max-w-6xl mx-auto py-12 sm:py-20 px-4 sm:px-6 lg:px-8 space-y-16">
    <!-- Header -->
    <div class="text-center space-y-4 max-w-3xl mx-auto">
      <Badge variant="info" size="md">Transparent Psychometric Pricing</Badge>
      <h1 class="text-4xl sm:text-5xl font-black text-slate-900 tracking-tight">
        Invest in Scientific <span class="text-indigo-600">Self-Understanding</span>
      </h1>
      <p class="text-base sm:text-lg text-slate-600">
        Choose the level of psychometric depth that fits your self-discovery journey. Free baseline evaluations forever, or unlock in-depth AI synthesis with Pro.
      </p>

      <!-- Interval Switcher -->
      <div class="pt-6 flex items-center justify-center gap-4">
        <span id="monthly-label" class="text-sm font-bold text-indigo-600">Monthly</span>
        <button
          type="button"
          id="interval-toggle"
          class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent bg-indigo-600 transition-colors duration-200 ease-in-out focus:outline-none"
          role="switch"
          aria-checked="true"
        >
          <span
            id="toggle-knob"
            class="translate-x-5 pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow-sm ring-0 transition duration-200 ease-in-out"
          ></span>
        </button>
        <div class="flex items-center gap-1.5">
          <span id="annual-label" class="text-sm font-bold text-slate-500">Annual</span>
          <span class="px-2 py-0.5 text-[10px] font-black uppercase tracking-wider bg-emerald-100 text-emerald-800 rounded-full">
            Save 33%
          </span>
        </div>
      </div>
    </div>

    <!-- Error/Notice Banner -->
    <div id="checkout-msg" class="hidden max-w-md mx-auto p-4 rounded-xl text-xs font-semibold text-center"></div>

    <!-- Pricing Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
      <!-- 1. Free Explorer Card -->
      <Card class="p-8 flex flex-col justify-between border-slate-200 bg-white">
        <div class="space-y-6">
          <div class="space-y-2">
            <h2 class="text-xl font-bold text-slate-900">{freePlan.name}</h2>
            <p class="text-xs text-slate-500 min-h-[36px]">{freePlan.description}</p>
          </div>

          <div class="space-y-1">
            <div class="text-4xl font-black text-slate-900">$0</div>
            <div class="text-xs font-medium text-slate-400">Free forever • No credit card required</div>
          </div>

          <div class="pt-4 border-t border-slate-100 space-y-3">
            <span class="text-xs font-bold text-slate-700 uppercase tracking-wider block">Included Features:</span>
            <ul class="space-y-2.5 text-xs text-slate-600">
              {freePlan.features.map((f: string) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-500 font-bold">✓</span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="pt-8">
          <a
            href={user ? '/dashboard' : '/register'}
            class="w-full block py-3 text-center text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-xl transition-all"
          >
            {user ? 'Go to Dashboard' : 'Get Started Free'}
          </a>
        </div>
      </Card>

      <!-- 2. Pro Monthly Card -->
      <div id="monthly-card" class="hidden">
        <Card class="p-8 flex flex-col justify-between border-indigo-200 bg-gradient-to-b from-indigo-50/40 to-white relative h-full">
          <div class="space-y-6">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <h2 class="text-xl font-bold text-slate-900">{monthlyPlan.name}</h2>
                <Badge variant="info" size="sm">Popular</Badge>
              </div>
              <p class="text-xs text-slate-500 min-h-[36px]">{monthlyPlan.description}</p>
            </div>

            <div class="space-y-1">
              <div class="flex items-baseline gap-1">
                <span class="text-4xl font-black text-slate-900">${monthlyPlan.price}</span>
                <span class="text-xs font-bold text-slate-500">/ month</span>
              </div>
              <div class="text-xs font-medium text-slate-400">Cancel anytime • Instant access</div>
            </div>

            <div class="pt-4 border-t border-indigo-100 space-y-3">
              <span class="text-xs font-bold text-indigo-950 uppercase tracking-wider block">Everything in Free, plus:</span>
              <ul class="space-y-2.5 text-xs text-slate-700">
                {monthlyPlan.features.map((f: string) => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-indigo-600 font-bold">✓</span>
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="pt-8">
            <button
              type="button"
              data-plan-slug="pro-monthly"
              class="checkout-btn w-full py-3 text-center text-xs font-bold bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow-md transition-all cursor-pointer"
            >
              Start Monthly Pro →
            </button>
          </div>
        </Card>
      </div>

      <!-- 3. Pro Annual Card -->
      <div id="annual-card" class="block col-span-1 md:col-span-1 lg:col-span-2">
        <Card class="p-8 sm:p-10 flex flex-col lg:flex-row justify-between border-2 border-indigo-500 bg-gradient-to-br from-indigo-950 via-slate-900 to-indigo-950 text-white relative shadow-xl">
          <div class="absolute -top-3.5 right-6">
            <span class="px-3.5 py-1 text-xs font-black uppercase tracking-wider bg-gradient-to-r from-emerald-400 to-teal-400 text-slate-950 rounded-full shadow-md">
              ✨ Best Value (Save 33%)
            </span>
          </div>

          <div class="space-y-6 lg:max-w-md">
            <div class="space-y-2">
              <h2 class="text-2xl font-black text-white">{annualPlan.name}</h2>
              <p class="text-xs sm:text-sm text-indigo-200/80">{annualPlan.description}</p>
            </div>

            <div class="space-y-1">
              <div class="flex items-baseline gap-2">
                <span class="text-5xl font-black text-white">${annualPlan.price}</span>
                <span class="text-xs font-bold text-indigo-300">/ year (approx. $9.99/mo)</span>
              </div>
              <div class="text-xs text-indigo-300/70">Billed annually • 100 AI interpretation credits included</div>
            </div>

            <div class="pt-4 border-t border-indigo-800/60">
              <button
                type="button"
                data-plan-slug="pro-annual"
                class="checkout-btn w-full sm:w-auto px-8 py-3.5 text-center text-xs font-black bg-white hover:bg-indigo-50 text-slate-950 rounded-xl shadow-lg transition-all cursor-pointer"
              >
                Get Pro Annual Access →
              </button>
            </div>
          </div>

          <div class="pt-6 lg:pt-0 lg:pl-10 lg:border-l lg:border-indigo-800/60 flex flex-col justify-center space-y-3">
            <span class="text-xs font-bold uppercase tracking-wider text-indigo-300">Annual Member Benefits:</span>
            <ul class="space-y-2.5 text-xs text-indigo-100">
              {annualPlan.features.map((f: string) => (
                <li class="flex items-start gap-2.5">
                  <span class="text-emerald-400 font-bold">✓</span>
                  <span>{f}</span>
                </li>
              ))}
            </ul>
          </div>
        </Card>
      </div>
    </div>

    <!-- FAQ Section -->
    <div class="pt-12 border-t border-slate-200 max-w-4xl mx-auto space-y-8">
      <div class="text-center space-y-2">
        <h2 class="text-2xl font-black text-slate-900">Frequently Asked Questions</h2>
        <p class="text-xs text-slate-500">Everything you need to know about our billing and subscriptions</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
        <Card class="p-6 space-y-2">
          <h3 class="font-bold text-slate-900">Can I cancel my subscription anytime?</h3>
          <p class="text-slate-600 leading-relaxed">
            Yes. You can cancel with one click from your dashboard at any time. You will retain full Pro access until the end of your current paid billing period.
          </p>
        </Card>

        <Card class="p-6 space-y-2">
          <h3 class="font-bold text-slate-900">What payment methods are supported?</h3>
          <p class="text-slate-600 leading-relaxed">
            All payments are securely processed by Lemon Squeezy, our official Merchant of Record. We accept Visa, Mastercard, American Express, Apple Pay, Google Pay, and PayPal.
          </p>
        </Card>

        <Card class="p-6 space-y-2">
          <h3 class="font-bold text-slate-900">How do AI Interpretation credits work?</h3>
          <p class="text-slate-600 leading-relaxed">
            Each comprehensive narrative report costs 5 credits. Monthly Pro plans include 50 credits/mo, while Annual Pro plans include 100 credits/mo.
          </p>
        </Card>

        <Card class="p-6 space-y-2">
          <h3 class="font-bold text-slate-900">Is my psychological data confidential?</h3>
          <p class="text-slate-600 leading-relaxed">
            Absolutely. Your responses and generated reports are encrypted and strictly confidential. We never sell your personal or psychometric data to advertisers.
          </p>
        </Card>
      </div>
    </div>
  </div>

  <script>
    const toggleBtn = document.getElementById('interval-toggle');
    const knob = document.getElementById('toggle-knob');
    const monthlyLabel = document.getElementById('monthly-label');
    const annualLabel = document.getElementById('annual-label');
    const monthlyCard = document.getElementById('monthly-card');
    const annualCard = document.getElementById('annual-card');
    const checkoutMsg = document.getElementById('checkout-msg');
    let isAnnual = true;

    function updateView() {
      if (isAnnual) {
        knob?.classList.remove('translate-x-0');
        knob?.classList.add('translate-x-5');
        monthlyLabel?.classList.replace('text-indigo-600', 'text-slate-500');
        annualLabel?.classList.replace('text-slate-500', 'text-indigo-600');
        monthlyCard?.classList.add('hidden');
        annualCard?.classList.remove('hidden');
      } else {
        knob?.classList.remove('translate-x-5');
        knob?.classList.add('translate-x-0');
        monthlyLabel?.classList.replace('text-slate-500', 'text-indigo-600');
        annualLabel?.classList.replace('text-indigo-600', 'text-slate-500');
        monthlyCard?.classList.remove('hidden');
        annualCard?.classList.add('hidden');
      }
    }

    toggleBtn?.addEventListener('click', () => {
      isAnnual = !isAnnual;
      updateView();
    });

    // Checkout Trigger
    document.querySelectorAll('.checkout-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const planSlug = target.getAttribute('data-plan-slug');
        if (!planSlug) return;

        target.disabled = true;
        const originalText = target.textContent;
        target.textContent = 'Preparing checkout...';

        try {
          const res = await fetch('/api/v1/billing/checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ planSlug })
          });

          const data = (await res.json()) as any;

          if (res.status === 401) {
            window.location.href = `/register?redirect=/pricing`;
            return;
          }

          if (!res.ok) {
            throw new Error(data.error?.message || 'Failed to initialize checkout');
          }

          if (data.data?.checkoutUrl) {
            window.location.href = data.data.checkoutUrl;
          }
        } catch (err: any) {
          if (checkoutMsg) {
            checkoutMsg.textContent = `❌ ${err.message || 'Checkout failed'}`;
            checkoutMsg.className = 'max-w-md mx-auto p-4 rounded-xl text-xs font-semibold text-center bg-rose-50 text-rose-800 border border-rose-200 block';
          }
          target.disabled = false;
          target.textContent = originalText;
        }
      });
    });
  </script>
</BaseLayout>
