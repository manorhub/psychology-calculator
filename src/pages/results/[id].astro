---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/ui/Card.astro';
import ResultHero from '@/components/results/ResultHero.astro';
import ResultQuickNav from '@/components/results/ResultQuickNav.astro';
import DimensionProfile from '@/components/results/DimensionProfile.astro';
import StrengthsSection from '@/components/results/StrengthsSection.astro';
import GrowthSection from '@/components/results/GrowthSection.astro';
import LifeContextSection from '@/components/results/LifeContextSection.astro';
import ReflectionSection from '@/components/results/ReflectionSection.astro';
import PremiumAiCta from '@/components/results/PremiumAiCta.astro';
import GuestSaveBanner from '@/components/results/GuestSaveBanner.astro';
import AiGenerationExperience from '@/components/results/AiGenerationExperience.astro';
import { getD1Database } from '@/lib/db/client';
import { ResultService } from '@/services/result.service';

const { id } = Astro.params;
if (!id) return Astro.redirect('/');

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
if (!db) return Astro.redirect('/');

const resultService = new ResultService(db);

const url = Astro.url;
const shareToken = url.searchParams.get('token');
const currentUser = Astro.locals.user;
const guestSessionId = Astro.cookies.get('mm_guest_id')?.value || null;

let resultData;
try {
  resultData = await resultService.getResult(
    id,
    currentUser?.id || null,
    guestSessionId,
    shareToken
  );
} catch (error: any) {
  if (error.statusCode === 403 || error.statusCode === 404) {
    return new Response(
      `<!DOCTYPE html><html><head><title>Result Not Available</title><meta name="viewport" content="width=device-width, initial-scale=1.0"><link rel="stylesheet" href="https://cdn.tailwindcss.com"></head><body class="bg-slate-50 min-h-screen flex items-center justify-center p-4 font-sans"><div class="max-w-md w-full bg-white p-8 rounded-3xl border border-slate-200 shadow-xl space-y-4 text-center"><div class="w-12 h-12 bg-amber-50 text-amber-600 rounded-2xl mx-auto flex items-center justify-center text-xl font-bold">🔒</div><h2 class="text-xl font-black text-slate-900">Result Not Found or Access Denied</h2><p class="text-xs text-slate-600 leading-relaxed">This assessment attempt is either private or has expired.</p><div class="pt-2"><a href="/assessments" class="inline-block px-5 py-2.5 bg-slate-900 hover:bg-black text-white text-xs font-bold rounded-xl transition-colors">Browse Assessments</a></div></div></body></html>`,
      { status: error.statusCode, headers: { 'Content-Type': 'text/html; charset=utf-8' } }
    );
  }
  return Astro.redirect('/');
}

const { snapshot, isSharedView, shareToken: activeShareToken } = resultData;
const { CreditService } = await import('@/services/credit.service');
const creditService = new CreditService(db);

const [relatedAssessments, faqs, existingReport, userWallet, reportCost] = await Promise.all([
  resultService.getRelatedAssessments(snapshot.assessmentId, snapshot.assessmentId, 3),
  resultService.getAssessmentFaqs(snapshot.assessmentId),
  db.prepare("SELECT id FROM reports WHERE attempt_id = ? AND report_type = 'ai' AND status = 'completed'").bind(id).first<{ id: string }>(),
  currentUser ? creditService.getUserWallet(currentUser.id) : null,
  creditService.getReportCreditCost()
]);

// Organize primary result type contents into distinct contextual buckets
const contents = snapshot.primaryResultType?.contents || [];

const overviewContent = contents.find((c) => c.section_type === 'overview');
const strengthsContent = contents.find((c) => c.section_type === 'strengths');
const growthContent = contents.find((c) => c.section_type === 'growth_suggestions' || c.section_type === 'challenges');
const contextContents = contents.filter((c) => ['work_style', 'communication', 'relationships', 'recommendations', 'custom'].includes(c.section_type));

const hasDimensions = snapshot.dimensionScores && snapshot.dimensionScores.length > 0;
const hasStrengths = !!strengthsContent || (snapshot.primaryResultType?.description?.length ?? 0) > 0;
const hasGrowth = !!growthContent;
const hasContexts = contextContents.length > 0;
---

<BaseLayout
  title={`Results: ${snapshot.assessmentName} | Psychology Calculator`}
  description={`Standardized psychometric evaluation and dimensional profile breakdown for ${snapshot.assessmentName}`}
>
  <!-- Privacy & Anti-Scraping: Strictly Noindex for personal test outcomes -->
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <div class="max-w-4xl mx-auto py-6 sm:py-10 px-4 sm:px-6 space-y-8 sm:space-y-12">
    <!-- Top Action & Navigation Breadcrumb Bar -->
    <div class="flex flex-wrap items-center justify-between gap-3 no-print">
      <div class="flex flex-wrap items-center gap-2">
        {currentUser ? (
          <a
            href="/dashboard"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-white hover:bg-slate-100 text-slate-800 text-xs font-bold rounded-xl border border-slate-200 shadow-2xs transition-all"
          >
            <span>📊</span>
            <span>Back to Dashboard</span>
          </a>
        ) : (
          <a
            href="/assessments"
            class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-white hover:bg-slate-100 text-slate-800 text-xs font-bold rounded-xl border border-slate-200 shadow-2xs transition-all"
          >
            <span>📝</span>
            <span>Browse Tests</span>
          </a>
        )}
        <a
          href={`/assessments/${snapshot.assessmentSlug}/take`}
          class="inline-flex items-center gap-1.5 px-3.5 py-2 bg-white hover:bg-slate-100 text-slate-700 text-xs font-semibold rounded-xl border border-slate-200 shadow-2xs transition-all"
        >
          <span>🔄</span>
          <span>Retake Test</span>
        </a>
      </div>

      <a
        href="/assessments"
        class="text-xs font-semibold text-teal-700 hover:text-teal-800 flex items-center gap-1"
      >
        <span>Explore All Tests</span>
        <span>→</span>
      </a>
    </div>

    <!-- Shared View Notice Banner (Only if viewed via share link) -->
    {isSharedView && (
      <div class="p-4 bg-amber-50 border border-amber-200 rounded-2xl text-xs text-amber-900 flex items-center justify-between gap-3">
        <div class="flex items-center gap-2.5">
          <span class="text-base">🔗</span>
          <span>You are viewing a shared assessment result link.</span>
        </div>
        <a href={`/assessments/${snapshot.assessmentSlug}`} class="font-bold text-amber-950 underline flex-shrink-0">
          Take This Assessment Yourself →
        </a>
      </div>
    )}

    <!-- 1. Result Hero Component -->
    <ResultHero
      snapshot={snapshot}
      isSharedView={isSharedView}
      activeShareToken={activeShareToken}
    />

    <!-- 2. Sticky Quick Jump Sub-Navigation -->
    <ResultQuickNav
      hasDimensions={hasDimensions}
      hasStrengths={hasStrengths}
      hasGrowth={hasGrowth}
      hasContexts={hasContexts}
      hasReflection={true}
      hasAiReport={true}
    />

    <!-- 3. Guest Account Conversion Banner (if unauthenticated) -->
    {!currentUser && !isSharedView && (
      <GuestSaveBanner attemptId={snapshot.attemptId} />
    )}

    <!-- 4. Result Summary: What Your Result Means -->
    <section class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-2xs space-y-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-teal-50 text-teal-700 flex items-center justify-center text-lg border border-teal-200">
          🔍
        </div>
        <div>
          <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
            What Your Result Means
          </h2>
          <p class="text-xs sm:text-sm text-slate-500">
            Psychometric interpretation grounded in standardized self-report evaluation
          </p>
        </div>
      </div>

      <div class="text-xs sm:text-sm text-slate-700 leading-relaxed space-y-3 pt-2">
        {overviewContent ? (
          <div class="whitespace-pre-line leading-relaxed">
            {overviewContent.content}
          </div>
        ) : (
          <p>
            Your responses on the <strong class="text-slate-900 font-semibold">{snapshot.assessmentName}</strong> indicate an overall normalized score of <strong class="text-slate-900 font-mono font-semibold">{snapshot.totalNormalizedScore}%</strong>, corresponding to the primary archetype <strong class="text-teal-800 font-semibold">{snapshot.primaryResultType?.name || 'Assessed Profile'}</strong>. This pattern suggests stable behavioral tendencies in how you process information, navigate social environments, and approach everyday decision-making.
          </p>
        )}
      </div>
    </section>

    <!-- 5. Dimension Profile & Overview (Dynamic for 1, 2, 3, 5, 8+ dimensions) -->
    {hasDimensions && (
      <DimensionProfile dimensions={snapshot.dimensionScores} />
    )}

    <!-- 6. Key Strengths -->
    {hasStrengths && (
      <StrengthsSection strengthsContent={strengthsContent} />
    )}

    <!-- 7. Areas to Consider & Growth Pathways -->
    {hasGrowth && (
      <GrowthSection growthContent={growthContent} />
    )}

    <!-- 8. How This May Show Up in Daily Life -->
    {hasContexts && (
      <LifeContextSection contextContents={contextContents} />
    )}

    <!-- 9. Practical Self-Reflection Prompts -->
    <ReflectionSection
      assessmentName={snapshot.assessmentName}
      archetypeName={snapshot.primaryResultType?.name}
    />

    <!-- 10. Premium AI Report CTA -->
    <PremiumAiCta
      attemptId={snapshot.attemptId}
      assessmentName={snapshot.assessmentName}
      existingReportId={existingReport?.id}
      isGuest={!currentUser}
      userCredits={userWallet?.balance ?? 0}
      creditCost={reportCost}
    />

    <!-- 11. Explore Related Assessments -->
    {relatedAssessments.length > 0 && (
      <section class="space-y-6 pt-6 border-t border-slate-200 no-print">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
              Explore Related Assessments
            </h3>
            <p class="text-xs sm:text-sm text-slate-500 mt-0.5">
              Discover complementary tests to build a complete psychometric profile
            </p>
          </div>
          <a href="/assessments" class="text-xs font-bold text-teal-700 hover:text-teal-800 hidden sm:inline-block">
            View Catalog →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {relatedAssessments.map((ra) => (
            <Card class="p-6 space-y-3 hover:border-teal-500 transition-all flex flex-col justify-between">
              <div class="space-y-1.5">
                <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700 bg-teal-50 px-2 py-0.5 rounded-md inline-block">
                  {ra.category_name}
                </span>
                <h4 class="text-sm font-bold text-slate-900 leading-snug">{ra.name}</h4>
                <p class="text-xs text-slate-500 line-clamp-2">{ra.short_description}</p>
              </div>
              <a
                href={`/assessments/${ra.slug}`}
                class="text-xs font-bold text-teal-700 hover:text-teal-800 pt-2 block border-t border-slate-100"
              >
                Take Assessment →
              </a>
            </Card>
          ))}
        </div>
      </section>
    )}

    <!-- 12. Frequently Asked Questions -->
    {faqs.length > 0 && (
      <section class="space-y-4 pt-6 border-t border-slate-200 no-print">
        <h3 class="text-lg font-bold text-slate-900">Frequently Asked Questions</h3>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="p-4 bg-white border border-slate-200 rounded-2xl text-xs group">
              <summary class="font-bold text-slate-800 cursor-pointer flex items-center justify-between list-none">
                <span>{faq.question}</span>
                <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <p class="mt-2 text-slate-600 leading-relaxed pt-2 border-t border-slate-100">
                {faq.answer}
              </p>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- 13. Educational & Clinical Disclaimer -->
    <div class="p-6 bg-slate-100/80 border border-slate-200 rounded-3xl text-[11px] text-slate-500 text-center leading-relaxed space-y-1">
      <strong class="text-slate-700 block text-xs">Psychological & Educational Disclaimer</strong>
      <p>
        {snapshot.disclaimer ||
          'This assessment is intended for educational, personal reflection, and self-discovery purposes only. It does not constitute a clinical psychological diagnosis or a substitute for professional medical or mental health advice.'}
      </p>
    </div>

    <!-- 14. Bottom Actions -->
    <div class="pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 no-print">
      <div class="flex flex-wrap items-center gap-3">
        {currentUser ? (
          <a
            href="/dashboard"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 bg-teal-50 hover:bg-teal-100 text-teal-800 text-xs font-bold rounded-xl border border-teal-200 shadow-2xs transition-all"
          >
            <span>📊</span>
            <span>Back to Dashboard</span>
          </a>
        ) : (
          <a
            href="/assessments"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 bg-teal-50 hover:bg-teal-100 text-teal-800 text-xs font-bold rounded-xl border border-teal-200 shadow-2xs transition-all"
          >
            <span>📝</span>
            <span>Browse More Assessments</span>
          </a>
        )}
        <a
          href={`/assessments/${snapshot.assessmentSlug}/take`}
          class="text-xs font-semibold text-slate-600 hover:text-slate-900"
        >
          ← Retake Assessment
        </a>
      </div>

      <a
        href="/assessments"
        class="inline-flex items-center justify-center px-5 py-2.5 text-xs font-bold text-white bg-slate-900 hover:bg-black rounded-xl shadow-xs transition-all"
      >
        Explore All Assessments →
      </a>
    </div>

    <!-- Guest Auth Required Modal -->
    <div
      id="guest-auth-modal"
      class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-xs hidden no-print"
      role="dialog"
      aria-modal="true"
    >
      <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl border border-slate-200 relative animate-in fade-in zoom-in-95 duration-200">
        <!-- Close Button -->
        <button
          type="button"
          id="close-auth-modal"
          class="absolute top-4 right-4 text-slate-400 hover:text-slate-700 w-8 h-8 rounded-full flex items-center justify-center hover:bg-slate-100 transition-colors"
        >
          ✕
        </button>

        <div class="text-center space-y-4">
          <div class="w-14 h-14 bg-indigo-50 border border-indigo-100 text-indigo-600 rounded-2xl mx-auto flex items-center justify-center text-2xl shadow-xs">
            ✨
          </div>

          <div class="space-y-1.5">
            <h3 class="text-xl font-black text-slate-900 tracking-tight">
              Sign In to Unlock AI Report
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              In-depth psychological narrative syntheses and actionable daily growth plans require an account and credits. Sign in or create a free account to continue.
            </p>
          </div>

          <!-- Action Buttons -->
          <div class="pt-3 space-y-2.5">
            <a
              href={`/auth/google?redirect=${encodeURIComponent(`/results/${snapshot.attemptId}`)}`}
              class="w-full py-3 px-4 bg-white hover:bg-slate-50 text-slate-800 font-bold text-xs rounded-xl border border-slate-300 shadow-2xs transition-all flex items-center justify-center gap-2.5"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
              </svg>
              <span>Continue with Google</span>
            </a>

            <div class="relative my-2">
              <div class="absolute inset-0 flex items-center">
                <div class="w-full border-t border-slate-200"></div>
              </div>
              <div class="relative flex justify-center text-[10px] uppercase">
                <span class="bg-white px-2 text-slate-400 font-semibold">Or Email</span>
              </div>
            </div>

            <a
              href={`/register?redirect=${encodeURIComponent(`/results/${snapshot.attemptId}`)}`}
              class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl shadow-xs hover:shadow-sm transition-all flex items-center justify-center gap-2"
            >
              <span>Create Free Account</span>
              <span>→</span>
            </a>

            <a
              href={`/login?redirect=${encodeURIComponent(`/results/${snapshot.attemptId}`)}`}
              class="w-full py-2.5 px-4 bg-slate-50 hover:bg-slate-100 text-slate-700 font-semibold text-xs rounded-xl border border-slate-200 transition-all flex items-center justify-center gap-2"
            >
              <span>Sign In to Existing Account</span>
            </a>
          </div>

          <p class="text-[11px] text-slate-400 pt-1">
            New accounts receive free starter credits automatically.
          </p>
        </div>
      </div>
    </div>

    <!-- Premium AI Generation Experience Overlay Modal -->
    <AiGenerationExperience attemptId={snapshot.attemptId} assessmentName={snapshot.assessmentName} />
  </div>
</BaseLayout>

<script is:inline define:vars={{ attemptId: snapshot.attemptId, activeShareToken, isGuest: !currentUser }}>
  const authModal = document.getElementById('guest-auth-modal');
  const closeAuthBtn = document.getElementById('close-auth-modal');

  closeAuthBtn?.addEventListener('click', () => {
    authModal?.classList.add('hidden');
  });

  authModal?.addEventListener('click', (e) => {
    if (e.target === authModal) {
      authModal.classList.add('hidden');
    }
  });

  const shareBtn = document.getElementById('share-result-btn');
  const shareText = document.getElementById('share-btn-text');

  shareBtn?.addEventListener('click', async () => {
    try {
      const res = await fetch(`/api/v1/results/${attemptId}/share`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();

      if (data.success && data.data?.shareUrl) {
        const fullUrl = `${window.location.origin}${data.data.shareUrl}`;
        await navigator.clipboard.writeText(fullUrl);
        if (shareText) shareText.innerText = '✓ Copied Share Link!';
        setTimeout(() => {
          if (shareText) shareText.innerText = 'Copy Share Link';
        }, 3000);
      }
    } catch {
      alert('Unable to generate share link.');
    }
  });

  const aiBtn = document.getElementById('generate-ai-btn');

  aiBtn?.addEventListener('click', async () => {
    // If guest, immediately open the authentication popup
    if (isGuest) {
      authModal?.classList.remove('hidden');
      return;
    }

    // Launch the polished premium AI report generation experience
    if (typeof window.triggerAiReportGeneration === 'function') {
      window.triggerAiReportGeneration();
    }
  });
</script>

<style is:global>
  @media print {
    @page {
      margin: 1.2cm;
      size: auto;
    }

    body {
      background: #ffffff !important;
      color: #0f172a !important;
    }

    .card,
    [class*="rounded-2xl"],
    [class*="rounded-3xl"],
    [class*="rounded-xl"],
    .break-inside-avoid,
    section,
    article,
    .grid > div {
      break-inside: avoid !important;
      page-break-inside: avoid !important;
    }

    h1, h2, h3, h4, h5, h6 {
      break-after: avoid !important;
      page-break-after: avoid !important;
    }

    .no-print,
    header nav,
    nav,
    footer,
    button {
      display: none !important;
    }
  }
</style>
