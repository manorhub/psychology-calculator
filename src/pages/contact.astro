---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SEOHead from '@/components/seo/SEOHead.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import Card from '@/components/ui/Card.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import { SeoService } from '@/services/seo/seo.service';
import { InternalLinkService } from '@/services/seo/internal-link.service';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = env?.DB || null;

const seoService = new SeoService(db);
const linkService = new InternalLinkService(db);

const [pageMeta] = await Promise.all([
  seoService.getPageMetadata({
    pageType: 'page',
    path: '/contact',
    rawTitle: 'Contact Us | Psychology Calculator',
    defaultDescription: 'Get in touch with the Psychology Calculator team regarding assessments, research inquiries, billing, or technical feedback.'
  })
]);

const breadcrumbItems = linkService.getBreadcrumbs([
  { name: 'Contact', path: '/contact' }
]);
---

<BaseLayout>
  <SEOHead
    slot="head"
    title={pageMeta.title}
    description={pageMeta.description}
    canonicalUrl={pageMeta.canonicalUrl}
    noindex={pageMeta.noindex}
    ogType="website"
  />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Business Info -->
      <div class="lg:col-span-5 space-y-6">
        <Badge variant="info" size="md">Direct Inquiries</Badge>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight leading-tight">
          How Can We Help?
        </h1>
        <p class="text-sm text-slate-600 leading-relaxed">
          Whether you have questions regarding psychometric assessments, AI interpretation reports, institutional research, or billing inquiries, our team is here to assist.
        </p>

        <div class="space-y-4 pt-4">
          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-xs">✉️</span>
            <div>
              <div class="text-xs font-bold text-slate-900">Email Support</div>
              <a href="mailto:support@psychologycalculator.com" class="text-xs text-indigo-600 hover:underline">
                support@psychologycalculator.com
              </a>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <span class="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center font-bold text-xs">🔒</span>
            <div>
              <div class="text-xs font-bold text-slate-900">Privacy & Data Requests</div>
              <a href="/p/privacy-policy" class="text-xs text-indigo-600 hover:underline">
                View Privacy Guidelines
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Contact Form -->
      <div class="lg:col-span-7">
        <Card class="p-8 border-slate-200 bg-white shadow-sm">
          <form id="contact-form" class="space-y-4">
            <div>
              <label for="name" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Your Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Jane Doe"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-colors"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="jane@example.com"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-colors"
              />
            </div>

            <div>
              <label for="subject" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Topic</label>
              <select
                id="subject"
                name="subject"
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-colors"
              >
                <option value="general">General Inquiries</option>
                <option value="billing">Billing & Subscriptions</option>
                <option value="research">Assessment & Psychometrics Research</option>
                <option value="technical">Technical Support</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Message</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Please describe how we can assist you..."
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-colors"
              ></textarea>
            </div>

            <div id="contact-feedback" class="hidden text-xs font-semibold p-3 rounded-xl"></div>

            <Button type="submit" id="submit-btn" variant="primary" size="lg" class="w-full">
              Send Message
            </Button>
          </form>
        </Card>
      </div>
    </div>
  </div>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const feedback = document.getElementById('contact-feedback');
    const btn = document.getElementById('submit-btn');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = 'Sending...';
        feedback.className = 'hidden';

        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        try {
          const res = await fetch('/api/v1/content/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();

          if (res.ok && data.success) {
            feedback.className = 'text-xs font-semibold p-3 rounded-xl bg-emerald-50 text-emerald-800 border border-emerald-200 block';
            feedback.textContent = 'Thank you! Your message has been received and our team will get back to you promptly.';
            form.reset();
          } else {
            feedback.className = 'text-xs font-semibold p-3 rounded-xl bg-rose-50 text-rose-800 border border-rose-200 block';
            feedback.textContent = data.message || 'Unable to send message. Please try again.';
          }
        } catch {
          feedback.className = 'text-xs font-semibold p-3 rounded-xl bg-rose-50 text-rose-800 border border-rose-200 block';
          feedback.textContent = 'Network error. Please try again later.';
        } finally {
          btn.disabled = false;
          btn.textContent = 'Send Message';
        }
      });
    }
  </script>
</BaseLayout>
