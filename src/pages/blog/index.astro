---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { BlogService } from '@/services/content/blog.service';
import { CmsService } from '@/services/content/cms.service';
import { SeoService } from '@/services/seo/seo.service';
import { InternalLinkService } from '@/services/seo/internal-link.service';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = env?.DB || null;

const blogService = new BlogService(db);
const cmsService = new CmsService(db);
const seoService = new SeoService(db);
const linkService = new InternalLinkService(db);

const url = new URL(Astro.request.url);
const currentCategory = url.searchParams.get('category') || undefined;
const currentTag = url.searchParams.get('tag') || undefined;
const searchQuery = url.searchParams.get('q') || undefined;
const page = parseInt(url.searchParams.get('page') || '1', 10);

const [featuredPost, postList, categories] = await Promise.all([
  blogService.getFeaturedPost(),
  blogService.getPublishedPosts({
    categorySlug: currentCategory,
    tagSlug: currentTag,
    search: searchQuery,
    page,
    limit: 9
  }),
  cmsService.getBlogCategories('active')
]);

const pageMeta = await seoService.getPageMetadata({
  pageType: 'page',
  path: '/blog',
  rawTitle: 'Psychology & Psychometrics Blog | Psychology Calculator',
  defaultDescription: 'Evidence-based articles on Big Five personality traits, attachment styles, emotional intelligence, and cognitive psychology.'
});

const breadcrumbItems = linkService.getBreadcrumbs([
  { name: 'Blog', path: '/blog' }
]);
---

<PublicLayout
  title={pageMeta.title}
  description={pageMeta.description}
  canonicalUrl={pageMeta.canonicalUrl}
  noindex={pageMeta.noindex}
  ogType="website"
>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <div class="mb-8">
      <Breadcrumbs items={breadcrumbItems} />
    </div>

    <!-- Header Section -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <Badge variant="info" size="md" class="mb-3">Scientific Research & Education</Badge>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight mb-4">
        Psychology Calculator Insights
      </h1>
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
        Deep dives into personality frameworks, attachment dynamics, emotional intelligence, and cognitive science.
      </p>

      <!-- Search Bar -->
      <form method="GET" action="/blog" class="mt-6 max-w-md mx-auto flex gap-2">
        <input
          type="text"
          name="q"
          value={searchQuery || ''}
          placeholder="Search articles or topics..."
          class="flex-1 px-4 py-2.5 bg-white border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 shadow-sm"
        />
        {currentCategory && <input type="hidden" name="category" value={currentCategory} />}
        <Button type="submit" variant="primary" size="md">
          Search
        </Button>
      </form>
    </div>

    <!-- Category Filter Pills -->
    <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
      <a
        href="/blog"
        class={`px-4 py-2 rounded-full text-xs font-semibold transition-colors ${
          !currentCategory
            ? 'bg-indigo-600 text-white shadow-sm'
            : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
        }`}
      >
        All Topics
      </a>
      {categories.map((cat) => (
        <a
          href={`/blog?category=${cat.slug}`}
          class={`px-4 py-2 rounded-full text-xs font-semibold transition-colors ${
            currentCategory === cat.slug
              ? 'bg-indigo-600 text-white shadow-sm'
              : 'bg-slate-100 text-slate-700 hover:bg-slate-200'
          }`}
        >
          {cat.name}
        </a>
      ))}
    </div>

    <!-- Featured Hero Post (When on page 1 without filters) -->
    {featuredPost && page === 1 && !currentCategory && !searchQuery && (
      <div class="mb-16">
        <Card class="overflow-hidden border-indigo-100 hover:border-indigo-200 transition-all bg-gradient-to-br from-indigo-50/50 via-white to-white p-6 sm:p-8">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-7 space-y-4">
              <div class="flex items-center gap-3">
                <Badge variant="info" size="sm">Featured Article</Badge>
                {featuredPost.category_name && (
                  <span class="text-xs font-medium text-slate-500">
                    {featuredPost.category_name}
                  </span>
                )}
                <span class="text-xs text-slate-400">⏱️ {featuredPost.reading_time_minutes} min read</span>
              </div>

              <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight leading-snug">
                <a href={`/blog/${featuredPost.slug}`} class="hover:text-indigo-600 transition-colors">
                  {featuredPost.title}
                </a>
              </h2>

              <p class="text-sm sm:text-base text-slate-600 leading-relaxed line-clamp-3">
                {featuredPost.excerpt}
              </p>

              <div class="pt-4 flex items-center justify-between">
                <div class="flex items-center gap-3">
                  <div class="w-8 h-8 rounded-full bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center text-xs">
                    {featuredPost.author_name?.charAt(0) || 'P'}
                  </div>
                  <div>
                    <div class="text-xs font-bold text-slate-900">{featuredPost.author_name || 'Editorial Team'}</div>
                    <div class="text-[11px] text-slate-400">
                      {featuredPost.published_at ? new Date(featuredPost.published_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : ''}
                    </div>
                  </div>
                </div>

                <a
                  href={`/blog/${featuredPost.slug}`}
                  class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl transition-colors shadow-sm"
                >
                  Read Guide →
                </a>
              </div>
            </div>

            <div class="lg:col-span-5">
              <div class="aspect-video rounded-2xl bg-indigo-900/5 border border-indigo-100 flex items-center justify-center overflow-hidden">
                {featuredPost.featured_image_url ? (
                  <img
                    src={featuredPost.featured_image_url}
                    alt={featuredPost.title}
                    class="w-full h-full object-cover"
                  />
                ) : (
                  <div class="p-8 text-center">
                    <span class="text-4xl mb-2 block">🧠</span>
                    <span class="text-xs font-semibold text-slate-500">Psychology Calculator Editorial</span>
                  </div>
                )}
              </div>
            </div>
          </div>
        </Card>
      </div>
    )}

    <!-- Posts Grid -->
    {postList.posts.length === 0 ? (
      <div class="text-center py-16 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
        <span class="text-4xl mb-3 block">📖</span>
        <h3 class="text-base font-bold text-slate-900 mb-1">No articles found</h3>
        <p class="text-xs text-slate-500 mb-4">
          Try clearing your search term or selecting another category.
        </p>
        <a href="/blog" class="text-xs font-semibold text-indigo-600 hover:underline">
          View all articles →
        </a>
      </div>
    ) : (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {postList.posts.map((post) => (
          <Card class="flex flex-col justify-between hover:shadow-md transition-shadow border-slate-200 bg-white overflow-hidden">
            <div>
              {post.featured_image_url && (
                <div class="aspect-[16/9] w-full bg-slate-100 overflow-hidden border-b border-slate-100">
                  <img
                    src={post.featured_image_url}
                    alt={post.title}
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                  />
                </div>
              )}

              <div class="p-6 space-y-3">
                <div class="flex items-center justify-between gap-2">
                  <Badge variant="default" size="sm">
                    {post.category_name || 'Psychometrics'}
                  </Badge>
                  <span class="text-[11px] text-slate-400 font-medium">
                    ⏱️ {post.reading_time_minutes} min read
                  </span>
                </div>

                <h3 class="text-lg font-bold text-slate-900 leading-snug">
                  <a href={`/blog/${post.slug}`} class="hover:text-indigo-600 transition-colors">
                    {post.title}
                  </a>
                </h3>

                <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
                  {post.excerpt}
                </p>
              </div>
            </div>

            <div class="p-6 pt-0 border-t border-slate-100 mt-4 flex items-center justify-between">
              <span class="text-[11px] text-slate-400 font-medium">
                {post.published_at ? new Date(post.published_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : ''}
              </span>
              <a
                href={`/blog/${post.slug}`}
                class="text-xs font-bold text-indigo-600 hover:text-indigo-800 transition-colors"
              >
                Read Article →
              </a>
            </div>
          </Card>
        ))}
      </div>
    )}

    <!-- Server-Side Pagination -->
    {postList.totalPages > 1 && (
      <div class="mt-12 flex items-center justify-center gap-2">
        {page > 1 && (
          <a
            href={`/blog?page=${page - 1}${currentCategory ? `&category=${currentCategory}` : ''}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`}
            class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors"
          >
            ← Previous
          </a>
        )}
        <span class="text-xs text-slate-500 font-medium px-4">
          Page {page} of {postList.totalPages}
        </span>
        {page < postList.totalPages && (
          <a
            href={`/blog?page=${page + 1}${currentCategory ? `&category=${currentCategory}` : ''}${searchQuery ? `&q=${encodeURIComponent(searchQuery)}` : ''}`}
            class="px-4 py-2 bg-white border border-slate-200 rounded-xl text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors"
          >
            Next →
          </a>
        )}
      </div>
    )}
  </div>
</PublicLayout>
