---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';

export const prerender = false;

// Ensure genuine HTTP 404 status is returned to search engines and clients
Astro.response.status = 404;
---

<PublicLayout
  title="404 — Page Not Found"
  description="The psychometric assessment, report, or resource you requested could not be located."
  noindex={true}
>
  <div class="min-h-[70vh] flex items-center justify-center px-4 py-16">
    <Card class="max-w-lg w-full p-8 sm:p-12 text-center space-y-6 border-slate-200 bg-white shadow-xl">
      <div class="w-16 h-16 mx-auto rounded-2xl bg-teal-50 border border-teal-100 flex items-center justify-center text-teal-600 font-black text-2xl">
        Ψ
      </div>

      <div class="space-y-2">
        <Badge variant="danger" size="md">Error 404</Badge>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight">
          Page Not Found
        </h1>
        <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          The psychometric assessment, report, or resource you are looking for might have been moved, renamed, or is temporarily unavailable.
        </p>
      </div>

      <div class="pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-center gap-3">
        <a
          href="/assessments"
          class="w-full sm:w-auto px-5 py-2.5 bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold rounded-xl shadow-xs transition-all text-center"
        >
          Explore Assessments →
        </a>
        <a
          href="/"
          class="w-full sm:w-auto px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold rounded-xl transition-all text-center"
        >
          Return Home
        </a>
      </div>
    </Card>
  </div>
</PublicLayout>
