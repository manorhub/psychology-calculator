---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Card from '@/components/ui/Card.astro';
import Input from '@/components/ui/Input.astro';
import Button from '@/components/ui/Button.astro';
import Alert from '@/components/ui/Alert.astro';

// If already logged in, redirect to account
if (Astro.locals.user) {
  return Astro.redirect('/account');
}

const errorParam = Astro.url.searchParams.get('error');
const verifiedParam = Astro.url.searchParams.get('verified');
const redirectParam = Astro.url.searchParams.get('redirect') || '/account';

let bannerMessage = '';
let bannerVariant: 'info' | 'success' | 'danger' = 'info';

if (verifiedParam === 'true') {
  bannerMessage = 'Your email has been verified successfully! You can now log in.';
  bannerVariant = 'success';
} else if (errorParam === 'oauth_denied') {
  bannerMessage = 'Google sign-in was cancelled. Please try again.';
  bannerVariant = 'danger';
} else if (errorParam === 'invalid_state') {
  bannerMessage = 'Authentication session expired. Please try signing in again.';
  bannerVariant = 'danger';
} else if (errorParam === 'oauth_failed') {
  bannerMessage = 'Could not authenticate with Google. Please try email login.';
  bannerVariant = 'danger';
}
---

<PublicLayout title="Sign In" description="Sign in to your MindMetrics account">
  <div class="min-h-[80vh] flex items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-6">
      <div class="text-center space-y-2">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-2xl bg-teal-600 text-white font-bold text-xl shadow-md shadow-teal-600/20">
          Ψ
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Welcome back
        </h1>
        <p class="text-sm text-slate-500">
          Sign in to access your assessment history and saved insights
        </p>
      </div>

      {bannerMessage && (
        <Alert variant={bannerVariant} title={bannerVariant === 'success' ? 'Success' : 'Notice'}>
          {bannerMessage}
        </Alert>
      )}

      <div id="form-error-alert" class="hidden">
        <Alert variant="danger" title="Sign In Error">
          <span id="form-error-message"></span>
        </Alert>
      </div>

      <Card class="p-6 sm:p-8">
        <form id="login-form" class="space-y-4">
          <Input
            id="email"
            name="email"
            type="email"
            label="Email Address"
            placeholder="you@example.com"
            required={true}
            autocomplete="email"
          />

          <div class="space-y-1">
            <div class="flex items-center justify-between">
              <label for="password" class="block text-sm font-medium text-slate-700">
                Password
              </label>
              <a href="/forgot-password" class="text-xs font-semibold text-teal-700 hover:text-teal-800">
                Forgot password?
              </a>
            </div>
            <Input
              id="password"
              name="password"
              type="password"
              placeholder="••••••••"
              required={true}
              autocomplete="current-password"
            />
          </div>

          <Button type="submit" variant="primary" size="md" class="w-full mt-2" id="submit-btn">
            Sign In
          </Button>

          <!-- Divider -->
          <div class="relative my-6">
            <div class="absolute inset-0 flex items-center">
              <div class="w-full border-t border-slate-200"></div>
            </div>
            <div class="relative flex justify-center text-xs uppercase">
              <span class="bg-white px-2 text-slate-400 font-medium">Or continue with</span>
            </div>
          </div>

          <!-- Google OAuth Button -->
          <Button
            href="/auth/google"
            variant="outline"
            size="md"
            class="w-full flex items-center justify-center gap-3 text-slate-700 hover:bg-slate-50 border-slate-300"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24">
              <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
              <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
              <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
              <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
            </svg>
            <span>Continue with Google</span>
          </Button>
        </form>

        <div slot="footer" class="w-full text-center text-xs text-slate-500">
          Don't have an account?{' '}
          <a href="/register" class="font-semibold text-teal-700 hover:text-teal-800">
            Create an account
          </a>
        </div>
      </Card>
    </div>
  </div>
</PublicLayout>

<script is:inline define:vars={{ redirectParam }}>
  const form = document.getElementById('login-form');
  const errorAlert = document.getElementById('form-error-alert');
  const errorMessage = document.getElementById('form-error-message');
  const submitBtn = document.getElementById('submit-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorAlert?.classList.add('hidden');
    submitBtn?.setAttribute('disabled', 'true');

    const formData = new FormData(form);
    const payload = {
      email: formData.get('email'),
      password: formData.get('password')
    };

    try {
      const res = await fetch('/api/auth/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        if (errorMessage) {
          errorMessage.textContent = data.error?.message || data.data?.message || 'Invalid email or password.';
        }
        errorAlert?.classList.remove('hidden');
        submitBtn?.removeAttribute('disabled');
        return;
      }

      // Successful login -> Redirect
      window.location.href = redirectParam || '/account';
    } catch {
      if (errorMessage) {
        errorMessage.textContent = 'A network error occurred. Please try again.';
      }
      errorAlert?.classList.remove('hidden');
      submitBtn?.removeAttribute('disabled');
    }
  });
</script>
