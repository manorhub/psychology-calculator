---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import StructuredData from '@/components/seo/StructuredData.astro';
import { SeoService } from '@/services/seo/seo.service';
import { InternalLinkService } from '@/services/seo/internal-link.service';
import { getD1Database } from '@/lib/db/client';
import { AssessmentCategoryService } from '@/services/assessment-category.service';
import { executeQuery } from '@/lib/db/query';
import type { FaqRow } from '@/types/database';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/assessments');

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const categoryService = new AssessmentCategoryService(db);

const category = await categoryService.getCategoryBySlug(slug, false);

if (!category) {
  return Astro.redirect('/404');
}

// Published assessments belonging to this category
const assessments = await categoryService.getPublishedAssessmentsByCategory(category.id);

// Related dynamic FAQs
const faqs = db
  ? await executeQuery<FaqRow>(
      db,
      `SELECT * FROM faqs WHERE (category = ? OR entity_id = ?) AND status = 'active' ORDER BY display_order ASC`,
      [category.slug, category.id]
    )
  : [];

const seoService = new SeoService(db);
const linkService = new InternalLinkService(db);

const relatedCategories = await linkService.getRelatedCategories(category.id, 4);

const breadcrumbItems = linkService.getBreadcrumbs([
  { name: 'Assessments', path: '/assessments' },
  { name: category.name, path: `/assessments/category/${category.slug}` }
]);

const pageMetadata = await seoService.getPageMetadata({
  pageType: 'category',
  entityId: category.id,
  path: `/assessments/category/${category.slug}`,
  rawTitle: category.seo_title || `${category.name} Tests & Assessments`,
  defaultDescription: category.seo_description || category.description || `Explore standardized ${category.name} psychometric evaluations and AI personality reports.`
});

const faqSchema = faqs.length > 0 ? seoService.generateStructuredData('FAQPage', { faqs }) : null;

// Structured data for CollectionPage / ItemList
const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${category.name} Psychological Assessments`,
  description: category.description,
  url: `https://www.psychologycalculator.com/assessments/category/${category.slug}`,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: assessments.length,
    itemListElement: assessments.map((asm, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: asm.name,
      url: `https://www.psychologycalculator.com/assessments/${asm.slug}`
    }))
  }
};
---

<PublicLayout
  title={pageMetadata.title}
  description={pageMetadata.description}
  canonicalUrl={category.canonical || pageMetadata.canonicalUrl}
  ogImage={category.og_image || pageMetadata.ogImage}
>
  <div class="max-w-6xl mx-auto py-10 px-4 sm:px-6 lg:px-8 space-y-12">
    <!-- Breadcrumbs Navigation -->
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Category Header Hero -->
    <div class="space-y-4 max-w-3xl">
      <div class="inline-flex items-center gap-2">
        <span class="w-8 h-8 rounded-xl bg-teal-50 border border-teal-100 flex items-center justify-center text-lg">
          {category.icon || '🧬'}
        </span>
        <Badge variant="info" size="md">Psychometric Category</Badge>
        {category.featured ? (
          <span class="inline-flex items-center gap-1 text-[11px] font-bold text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-0.5 rounded-full">
            ⭐ Featured Domain
          </span>
        ) : null}
      </div>

      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        {category.name} <span class="text-teal-600">Assessments</span>
      </h1>

      {category.short_description && (
        <p class="text-base sm:text-xl font-medium text-slate-800 leading-snug">
          {category.short_description}
        </p>
      )}

      <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
        {category.description || 'Scientifically grounded psychological instruments designed for deep self-understanding and behavioral insight.'}
      </p>
    </div>

    <!-- Assessments Section -->
    <div class="space-y-6">
      <div class="flex items-center justify-between border-b border-slate-200 pb-3">
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-500">
          Available Standardized Instruments ({assessments.length})
        </h2>
      </div>

      {assessments.length === 0 ? (
        <div class="p-12 text-center bg-white rounded-3xl border border-slate-200 space-y-4">
          <div class="w-16 h-16 rounded-2xl bg-teal-50 text-teal-600 text-3xl flex items-center justify-center mx-auto">
            📋
          </div>
          <div class="space-y-1">
            <h3 class="text-lg font-black text-slate-900">No assessments are available in this category yet.</h3>
            <p class="text-xs sm:text-sm text-slate-500 max-w-md mx-auto">
              Our research team is currently drafting and validating instruments for the {category.name} domain. Check back soon!
            </p>
          </div>
          <div class="pt-2">
            <a
              href="/assessments"
              class="inline-flex items-center gap-2 px-4 py-2 bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold rounded-xl transition-all shadow-sm"
            >
              ← Browse All Assessments
            </a>
          </div>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {assessments.map((asm) => (
            <Card class="p-6 flex flex-col justify-between hover:border-teal-500/80 hover:shadow-md transition-all group">
              <div class="space-y-4">
                <div class="flex items-center justify-between gap-2">
                  <span class="text-[10px] font-bold uppercase tracking-wider text-teal-800 bg-teal-50 px-2 py-0.5 rounded-full border border-teal-100">
                    {category.name}
                  </span>
                  <span class={`text-[10px] font-bold px-2 py-0.5 rounded-full ${
                    asm.access_type === 'premium'
                      ? 'bg-amber-50 text-amber-800 border border-amber-200'
                      : 'bg-emerald-50 text-emerald-800 border border-emerald-200'
                  }`}>
                    {asm.access_type === 'premium' ? '✨ Premium' : '✓ Free Guest Access'}
                  </span>
                </div>

                <div class="space-y-1.5">
                  <h3 class="text-lg font-bold text-slate-900 group-hover:text-teal-700 transition-colors leading-snug">
                    {asm.name}
                  </h3>
                  <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
                    {asm.short_description}
                  </p>
                </div>
              </div>

              <div class="pt-6 mt-6 border-t border-slate-100 flex items-center justify-between gap-2">
                <div class="flex items-center gap-3 text-xs text-slate-400 font-medium">
                  <span>⏱ ~{asm.estimated_minutes} min</span>
                  <span>•</span>
                  <span>{asm.question_count} questions</span>
                </div>

                <a
                  href={`/assessments/${asm.slug}`}
                  class="px-3.5 py-1.5 bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold rounded-xl transition-all shadow-2xs group-hover:shadow-sm inline-flex items-center gap-1"
                >
                  <span>Start</span>
                  <span>→</span>
                </a>
              </div>
            </Card>
          ))}
        </div>
      )}
    </div>

    <!-- Related Categories Exploration -->
    {relatedCategories.length > 0 && (
      <div class="pt-8 border-t border-slate-200 space-y-4">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500">
          Explore Related Psychology Categories
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {relatedCategories.map((rc) => (
            <a
              href={`/assessments/category/${rc.slug}`}
              class="p-5 bg-white hover:bg-teal-50/40 rounded-2xl border border-slate-200 hover:border-teal-400 hover:shadow-sm transition-all group flex flex-col justify-between space-y-3"
            >
              <div class="space-y-2">
                <div class="w-9 h-9 rounded-xl bg-teal-50 border border-teal-100 flex items-center justify-center text-lg">
                  {rc.icon || '🧠'}
                </div>
                <div>
                  <h4 class="font-bold text-slate-900 group-hover:text-teal-700 text-sm">
                    {rc.name || rc.title}
                  </h4>
                  {rc.description && (
                    <p class="text-[11px] text-slate-500 line-clamp-2 mt-1 leading-relaxed">
                      {rc.description}
                    </p>
                  )}
                </div>
              </div>
              <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs text-teal-700 font-bold">
                <span>View Tests</span>
                <span class="group-hover:translate-x-1 transition-transform">→</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Dynamic FAQ Accordion -->
    {faqs.length > 0 && (
      <div class="pt-8 border-t border-slate-200 space-y-4">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500">
          Frequently Asked Questions about {category.name}
        </h3>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="group bg-white rounded-2xl border border-slate-200 p-4 transition-all">
              <summary class="flex items-center justify-between font-bold text-slate-900 text-sm cursor-pointer list-none">
                <span>{faq.question}</span>
                <span class="text-slate-400 group-open:rotate-180 transition-transform">▼</span>
              </summary>
              <div class="text-xs text-slate-600 leading-relaxed mt-3 pt-3 border-t border-slate-100">
                {faq.answer}
              </div>
            </details>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Structured Data Schemas -->
  <StructuredData schema={collectionSchema} />
  {faqSchema && <StructuredData schema={faqSchema} />}
</PublicLayout>
