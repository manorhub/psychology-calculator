---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/ui/Card.astro';
import { getD1Database } from '@/lib/db/client';
import { AssessmentRuntimeService } from '@/services/assessment-runtime.service';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const runtimeService = new AssessmentRuntimeService(db);

const assessmentData = await runtimeService.getPublishedAssessmentBySlug(slug);

// If not published or not found, return 404
if (!assessmentData) {
  return new Response('Assessment Not Found or not published', { status: 404 });
}

const { assessment, category, dimensions, questions } = assessmentData;
const user = Astro.locals.user;
---

<BaseLayout
  title={assessment.name}
  description={assessment.short_description}
>
  <div class="max-w-4xl mx-auto py-10 sm:py-16 px-4 sm:px-6 space-y-10">
    <!-- Breadcrumb & Back Actions -->
    <div class="flex flex-wrap items-center justify-between gap-3">
      <nav class="flex items-center gap-2 text-xs text-slate-500">
        <a href="/" class="hover:text-teal-700">Home</a>
        <span>/</span>
        <a href="/assessments" class="hover:text-teal-700">Assessments</a>
        <span>/</span>
        <span class="text-slate-900 font-semibold truncate max-w-[180px] sm:max-w-xs">{assessment.name}</span>
      </nav>

      {user && (
        <a
          href="/dashboard"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white hover:bg-slate-100 text-slate-800 hover:text-teal-800 text-xs font-bold rounded-xl border border-slate-200 shadow-2xs transition-all"
        >
          <span>📊</span>
          <span>Back to Dashboard</span>
        </a>
      )}
    </div>

    <!-- Assessment Hero Card -->
    <div class="bg-white rounded-3xl border border-slate-200/80 p-6 sm:p-10 shadow-sm space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-teal-50 text-teal-700 border border-teal-200">
          {category?.name || 'Self-Assessment'}
        </span>

        <span class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-bold ${
          assessment.access_type === 'premium' ? 'bg-amber-100 text-amber-900' : 'bg-slate-100 text-slate-700'
        }`}>
          {assessment.access_type === 'premium' ? '✨ Premium Instrument' : '✓ Free Self-Assessment'}
        </span>
      </div>

      <div class="space-y-3">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-tight">
          {assessment.name}
        </h1>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          {assessment.short_description}
        </p>
      </div>

      <!-- Quick Metrics Bar -->
      <div class="grid grid-cols-3 gap-3 p-4 bg-slate-50 border border-slate-100 rounded-2xl text-center">
        <div>
          <div class="text-lg sm:text-2xl font-black text-slate-900">~{assessment.estimated_minutes} min</div>
          <div class="text-[11px] text-slate-500 font-medium">Estimated Time</div>
        </div>
        <div>
          <div class="text-lg sm:text-2xl font-black text-slate-900">{questions.length}</div>
          <div class="text-[11px] text-slate-500 font-medium">Validated Items</div>
        </div>
        <div>
          <div class="text-lg sm:text-2xl font-black text-slate-900">{dimensions.length}</div>
          <div class="text-[11px] text-slate-500 font-medium">Dimensions</div>
        </div>
      </div>

      <!-- Start Button & Session Info -->
      <div class="pt-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-t border-slate-100">
        <div class="text-xs text-slate-500">
          {user ? (
            <span>Logged in as <strong class="text-slate-900">{user.email}</strong>. Attempt will save to your account.</span>
          ) : (
            <span>Taking as <strong class="text-slate-900">Guest</strong>. No registration required.</span>
          )}
        </div>

        <button
          type="button"
          id="start-assessment-btn"
          class="inline-flex items-center justify-center px-8 py-3.5 text-sm font-bold text-white bg-teal-600 hover:bg-teal-700 rounded-2xl shadow-sm hover:shadow-md transition-all cursor-pointer"
        >
          Begin Assessment →
        </button>
      </div>
    </div>

    <!-- Evaluated Dimensions Section -->
    {dimensions.length > 0 && (
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-slate-900">What This Assessment Measures</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {dimensions.map((dim) => (
            <div class="p-5 bg-white rounded-2xl border border-slate-200/80 space-y-1">
              <h3 class="text-sm font-bold text-slate-900">{dim.name}</h3>
              <p class="text-xs text-slate-600 leading-relaxed">
                {dim.description || 'Evaluates key behavioral and cognitive psychological indicators.'}
              </p>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Instructions & Overview -->
    <div class="space-y-6">
      {assessment.instructions && (
        <Card title="Assessment Instructions" class="p-6 space-y-3">
          <p class="text-xs sm:text-sm text-slate-700 leading-relaxed whitespace-pre-line">
            {assessment.instructions}
          </p>
        </Card>
      )}

      {assessment.long_description && (
        <Card title="About the Psychological Framework" class="p-6 space-y-3">
          <p class="text-xs sm:text-sm text-slate-700 leading-relaxed whitespace-pre-line">
            {assessment.long_description}
          </p>
        </Card>
      )}

      {assessment.disclaimer && (
        <div class="p-4 bg-slate-100 border border-slate-200 rounded-2xl text-[11px] text-slate-500 text-center leading-relaxed">
          {assessment.disclaimer}
        </div>
      )}
    </div>
  </div>
</BaseLayout>

<script is:inline define:vars={{ assessmentId: assessment.id, slug: assessment.slug }}>
  const startBtn = document.getElementById('start-assessment-btn');

  startBtn?.addEventListener('click', async () => {
    startBtn.setAttribute('disabled', 'true');
    startBtn.textContent = 'Preparing assessment...';

    try {
      const res = await fetch(`/api/v1/assessments/${assessmentId}/start`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
      });
      const data = await res.json();

      if (!res.ok || !data.success) {
        alert(data.error?.message || 'Unable to start assessment.');
        startBtn.removeAttribute('disabled');
        startBtn.textContent = 'Begin Assessment →';
        return;
      }

      // Store active attempt ID in session storage and redirect to runner
      sessionStorage.setItem('active_attempt_id', data.data.attemptId);
      window.location.href = `/assessments/${slug}/take?attemptId=${data.data.attemptId}`;
    } catch {
      alert('A network error occurred. Please try again.');
      startBtn.removeAttribute('disabled');
      startBtn.textContent = 'Begin Assessment →';
    }
  });
</script>
