---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/ui/Card.astro';
import { getD1Database } from '@/lib/db/client';
import { AIService } from '@/services/ai/ai.service';

const { id } = Astro.params;
if (!id) return Astro.redirect('/');

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
if (!db) return Astro.redirect('/');

const aiService = new AIService(db, (env as any) || {});
const currentUser = Astro.locals.user;
const guestSessionId = Astro.cookies.get('mm_guest_id')?.value || null;

let reportData;
try {
  reportData = await aiService.getReport(id, currentUser?.id || null, guestSessionId);
} catch (error: any) {
  if (error.statusCode === 403 || error.statusCode === 404) {
    return new Response('Report Not Found or Access Denied', { status: error.statusCode });
  }
  return Astro.redirect('/');
}

const { content, assessmentName, primaryArchetype, generatedAt, disclaimer } = reportData;
---

<BaseLayout
  title={`AI Detailed Report: ${assessmentName}`}
  description={`In-depth AI psychological narrative synthesis for ${assessmentName}`}
>
  <!-- SEO Privacy: Strictly Noindex for personalized AI reports -->
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <div class="max-w-4xl mx-auto py-10 sm:py-16 px-4 sm:px-6 space-y-10">
    <!-- Header Banner -->
    <div class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 text-white rounded-3xl p-8 sm:p-12 shadow-xl space-y-6">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 bg-indigo-900/70 border border-indigo-700/50 rounded-full text-xs font-bold text-indigo-200">
          <span>✨ In-Depth AI Synthesis</span>
        </div>
        <span class="text-xs font-mono text-indigo-300">
          Generated: {new Date(generatedAt).toLocaleDateString()}
        </span>
      </div>

      <div class="space-y-2">
        <span class="text-xs font-bold tracking-wider uppercase text-indigo-300">Comprehensive Report</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight">
          {assessmentName}
        </h1>
        <p class="text-sm sm:text-base text-indigo-100 font-semibold pt-1">
          Primary Classification: <span class="text-white font-bold">{primaryArchetype}</span>
        </p>
      </div>

      <!-- Action Row -->
      <div class="pt-4 border-t border-indigo-800/60 flex flex-wrap items-center justify-between gap-4">
        <div class="text-xs text-indigo-200/80">
          Official personalized interpretation document ready for export:
        </div>
        <a
          href={`/api/v1/reports/${id}/pdf`}
          download
          class="px-4 py-2.5 text-xs font-bold bg-white hover:bg-indigo-50 text-slate-950 rounded-xl shadow-md transition-all flex items-center gap-2 cursor-pointer"
        >
          <span>📑</span>
          <span>Download Detailed PDF</span>
        </a>
      </div>
    </div>

    <!-- Executive Summary -->
    <Card class="p-8 space-y-4 border-indigo-100">
      <h2 class="text-xl font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
        <span>📖</span> Executive Psychological Summary
      </h2>
      <div class="text-xs sm:text-sm text-slate-700 leading-relaxed whitespace-pre-line space-y-3">
        {content.summary}
      </div>
    </Card>

    <!-- Prominent Behavioral Traits -->
    {content.key_traits.length > 0 && (
      <div class="space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-slate-500">Core Trait Signatures</h3>
        <div class="flex flex-wrap gap-2">
          {content.key_traits.map((trait) => (
            <span class="px-3.5 py-1.5 bg-indigo-50 text-indigo-900 border border-indigo-200 rounded-xl text-xs font-bold">
              ✦ {trait}
            </span>
          ))}
        </div>
      </div>
    )}

    <!-- Strengths vs Challenges Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <!-- Strengths -->
      <Card class="p-6 sm:p-8 space-y-4 border-emerald-200 bg-emerald-50/30">
        <div class="flex items-center gap-2 text-emerald-900 font-extrabold text-lg">
          <span>🌟</span> Key Strengths & Assets
        </div>
        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
          {content.strengths.map((s) => (
            <li class="flex items-start gap-2">
              <span class="text-emerald-600 font-bold">✓</span>
              <span>{s}</span>
            </li>
          ))}
        </ul>
      </Card>

      <!-- Challenges -->
      <Card class="p-6 sm:p-8 space-y-4 border-amber-200 bg-amber-50/30">
        <div class="flex items-center gap-2 text-amber-900 font-extrabold text-lg">
          <span>⚠️</span> Growth Blindspots & Stress Triggers
        </div>
        <ul class="space-y-2.5 text-xs sm:text-sm text-slate-700">
          {content.challenges.map((c) => (
            <li class="flex items-start gap-2">
              <span class="text-amber-600 font-bold">•</span>
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </Card>
    </div>

    <!-- Deep-Dive Domains -->
    <div class="space-y-6">
      <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 tracking-tight">
        Domain-Specific Insights
      </h2>

      <div class="grid grid-cols-1 gap-4">
        {content.communication && (
          <Card class="p-6 sm:p-8 space-y-2">
            <h3 class="text-sm font-bold uppercase tracking-wider text-sky-800 flex items-center gap-2">
              <span>💬</span> Interpersonal & Communication Style
            </h3>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed whitespace-pre-line">
              {content.communication}
            </p>
          </Card>
        )}

        {content.relationships && (
          <Card class="p-6 sm:p-8 space-y-2">
            <h3 class="text-sm font-bold uppercase tracking-wider text-rose-800 flex items-center gap-2">
              <span>❤️</span> Relational & Intimacy Dynamics
            </h3>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed whitespace-pre-line">
              {content.relationships}
            </p>
          </Card>
        )}

        {content.work_style && (
          <Card class="p-6 sm:p-8 space-y-2">
            <h3 class="text-sm font-bold uppercase tracking-wider text-indigo-800 flex items-center gap-2">
              <span>💼</span> Professional & Work Execution Style
            </h3>
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed whitespace-pre-line">
              {content.work_style}
            </p>
          </Card>
        )}
      </div>
    </div>

    <!-- Practical Daily Suggestions -->
    {content.practical_suggestions.length > 0 && (
      <Card class="p-8 space-y-4 border-teal-200 bg-teal-50/20">
        <h2 class="text-lg font-extrabold text-slate-900 tracking-tight flex items-center gap-2">
          <span>🎯</span> Actionable Daily Exercises & Reflection Practices
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          {content.practical_suggestions.map((sug, i) => (
            <div class="p-4 bg-white rounded-2xl border border-teal-100 shadow-xs text-xs sm:text-sm text-slate-700">
              <span class="font-bold text-teal-700 block mb-1">Practice #{i + 1}</span>
              {sug}
            </div>
          ))}
        </div>
      </Card>
    )}

    <!-- Clinical Disclaimer -->
    <div class="p-5 bg-slate-100 border border-slate-200 rounded-2xl text-[11px] text-slate-500 text-center leading-relaxed space-y-1">
      <strong class="text-slate-700 block">Psychological & Educational Disclaimer</strong>
      <p>{disclaimer || 'This AI-generated analysis is intended solely for educational reflection and personal growth. It is not a clinical psychological evaluation or medical diagnosis.'}</p>
    </div>

    <!-- Actions -->
    <div class="pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 no-print">
      <a
        href={`/results/${reportData.attemptId}`}
        class="text-xs font-semibold text-teal-700 hover:text-teal-800"
      >
        ← Back to Score Summary
      </a>

      <button
        type="button"
        onclick="window.print()"
        class="px-5 py-2.5 bg-slate-900 hover:bg-black text-white text-xs font-bold rounded-xl cursor-pointer shadow-sm transition-all"
      >
        🖨️ Print / Save Report
      </button>
    </div>
  </div>
</BaseLayout>

<style is:global>
  @media print {
    @page {
      margin: 1.2cm;
      size: auto;
    }

    body {
      background: #ffffff !important;
      color: #0f172a !important;
    }

    /* Prevent cards, domain insight boxes, and sections from splitting across page breaks */
    .card,
    [class*="rounded-2xl"],
    [class*="rounded-3xl"],
    [class*="rounded-xl"],
    .break-inside-avoid,
    section,
    article,
    .grid > div {
      break-inside: avoid !important;
      page-break-inside: avoid !important;
    }

    /* Prevent headings from being separated from their content */
    h1, h2, h3, h4, h5, h6 {
      break-after: avoid !important;
      page-break-after: avoid !important;
    }

    .no-print,
    header,
    nav,
    footer,
    button {
      display: none !important;
    }
  }
</style>

