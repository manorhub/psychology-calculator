---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Card from '@/components/ui/Card.astro';
import Input from '@/components/ui/Input.astro';
import Button from '@/components/ui/Button.astro';
import Alert from '@/components/ui/Alert.astro';
---

<PublicLayout title="Reset Password" description="Request a password reset link">
  <div class="min-h-[75vh] flex items-center justify-center px-4 py-12 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-6">
      <div class="text-center space-y-2">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Forgot your password?
        </h1>
        <p class="text-sm text-slate-500">
          Enter your email address and we will send you a secure link to reset your password.
        </p>
      </div>

      <div id="success-alert" class="hidden">
        <Alert variant="success" title="Check your inbox">
          If an account exists for that email, we have sent instructions to reset your password.
        </Alert>
      </div>

      <div id="error-alert" class="hidden">
        <Alert variant="danger" title="Error">
          <span id="error-message"></span>
        </Alert>
      </div>

      <Card class="p-6 sm:p-8" id="card-container">
        <form id="forgot-form" class="space-y-4">
          <Input
            id="email"
            name="email"
            type="email"
            label="Email Address"
            placeholder="you@example.com"
            required={true}
            autocomplete="email"
          />

          <Button type="submit" variant="primary" size="md" class="w-full mt-2" id="submit-btn">
            Send Reset Link
          </Button>
        </form>

        <div slot="footer" class="w-full text-center text-xs text-slate-500">
          Remember your password?{' '}
          <a href="/login" class="font-semibold text-teal-700 hover:text-teal-800">
            Back to sign in
          </a>
        </div>
      </Card>
    </div>
  </div>
</PublicLayout>

<script>
  const form = document.getElementById('forgot-form') as HTMLFormElement | null;
  const successAlert = document.getElementById('success-alert');
  const errorAlert = document.getElementById('error-alert');
  const errorMessage = document.getElementById('error-message');
  const submitBtn = document.getElementById('submit-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorAlert?.classList.add('hidden');
    submitBtn?.setAttribute('disabled', 'true');

    const formData = new FormData(form);
    const email = formData.get('email');

    try {
      const res = await fetch('/api/auth/forgot-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email })
      });

      const data: any = await res.json();
      if (!res.ok) {
        if (errorMessage) errorMessage.textContent = data.error?.message || 'Request failed.';
        errorAlert?.classList.remove('hidden');
        submitBtn?.removeAttribute('disabled');
        return;
      }

      // Show generic success message
      form.reset();
      successAlert?.classList.remove('hidden');
      submitBtn?.removeAttribute('disabled');
    } catch {
      if (errorMessage) errorMessage.textContent = 'A network error occurred.';
      errorAlert?.classList.remove('hidden');
      submitBtn?.removeAttribute('disabled');
    }
  });
</script>
