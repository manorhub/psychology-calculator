---
import ErrorLayout from '@/layouts/ErrorLayout.astro';
import Button from '@/components/ui/Button.astro';

interface Props {
  error?: unknown;
}

// Ensure no stack traces or secrets leak
---

<ErrorLayout title="Server Error" statusCode={500}>
  <div class="space-y-3">
    <span class="inline-block px-3 py-1 text-xs font-semibold rounded-full bg-rose-100 text-rose-700">
      Error 500
    </span>
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
      Internal Server Error
    </h1>
    <p class="text-sm text-slate-500 max-w-sm mx-auto leading-relaxed">
      We experienced an unexpected server issue while processing this request. Our systems have logged the incident.
    </p>
  </div>

  <div class="pt-4 flex items-center justify-center gap-3">
    <Button href="/" variant="primary" size="md">
      Return to Safety
    </Button>
  </div>
</ErrorLayout>
