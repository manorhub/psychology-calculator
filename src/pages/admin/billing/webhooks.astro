---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import { WebhookService } from '@/services/billing/webhook.service';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = env?.DB || null;

const webhookService = new WebhookService(db);
const webhooks = await webhookService.listWebhookLogs(100);
---

<AdminLayout title="Webhook Logs — Admin Control">
  <div class="space-y-8 max-w-6xl">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          Lemon Squeezy Webhook Audit Ledger
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Cryptographically verified incoming lifecycle events and delivery status
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/billing"
          class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold rounded-xl transition-all"
        >
          ← Billing Overview
        </a>
      </div>
    </div>

    <!-- Webhooks Table -->
    <Card class="overflow-hidden border-slate-200">
      <div class="p-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">Received Webhook Events ({webhooks.length})</h2>
      </div>

      {webhooks.length === 0 ? (
        <div class="p-12 text-center text-slate-400 text-xs">
          No webhook events recorded in ledger yet.
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-600">
            <thead class="bg-slate-50/50 text-[10px] uppercase font-bold text-slate-400 border-b border-slate-200">
              <tr>
                <th class="px-4 py-3">Event Name</th>
                <th class="px-4 py-3">Event ID</th>
                <th class="px-4 py-3">Status</th>
                <th class="px-4 py-3">Received</th>
                <th class="px-4 py-3">Processed</th>
                <th class="px-4 py-3">Details / Errors</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {webhooks.map((ev) => (
                <tr class="hover:bg-slate-50/60 transition-colors">
                  <td class="px-4 py-3 font-mono font-bold text-indigo-700 text-[11px]">
                    {ev.event_name}
                  </td>
                  <td class="px-4 py-3 font-mono text-[10px] text-slate-500">
                    {ev.event_id}
                  </td>
                  <td class="px-4 py-3">
                    <Badge
                      variant={ev.status === 'processed' ? 'success' : ev.status === 'duplicate' ? 'info' : 'danger'}
                      size="sm"
                    >
                      {ev.status}
                    </Badge>
                  </td>
                  <td class="px-4 py-3 text-slate-400 text-[10px]">
                    {new Date(ev.created_at).toLocaleString()}
                  </td>
                  <td class="px-4 py-3 text-slate-400 text-[10px]">
                    {ev.processed_at ? new Date(ev.processed_at).toLocaleTimeString() : '-'}
                  </td>
                  <td class="px-4 py-3 text-slate-500 text-[11px] max-w-xs truncate">
                    {ev.error_message ? (
                      <span class="text-rose-600 font-semibold">{ev.error_message}</span>
                    ) : (
                      <span class="text-emerald-700">✓ Ingestion complete</span>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </Card>
  </div>
</AdminLayout>
