---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import { getD1Database } from '@/lib/db/client';
import { EmailService } from '@/services/email.service';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const emailService = new EmailService(db);

const templates = await emailService.getTemplates();
---

<AdminLayout title="Email Templates Manager">
  <div class="space-y-6 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <a href="/admin/settings/email" class="text-xs font-semibold text-indigo-600 hover:underline">SMTP Settings</a>
          <span class="text-xs text-slate-400">/</span>
          <span class="text-xs font-semibold text-slate-600">Templates</span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Email Templates Manager</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Customize transactional email copy, variable placeholders, and preview rendered HTML without code changes.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/email/logs"
          class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-colors"
        >
          📋 Delivery Logs
        </a>
      </div>
    </div>

    <!-- Templates Table -->
    <Card class="border-slate-200 bg-white overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 text-slate-500 font-bold uppercase border-b border-slate-100">
            <tr>
              <th class="p-3.5">Template Name / Event Key</th>
              <th class="p-3.5">Subject</th>
              <th class="p-3.5">Supported Variables</th>
              <th class="p-3.5">Status</th>
              <th class="p-3.5">Last Updated</th>
              <th class="p-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700">
            {templates.map((t) => {
              const vars: string[] = JSON.parse(t.allowed_variables || '[]');
              return (
                <tr class="hover:bg-slate-50/60 transition-colors">
                  <td class="p-3.5">
                    <div class="font-bold text-slate-900">{t.name}</div>
                    <div class="font-mono text-[11px] text-indigo-600">{t.event_key}</div>
                  </td>
                  <td class="p-3.5 max-w-xs font-medium text-slate-800 truncate">
                    {t.subject}
                  </td>
                  <td class="p-3.5 max-w-xs">
                    <div class="flex flex-wrap gap-1">
                      {vars.map((v) => (
                        <span class="px-1.5 py-0.5 bg-slate-100 text-slate-600 rounded text-[10px] font-mono">
                          {`{{${v}}}`}
                        </span>
                      ))}
                    </div>
                  </td>
                  <td class="p-3.5">
                    <Badge variant={t.status === 'active' ? 'success' : 'default'} size="sm">
                      {t.status}
                    </Badge>
                  </td>
                  <td class="p-3.5 font-mono text-slate-400">
                    {t.updated_at ? new Date(t.updated_at).toLocaleDateString() : '—'}
                  </td>
                  <td class="p-3.5 text-right space-x-2">
                    <a
                      href={`/admin/settings/email/templates/${t.id}`}
                      class="px-3 py-1.5 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 rounded-lg font-bold text-xs transition-colors inline-block"
                    >
                      Edit →
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </Card>
  </div>
</AdminLayout>
