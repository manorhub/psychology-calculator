---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Button from '@/components/ui/Button.astro';
import { getD1Database } from '@/lib/db/client';
import { EmailService } from '@/services/email.service';

export const prerender = false;

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/settings/email/templates');

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const emailService = new EmailService(db);

const template = await emailService.getTemplateById(id);
if (!template) return Astro.redirect('/admin/settings/email/templates');

const allowedVars: string[] = JSON.parse(template.allowed_variables || '[]');
---

<AdminLayout title={`Edit Template: ${template.name}`}>
  <div class="space-y-6 max-w-5xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <a href="/admin/settings/email/templates" class="text-xs font-semibold text-indigo-600 hover:underline">Templates</a>
          <span class="text-xs text-slate-400">/</span>
          <span class="text-xs font-semibold text-slate-600">{template.event_key}</span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">{template.name}</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Event Key: <code class="font-mono text-indigo-600">{template.event_key}</code>
        </p>
      </div>

      <div class="flex items-center gap-3">
        <button
          type="button"
          id="preview-btn"
          class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-colors cursor-pointer"
        >
          👁️ Preview with Sample Data
        </button>
        <button
          type="button"
          id="test-send-btn"
          class="px-4 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-bold rounded-xl transition-colors cursor-pointer"
        >
          ✉️ Test Send
        </button>
      </div>
    </div>

    <!-- Supported Variables Helper Pillbox -->
    <Card class="p-4 border-indigo-100 bg-indigo-50/40 space-y-2">
      <div class="text-xs font-bold text-indigo-900">Supported Variables for this Event:</div>
      <div class="flex flex-wrap gap-2">
        {allowedVars.map((v) => (
          <button
            type="button"
            onclick={`insertVariable('{{${v}}}')`}
            class="px-2 py-1 bg-white border border-indigo-200 hover:border-indigo-400 text-indigo-700 rounded-lg text-xs font-mono font-semibold transition-colors cursor-pointer shadow-2xs"
            title="Click to copy placeholder"
          >
            {`{{${v}}}`}
          </button>
        ))}
        <span class="px-2 py-1 bg-white/70 text-slate-500 rounded-lg text-xs font-mono">
          {'Global: {{site_name}}, {{site_url}}, {{dashboard_url}}'}
        </span>
      </div>
    </Card>

    <!-- Editor Form -->
    <form id="template-editor-form" class="space-y-6">
      <input type="hidden" name="id" value={template.id} />
      <input type="hidden" name="event_key" value={template.event_key} />
      <input type="hidden" name="allowed_variables" value={template.allowed_variables} />

      <Card class="p-6 border-slate-200 bg-white space-y-6 shadow-sm">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="sm:col-span-2">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
              Template Display Name
            </label>
            <input
              type="text"
              name="name"
              required
              value={template.name}
              class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Status</label>
            <select
              name="status"
              class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold"
            >
              <option value="active" selected={template.status === 'active'}>Active (Sends live emails)</option>
              <option value="inactive" selected={template.status === 'inactive'}>Inactive (Disabled)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
            Email Subject Line
          </label>
          <input
            type="text"
            id="template-subject"
            name="subject"
            required
            value={template.subject}
            class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold"
          />
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
            HTML Email Body
          </label>
          <textarea
            id="template-html"
            name="html_body"
            required
            rows="14"
            class="w-full p-4 bg-slate-900 text-slate-100 rounded-xl font-mono text-xs leading-relaxed border border-slate-800 focus:outline-indigo-500"
          >{template.html_body}</textarea>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
            Plain Text Fallback Body
          </label>
          <textarea
            id="template-text"
            name="text_body"
            required
            rows="6"
            class="w-full p-3.5 bg-slate-50 border border-slate-200 rounded-xl font-mono text-xs text-slate-800"
          >{template.text_body}</textarea>
        </div>
      </Card>

      <div class="flex items-center justify-between pt-2">
        <a
          href="/admin/settings/email/templates"
          class="text-xs font-semibold text-slate-500 hover:underline"
        >
          ← Cancel and Return
        </a>
        <Button type="submit" id="save-template-btn" variant="primary" size="md">
          Save Template Changes
        </Button>
      </div>
    </form>

    <!-- Preview Modal -->
    <div id="preview-modal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl max-w-2xl w-full max-h-[90vh] flex flex-col shadow-2xl overflow-hidden">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between bg-slate-50">
          <div>
            <h3 class="text-sm font-bold text-slate-900">Email Template Live Preview</h3>
            <div id="preview-subject-header" class="text-xs text-indigo-600 font-semibold mt-0.5"></div>
          </div>
          <button type="button" id="close-preview-btn" class="text-slate-400 hover:text-slate-700 text-lg font-bold">✕</button>
        </div>
        <div class="p-6 overflow-y-auto flex-1 bg-slate-100/50">
          <div id="preview-html-container" class="bg-white rounded-xl shadow-xs border border-slate-200 p-2"></div>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    function insertVariable(variable) {
      navigator.clipboard.writeText(variable);
      alert(`Copied "${variable}" to clipboard! Paste it into Subject or HTML Body.`);
    }

    const form = document.getElementById('template-editor-form');
    const saveBtn = document.getElementById('save-template-btn');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';

        const formData = new FormData(form);
        const payload = {
          id: formData.get('id'),
          event_key: formData.get('event_key'),
          name: formData.get('name'),
          subject: formData.get('subject'),
          html_body: formData.get('html_body'),
          text_body: formData.get('text_body'),
          status: formData.get('status'),
          allowed_variables: formData.get('allowed_variables')
        };

        try {
          const res = await fetch('/api/v1/admin/email-templates', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'upsert', template: payload })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            alert('Email template saved successfully!');
            window.location.reload();
          } else {
            alert(data.message || 'Failed to save template');
          }
        } catch {
          alert('Network error saving template');
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Template Changes';
        }
      });
    }

    // Preview Logic
    const previewBtn = document.getElementById('preview-btn');
    const previewModal = document.getElementById('preview-modal');
    const closePreviewBtn = document.getElementById('close-preview-btn');
    const previewSubjectHeader = document.getElementById('preview-subject-header');
    const previewHtmlContainer = document.getElementById('preview-html-container');

    previewBtn?.addEventListener('click', () => {
      let subject = document.getElementById('template-subject').value;
      let html = document.getElementById('template-html').value;

      const sampleMap = {
        '{{user_name}}': 'Dr. Alex Vance',
        '{{assessment_name}}': 'Big Five Personality Test',
        '{{result_name}}': 'Explorer & Architect',
        '{{report_url}}': 'https://psychologycalculator.com/dashboard/reports/demo',
        '{{result_url}}': 'https://psychologycalculator.com/r/demo-result',
        '{{verify_url}}': 'https://psychologycalculator.com/verify-email?token=sample-token',
        '{{reset_url}}': 'https://psychologycalculator.com/reset-password?token=sample-token',
        '{{billing_url}}': 'https://psychologycalculator.com/dashboard/settings/billing',
        '{{dashboard_url}}': 'https://psychologycalculator.com/dashboard',
        '{{site_name}}': 'Psychology Calculator',
        '{{site_url}}': 'https://psychologycalculator.com',
        '{{plan_name}}': 'Psychology Calculator Pro',
        '{{subject}}': 'Research inquiry regarding normative scoring',
        '{{message_preview}}': 'Hello team, I am interested in citing your Big Five psychometric normative curves for an upcoming research paper...'
      };

      for (const [key, val] of Object.entries(sampleMap)) {
        const regex = new RegExp(key.replace(/([{}])/g, '\\$1'), 'g');
        subject = subject.replace(regex, val);
        html = html.replace(regex, val);
      }

      previewSubjectHeader.textContent = `Subject: ${subject}`;
      previewHtmlContainer.innerHTML = html;
      previewModal.classList.remove('hidden');
    });

    closePreviewBtn?.addEventListener('click', () => {
      previewModal.classList.add('hidden');
    });

    // Test Send Logic
    const testSendBtn = document.getElementById('test-send-btn');
    testSendBtn?.addEventListener('click', async () => {
      const email = prompt('Enter recipient email for live template test send:');
      if (!email) return;

      testSendBtn.disabled = true;
      testSendBtn.textContent = 'Sending...';

      try {
        const eventKey = document.querySelector('input[name="event_key"]').value;
        const res = await fetch('/api/v1/admin/email-test', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'send_template_test', eventKey, testEmail: email })
        });
        const data = await res.json();
        alert(data.message);
      } catch {
        alert('Network error sending test template email');
      } finally {
        testSendBtn.disabled = false;
        testSendBtn.textContent = '✉️ Test Send';
      }
    });
  </script>
</AdminLayout>
