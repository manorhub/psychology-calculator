---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import { getD1Database } from '@/lib/db/client';
import { SettingsService } from '@/services/settings/settings.service';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const settingsService = new SettingsService(db);

const homepage = await settingsService.getGroup('homepage');
---

<AdminLayout title="Homepage Settings">
  <div class="space-y-8 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <a href="/admin/settings" class="text-xs font-semibold text-indigo-600 hover:underline">Settings</a>
          <span class="text-xs text-slate-400">/</span>
          <span class="text-xs font-semibold text-slate-600">Homepage</span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Homepage Content & Sections</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Customize the hero banner, call-to-actions, and section visibility on psychologycalculator.com.
        </p>
      </div>
    </div>

    <!-- Homepage Form -->
    <form id="homepage-form" class="space-y-6">
      <!-- Hero Section -->
      <Card class="p-6 border-slate-200 bg-white shadow-xs space-y-4">
        <div class="border-b border-slate-100 pb-3">
          <h3 class="text-sm font-bold text-slate-900">Hero Section</h3>
          <p class="text-xs text-slate-500">Main headline, supporting text, and primary button</p>
        </div>

        <div class="space-y-3">
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700">Hero Headline</label>
            <input
              type="text"
              name="hero_heading"
              value={homepage.hero_heading || 'Discover Your Mind Through Scientific Psychometrics'}
              class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 font-semibold"
            />
          </div>

          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700">Hero Subheadline / Description</label>
            <textarea
              name="hero_description"
              rows="3"
              class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 leading-relaxed"
            >{homepage.hero_description || 'Take validated psychological assessments with instant scoring, dimensional breakdowns, and personalized AI narrative interpretations.'}</textarea>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label class="text-xs font-bold text-slate-700">Hero CTA Button Text</label>
              <input
                type="text"
                name="hero_cta_text"
                value={homepage.hero_cta_text || 'Explore Assessments'}
                class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 font-medium"
              />
            </div>
            <div class="space-y-1.5">
              <label class="text-xs font-bold text-slate-700">Hero CTA Button URL</label>
              <input
                type="text"
                name="hero_cta_url"
                value={homepage.hero_cta_url || '/assessments'}
                class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 font-mono"
              />
            </div>
          </div>
        </div>
      </Card>

      <!-- Section Toggles -->
      <Card class="p-6 border-slate-200 bg-white shadow-xs space-y-4">
        <div class="border-b border-slate-100 pb-3">
          <h3 class="text-sm font-bold text-slate-900">Homepage Section Visibility</h3>
          <p class="text-xs text-slate-500">Enable or disable major content blocks on the homepage</p>
        </div>

        <div class="space-y-3">
          <label class="flex items-center gap-3 cursor-pointer">
            <input
              type="checkbox"
              name="featured_assessments_enabled"
              checked={homepage.featured_assessments_enabled !== false}
              class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500"
            />
            <div>
              <span class="text-xs font-bold text-slate-900">Featured Assessments Grid</span>
              <p class="text-xs text-slate-500">Display the top psychometric assessments on the homepage</p>
            </div>
          </label>

          <label class="flex items-center gap-3 cursor-pointer">
            <input
              type="checkbox"
              name="how_it_works_enabled"
              checked={homepage.how_it_works_enabled !== false}
              class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500"
            />
            <div>
              <span class="text-xs font-bold text-slate-900">How It Works (3-Step Guide)</span>
              <p class="text-xs text-slate-500">Explain the assessment, scoring, and AI synthesis workflow</p>
            </div>
          </label>

          <label class="flex items-center gap-3 cursor-pointer">
            <input
              type="checkbox"
              name="homepage_faqs_enabled"
              checked={homepage.homepage_faqs_enabled !== false}
              class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500"
            />
            <div>
              <span class="text-xs font-bold text-slate-900">Frequently Asked Questions (FAQ)</span>
              <p class="text-xs text-slate-500">Display common psychometric questions and answers</p>
            </div>
          </label>
        </div>
      </Card>

      <!-- Bottom Banner CTA -->
      <Card class="p-6 border-slate-200 bg-white shadow-xs space-y-4">
        <div class="border-b border-slate-100 pb-3">
          <h3 class="text-sm font-bold text-slate-900">Bottom Call-to-Action Banner</h3>
          <p class="text-xs text-slate-500">Final conversion card at the footer of the homepage</p>
        </div>

        <div class="space-y-3">
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700">Banner Heading</label>
            <input
              type="text"
              name="final_cta_heading"
              value={homepage.final_cta_heading || 'Ready to Understand Yourself on a Deeper Level?'}
              class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 font-semibold"
            />
          </div>

          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700">Banner Description</label>
            <input
              type="text"
              name="final_cta_description"
              value={homepage.final_cta_description || 'Join thousands of self-reflective explorers taking scientifically grounded evaluations.'}
              class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500"
            />
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label class="text-xs font-bold text-slate-700">Button Text</label>
              <input
                type="text"
                name="final_cta_button_text"
                value={homepage.final_cta_button_text || 'Start Free Assessment'}
                class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 font-medium"
              />
            </div>
            <div class="space-y-1.5">
              <label class="text-xs font-bold text-slate-700">Button URL</label>
              <input
                type="text"
                name="final_cta_button_url"
                value={homepage.final_cta_button_url || '/assessments/big-five-personality-test'}
                class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 font-mono"
              />
            </div>
          </div>
        </div>
      </Card>

      <div class="flex items-center justify-end gap-3 pt-2">
        <button
          type="submit"
          class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold transition-all shadow-xs"
        >
          Save Homepage Settings
        </button>
      </div>
    </form>
  </div>

  <script is:inline>
    const form = document.getElementById('homepage-form');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const payload = {
        group: 'homepage',
        settings: {
          hero_heading: formData.get('hero_heading'),
          hero_description: formData.get('hero_description'),
          hero_cta_text: formData.get('hero_cta_text'),
          hero_cta_url: formData.get('hero_cta_url'),
          featured_assessments_enabled: formData.has('featured_assessments_enabled'),
          how_it_works_enabled: formData.has('how_it_works_enabled'),
          homepage_faqs_enabled: formData.has('homepage_faqs_enabled'),
          final_cta_heading: formData.get('final_cta_heading'),
          final_cta_description: formData.get('final_cta_description'),
          final_cta_button_text: formData.get('final_cta_button_text'),
          final_cta_button_url: formData.get('final_cta_button_url')
        }
      };

      try {
        const res = await fetch('/api/v1/admin/settings/group', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const json = await res.json();
        if (json.success) {
          alert('Homepage settings saved successfully!');
        } else {
          alert('Failed to save settings: ' + (json.error?.message || 'Error'));
        }
      } catch (err) {
        alert('Network error: ' + err.message);
      }
    });
  </script>
</AdminLayout>
