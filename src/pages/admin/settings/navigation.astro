---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import { getD1Database } from '@/lib/db/client';
import { SettingsService } from '@/services/settings/settings.service';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const settingsService = new SettingsService(db);

const [headerNav, footerNav, socialLinks] = await Promise.all([
  settingsService.get<any[]>('header_nav_links', []),
  settingsService.get<any[]>('footer_nav_columns', []),
  settingsService.get<Record<string, string>>('social_links', {})
]);
---

<AdminLayout title="Navigation & Menus">
  <div class="space-y-8 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <a href="/admin/settings" class="text-xs font-semibold text-indigo-600 hover:underline">Settings</a>
          <span class="text-xs text-slate-400">/</span>
          <span class="text-xs font-semibold text-slate-600">Navigation & Menus</span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Header, Footer & Social Menus</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Dynamically configure header links, footer categories, and verified social channels.
        </p>
      </div>
    </div>

    <!-- Navigation Form -->
    <form id="navigation-form" class="space-y-6">
      <!-- Header Links JSON -->
      <Card class="p-6 border-slate-200 bg-white shadow-xs space-y-4">
        <div class="border-b border-slate-100 pb-3">
          <h3 class="text-sm font-bold text-slate-900">Header Navigation Menu</h3>
          <p class="text-xs text-slate-500">Structured JSON array of navigation items (Label & URL)</p>
        </div>

        <div class="space-y-1.5">
          <textarea
            name="header_nav_links"
            rows="6"
            class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-xs font-mono focus:ring-2 focus:ring-indigo-500"
          >{JSON.stringify(headerNav, null, 2)}</textarea>
        </div>
      </Card>

      <!-- Footer Columns JSON -->
      <Card class="p-6 border-slate-200 bg-white shadow-xs space-y-4">
        <div class="border-b border-slate-100 pb-3">
          <h3 class="text-sm font-bold text-slate-900">Footer Column Navigation</h3>
          <p class="text-xs text-slate-500">Structured JSON array of footer sections and sub-links</p>
        </div>

        <div class="space-y-1.5">
          <textarea
            name="footer_nav_columns"
            rows="8"
            class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-xs font-mono focus:ring-2 focus:ring-indigo-500"
          >{JSON.stringify(footerNav, null, 2)}</textarea>
        </div>
      </Card>

      <!-- Social Links -->
      <Card class="p-6 border-slate-200 bg-white shadow-xs space-y-4">
        <div class="border-b border-slate-100 pb-3">
          <h3 class="text-sm font-bold text-slate-900">Social Media Channels</h3>
          <p class="text-xs text-slate-500">Enter full URLs for active channels (leave blank to hide)</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700">X / Twitter</label>
            <input
              type="text"
              name="social_twitter"
              value={socialLinks.twitter || ''}
              placeholder="https://twitter.com/psychologycalc"
              class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 font-mono"
            />
          </div>

          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700">LinkedIn</label>
            <input
              type="text"
              name="social_linkedin"
              value={socialLinks.linkedin || ''}
              placeholder="https://linkedin.com/company/psychologycalculator"
              class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 font-mono"
            />
          </div>

          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700">YouTube</label>
            <input
              type="text"
              name="social_youtube"
              value={socialLinks.youtube || ''}
              placeholder="https://youtube.com/@psychologycalc"
              class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 font-mono"
            />
          </div>

          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700">Facebook</label>
            <input
              type="text"
              name="social_facebook"
              value={socialLinks.facebook || ''}
              placeholder="https://facebook.com/psychologycalculator"
              class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 font-mono"
            />
          </div>
        </div>
      </Card>

      <div class="flex items-center justify-end gap-3 pt-2">
        <button
          type="submit"
          class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold transition-all shadow-xs"
        >
          Save Navigation & Socials
        </button>
      </div>
    </form>
  </div>

  <script is:inline>
    const form = document.getElementById('navigation-form');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);

      let headerNav = [];
      let footerNav = [];
      try {
        headerNav = JSON.parse(formData.get('header_nav_links'));
        footerNav = JSON.parse(formData.get('footer_nav_columns'));
      } catch (err) {
        alert('Invalid JSON in header or footer fields: ' + err.message);
        return;
      }

      const socialLinks = {
        twitter: formData.get('social_twitter') || '',
        linkedin: formData.get('social_linkedin') || '',
        youtube: formData.get('social_youtube') || '',
        facebook: formData.get('social_facebook') || ''
      };

      try {
        const res = await fetch('/api/v1/admin/settings/group', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            group: 'navigation',
            settings: {
              header_nav_links: headerNav,
              footer_nav_columns: footerNav,
              social_links: socialLinks
            }
          })
        });
        const json = await res.json();
        if (json.success) {
          alert('Navigation settings saved successfully!');
        } else {
          alert('Failed to save: ' + (json.error?.message || 'Error'));
        }
      } catch (err) {
        alert('Network error: ' + err.message);
      }
    });
  </script>
</AdminLayout>
