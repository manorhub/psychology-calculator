---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Button from '@/components/ui/Button.astro';
import Input from '@/components/ui/Input.astro';
import { SeoService } from '@/services/seo/seo.service';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = env?.DB || null;

const seoService = new SeoService(db);
const settings = await seoService.getSeoSettings();
---

<AdminLayout title="Global SEO & Search Settings — Admin Control">
  <div class="space-y-8 max-w-5xl">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          SEO & Search Optimization Settings
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Configure global metadata templates, canonical URLs, search engine verifications, and analytics
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/seo/audit"
          class="px-4 py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-xs font-bold rounded-xl transition-all"
        >
          🔍 SEO Audit
        </a>
        <a
          href="/admin/seo/redirects"
          class="px-4 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-bold rounded-xl transition-all"
        >
          🔀 Redirects
        </a>
      </div>
    </div>

    <!-- Status Message -->
    <div id="seo-msg" class="hidden p-4 rounded-xl text-xs font-semibold"></div>

    <form id="seo-settings-form" class="space-y-6">
      <!-- 1. Metadata & Titles -->
      <Card class="p-6 sm:p-8 space-y-6">
        <div class="border-b border-slate-100 pb-3">
          <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400">
            Global Metadata & Title Formulas
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <Input
            id="seo_site_title"
            name="seo_site_title"
            label="Site Title"
            value={settings.siteTitle}
            placeholder="Psychology Calculator"
            required
          />

          <Input
            id="seo_title_template"
            name="seo_title_template"
            label="Title Formula Template"
            value={settings.titleTemplate}
            placeholder="{{page_title}} | Psychology Calculator"
            required
          />
        </div>

        <div class="space-y-1.5">
          <label for="seo_default_description" class="text-xs font-semibold text-slate-700">
            Default Meta Description
          </label>
          <textarea
            id="seo_default_description"
            name="seo_default_description"
            rows="3"
            class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
            required
          >{settings.defaultDescription}</textarea>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <Input
            id="seo_canonical_domain"
            name="seo_canonical_domain"
            label="Canonical Domain Origin"
            value={settings.canonicalDomain}
            placeholder="https://psychologycalculator.com"
            required
          />

          <Input
            id="seo_default_robots"
            name="seo_default_robots"
            label="Default Robots Directive"
            value={settings.defaultRobots}
            placeholder="index, follow"
            required
          />
        </div>
      </Card>

      <!-- 2. Social Sharing & Brand Graph -->
      <Card class="p-6 sm:p-8 space-y-6">
        <div class="border-b border-slate-100 pb-3">
          <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400">
            Social Sharing (OG / Twitter) & Schema Graph
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <Input
            id="seo_org_name"
            name="seo_org_name"
            label="Organization Brand Name"
            value={settings.orgName}
            placeholder="Psychology Calculator"
          />

          <Input
            id="seo_twitter_handle"
            name="seo_twitter_handle"
            label="Twitter / X Handle"
            value={settings.twitterHandle}
            placeholder="@PsychCalculator"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <Input
            id="seo_default_og_image"
            name="seo_default_og_image"
            label="Default Social Card Image (OG Image)"
            value={settings.defaultOgImage}
            placeholder="/images/og-default.png"
          />

          <Input
            id="seo_org_logo"
            name="seo_org_logo"
            label="Organization Logo URL"
            value={settings.orgLogo}
            placeholder="/images/logo.png"
          />
        </div>
      </Card>

      <!-- 3. Search Engine Verification & Analytics -->
      <Card class="p-6 sm:p-8 space-y-6">
        <div class="border-b border-slate-100 pb-3">
          <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400">
            Webmaster Verification & Analytics
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <Input
            id="seo_gsc_verification"
            name="seo_gsc_verification"
            label="Google Search Console Token"
            value={settings.gscVerification}
            placeholder="e.g. 7abc987def..."
          />

          <Input
            id="seo_bing_verification"
            name="seo_bing_verification"
            label="Bing Webmaster Verification Token"
            value={settings.bingVerification}
            placeholder="e.g. 1234567890ABCDEF..."
          />
        </div>

        <Input
          id="seo_ga4_measurement_id"
          name="seo_ga4_measurement_id"
          label="Google Analytics 4 Measurement ID"
          value={settings.ga4MeasurementId}
          placeholder="G-XXXXXXXXXX"
        />
      </Card>

      <div class="flex justify-end gap-3">
        <Button type="submit" variant="primary" id="save-seo-btn">
          Save SEO Settings
        </Button>
      </div>
    </form>
  </div>

  <script is:inline>
    const form = document.getElementById('seo-settings-form') as HTMLFormElement;
    const saveBtn = document.getElementById('save-seo-btn') as HTMLButtonElement;
    const msg = document.getElementById('seo-msg') as HTMLDivElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';
      msg.className = 'hidden';

      const formData = new FormData(form);
      const settingsPayload: Record<string, string> = {};
      for (const [key, value] of formData.entries()) {
        settingsPayload[key] = String(value);
      }

      try {
        const res = await fetch('/api/v1/admin/settings', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ settings: settingsPayload })
        });

        const data = (await res.json()) as any;
        if (!res.ok) throw new Error(data.error?.message || 'Failed to update SEO settings');

        msg.textContent = '✓ SEO and Search settings updated successfully!';
        msg.className = 'p-4 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 block';
      } catch (err: any) {
        msg.textContent = `❌ ${err.message || 'Error updating settings'}`;
        msg.className = 'p-4 rounded-xl text-xs font-semibold bg-rose-50 text-rose-800 border border-rose-200 block';
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save SEO Settings';
      }
    });
  </script>
</AdminLayout>
