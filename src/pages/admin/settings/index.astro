---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Input from '@/components/ui/Input.astro';
import Button from '@/components/ui/Button.astro';
import Alert from '@/components/ui/Alert.astro';
import { getD1Database } from '@/lib/db/client';
import { AdminService } from '@/services/admin.service';

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const adminService = new AdminService(db);

const settings = await adminService.getAllSettings();
---

<AdminLayout title="Platform Settings" description="Configure general, site, and operational settings">
  <div class="max-w-4xl space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Platform Settings</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Manage brand identity, contact information, and operational state</p>
      </div>

      <div class="flex flex-wrap gap-2">
        <Button href="/admin/settings/assessments" variant="outline" size="sm">
          📋 Assessment & Guest
        </Button>
        <Button href="/admin/settings/email" variant="outline" size="sm">
          ✉️ SMTP Settings
        </Button>
        <Button href="/admin/settings/features" variant="outline" size="sm">
          🚩 Feature Flags
        </Button>
      </div>
    </div>

    <div id="save-alert" class="hidden">
      <Alert variant="success" title="Settings Updated">
        Platform settings have been saved successfully.
      </Alert>
    </div>

    <form id="settings-form" class="space-y-6">
      <!-- General Branding & Contact -->
      <Card title="General Identity" subtitle="Core brand details displayed across public pages and emails">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <Input
            id="site_name"
            name="site_name"
            label="Site / Product Name"
            value={settings.site_name || 'MindMetrics'}
            required={true}
          />

          <Input
            id="contact_email"
            name="contact_email"
            type="email"
            label="Public Contact Email"
            value={settings.contact_email || 'support@mindmetrics.io'}
            required={true}
          />

          <div class="sm:col-span-2">
            <Input
              id="site_description"
              name="site_description"
              label="Site Tagline / Description"
              value={settings.site_description || 'Evidence-based psychometric self-assessments and psychological insights'}
            />
          </div>

          <div>
            <label for="default_currency" class="block text-xs font-semibold text-slate-700 mb-1">
              Default Currency
            </label>
            <select
              id="default_currency"
              name="default_currency"
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-800 focus:ring-2 focus:ring-teal-600"
            >
              <option value="USD" selected={settings.default_currency === 'USD'}>USD ($)</option>
              <option value="EUR" selected={settings.default_currency === 'EUR'}>EUR (€)</option>
              <option value="GBP" selected={settings.default_currency === 'GBP'}>GBP (£)</option>
            </select>
          </div>

          <div>
            <label for="timezone" class="block text-xs font-semibold text-slate-700 mb-1">
              Default Timezone
            </label>
            <select
              id="timezone"
              name="timezone"
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-800 focus:ring-2 focus:ring-teal-600"
            >
              <option value="UTC" selected={settings.timezone === 'UTC'}>UTC (Coordinated Universal Time)</option>
              <option value="America/New_York" selected={settings.timezone === 'America/New_York'}>America/New_York (EST)</option>
              <option value="Europe/London" selected={settings.timezone === 'Europe/London'}>Europe/London (GMT/BST)</option>
              <option value="Asia/Tokyo" selected={settings.timezone === 'Asia/Tokyo'}>Asia/Tokyo (JST)</option>
            </select>
          </div>
        </div>
      </Card>

      <!-- Operational State & Maintenance Mode -->
      <Card title="Site Operations & Announcements" subtitle="Control maintenance window and public notices">
        <div class="space-y-4">
          <!-- Maintenance Mode Toggle -->
          <div class="flex items-center justify-between p-4 rounded-xl bg-slate-50 border border-slate-200">
            <div>
              <div class="text-xs font-bold text-slate-900">Maintenance Mode</div>
              <p class="text-[11px] text-slate-500 mt-0.5">
                When enabled, public visitors receive a 503 maintenance notice while administrators retain access.
              </p>
            </div>
            <label class="relative inline-flex items-center cursor-pointer">
              <input
                type="checkbox"
                name="maintenance_mode"
                value="true"
                checked={settings.maintenance_mode === 'true'}
                class="sr-only peer"
              />
              <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-rose-600"></div>
            </label>
          </div>

          <!-- Announcement Bar -->
          <div class="p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-3">
            <div class="flex items-center justify-between">
              <div class="text-xs font-bold text-slate-900">Announcement Header Banner</div>
              <label class="relative inline-flex items-center cursor-pointer">
                <input
                  type="checkbox"
                  name="announcement_enabled"
                  value="true"
                  checked={settings.announcement_enabled === 'true'}
                  class="sr-only peer"
                />
                <div class="w-11 h-6 bg-slate-300 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-teal-600"></div>
              </label>
            </div>

            <Input
              id="announcement_text"
              name="announcement_text"
              label="Banner Message"
              placeholder="e.g. 🎉 Explore our new Big Five Personality Assessment!"
              value={settings.announcement_text || ''}
            />
          </div>
        </div>
      </Card>

      <div class="flex justify-end">
        <Button type="submit" variant="primary" size="md" id="save-btn">
          Save Settings
        </Button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  const form = document.getElementById('settings-form') as HTMLFormElement | null;
  const saveAlert = document.getElementById('save-alert');
  const saveBtn = document.getElementById('save-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveAlert?.classList.add('hidden');
    saveBtn?.setAttribute('disabled', 'true');

    const formData = new FormData(form);
    const settings: Record<string, string> = {
      site_name: String(formData.get('site_name') || ''),
      contact_email: String(formData.get('contact_email') || ''),
      site_description: String(formData.get('site_description') || ''),
      default_currency: String(formData.get('default_currency') || 'USD'),
      timezone: String(formData.get('timezone') || 'UTC'),
      maintenance_mode: formData.get('maintenance_mode') === 'true' ? 'true' : 'false',
      announcement_enabled: formData.get('announcement_enabled') === 'true' ? 'true' : 'false',
      announcement_text: String(formData.get('announcement_text') || '')
    };

    try {
      const res = await fetch('/api/admin/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ settings })
      });
      const data: any = await res.json();

      if (!res.ok || !data.success) {
        alert(data.error?.message || 'Failed to save settings.');
        saveBtn?.removeAttribute('disabled');
        return;
      }

      saveAlert?.classList.remove('hidden');
      saveBtn?.removeAttribute('disabled');
    } catch {
      alert('A network error occurred.');
      saveBtn?.removeAttribute('disabled');
    }
  });
</script>
