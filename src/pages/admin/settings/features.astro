---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import { getD1Database } from '@/lib/db/client';
import { FeatureService } from '@/services/features/feature.service';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const featureService = new FeatureService(db);

const flags = await featureService.getAll();
---

<AdminLayout title="Feature Flags">
  <div class="space-y-8 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <a href="/admin/settings" class="text-xs font-semibold text-indigo-600 hover:underline">Settings</a>
          <span class="text-xs text-slate-400">/</span>
          <span class="text-xs font-semibold text-slate-600">Feature Flags</span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Platform Feature Flags</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Instant runtime switches for major platform capabilities. Disabling a feature safely preserves underlying data.
        </p>
      </div>
    </div>

    <!-- Flags List -->
    <div class="space-y-4">
      {flags.map((flag) => (
        <Card class="p-5 border-slate-200 bg-white shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="space-y-1">
            <div class="flex items-center gap-2">
              <h3 class="text-sm font-bold text-slate-900">{flag.name}</h3>
              <code class="text-[10px] px-2 py-0.5 bg-slate-100 text-slate-600 rounded font-mono">
                {flag.key}
              </code>
              {flag.is_enabled === 1 ? (
                <Badge variant="success" size="sm">ACTIVE</Badge>
              ) : (
                <Badge variant="default" size="sm">DISABLED</Badge>
              )}
            </div>
            <p class="text-xs text-slate-500">{flag.description}</p>
          </div>

          <div>
            <button
              type="button"
              data-key={flag.key}
              data-enabled={flag.is_enabled === 1 ? 'true' : 'false'}
              class={`px-4 py-2 rounded-xl text-xs font-bold transition-all ${
                flag.is_enabled === 1
                  ? 'bg-rose-50 text-rose-700 hover:bg-rose-100 border border-rose-200'
                  : 'bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200'
              }`}
            >
              {flag.is_enabled === 1 ? 'Disable Feature' : 'Enable Feature'}
            </button>
          </div>
        </Card>
      ))}
    </div>
  </div>

  <script is:inline>
    document.querySelectorAll('button[data-key]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const key = btn.getAttribute('data-key');
        const current = btn.getAttribute('data-enabled') === 'true';
        const next = !current;

        try {
          const res = await fetch('/api/v1/admin/features/toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ key, isEnabled: next })
          });
          const json = await res.json();
          if (json.success) {
            window.location.reload();
          } else {
            alert('Failed to toggle flag: ' + (json.error?.message || 'Error'));
          }
        } catch (err) {
          alert('Network error: ' + err.message);
        }
      });
    });
  </script>
</AdminLayout>
