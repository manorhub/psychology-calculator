---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import { getD1Database } from '@/lib/db/client';
import { EmailService } from '@/services/email.service';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const emailService = new EmailService(db);

const smtp = await emailService.getSmtpConfig(true);
---

<AdminLayout title="SMTP & Email Communication">
  <div class="max-w-4xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <a href="/admin/settings" class="text-xs font-semibold text-indigo-600 hover:underline">Settings</a>
          <span class="text-xs text-slate-400">/</span>
          <span class="text-xs font-semibold text-slate-600">Email & SMTP</span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">SMTP & Communication Settings</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Configure transactional email servers, sender branding, and test live SMTP delivery.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/settings/email/templates"
          class="px-4 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-bold rounded-xl transition-colors inline-flex items-center gap-1.5"
        >
          ✉️ Email Templates
        </a>
        <a
          href="/admin/email/logs"
          class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-colors inline-flex items-center gap-1.5"
        >
          📋 Delivery Logs
        </a>
      </div>
    </div>

    <!-- SMTP Configuration Form -->
    <form id="smtp-form" class="space-y-6">
      <Card class="p-6 border-slate-200 bg-white space-y-6 shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <div>
            <h3 class="text-sm font-bold text-slate-900">SMTP Server Credentials</h3>
            <p class="text-xs text-slate-500">Sensitive credentials remain server-side and are never exposed.</p>
          </div>
          <Badge variant={smtp.enabled ? 'success' : 'default'} size="sm">
            {smtp.enabled ? 'SMTP Enabled' : 'Console Fallback'}
          </Badge>
        </div>

        <div class="flex items-center justify-between p-4 rounded-xl bg-slate-50 border border-slate-200">
          <div>
            <div class="text-xs font-bold text-slate-900">Enable SMTP Delivery</div>
            <p class="text-[11px] text-slate-500 mt-0.5">
              When disabled, transactional emails are logged safely to the console.
            </p>
          </div>
          <input
            type="checkbox"
            name="enabled"
            value="true"
            checked={smtp.enabled}
            class="w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500 cursor-pointer"
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="sm:col-span-2">
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">SMTP Host</label>
            <input
              type="text"
              name="host"
              value={smtp.host}
              placeholder="e.g. smtp.mailgun.org or smtp.sendgrid.net"
              class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Port</label>
            <input
              type="number"
              name="port"
              value={smtp.port}
              placeholder="587"
              class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">SMTP Username</label>
            <input
              type="text"
              name="username"
              value={smtp.username}
              placeholder="postmaster@psychologycalculator.com"
              class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">SMTP Password</label>
            <input
              type="password"
              name="password"
              value={smtp.password}
              placeholder={smtp.password ? '••••••••' : 'Enter SMTP password'}
              class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono"
            />
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Encryption Protocol</label>
          <select
            name="security"
            class="w-full sm:w-1/2 px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold"
          >
            <option value="tls" selected={smtp.security === 'tls'}>TLS / STARTTLS (Port 587 - Recommended)</option>
            <option value="ssl" selected={smtp.security === 'ssl'}>SSL (Port 465)</option>
            <option value="none" selected={smtp.security === 'none'}>None (Insecure / Local Only)</option>
          </select>
        </div>
      </Card>

      <!-- Sender Branding Card -->
      <Card class="p-6 border-slate-200 bg-white space-y-4 shadow-sm">
        <h3 class="text-sm font-bold text-slate-900 border-b border-slate-100 pb-3">
          Sender Identification & Branding
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">From Name</label>
            <input
              type="text"
              name="fromName"
              value={smtp.fromName}
              class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">From Email</label>
            <input
              type="email"
              name="fromEmail"
              value={smtp.fromEmail}
              class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono"
            />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Reply-To Email</label>
            <input
              type="email"
              name="replyTo"
              value={smtp.replyTo}
              class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono"
            />
          </div>
        </div>
      </Card>

      <div class="flex items-center justify-end gap-3">
        <Button type="submit" id="save-smtp-btn" variant="primary" size="md">
          Save Configuration
        </Button>
      </div>
    </form>

    <!-- Test Email Card -->
    <Card class="p-6 border-slate-200 bg-white space-y-4 shadow-sm">
      <h3 class="text-sm font-bold text-slate-900">Send Live SMTP Test Email</h3>
      <p class="text-xs text-slate-500">
        Dispatches a diagnostic test message to verify outbound credentials and transport connectivity.
      </p>

      <form id="test-email-form" class="flex flex-wrap items-center gap-3 pt-2">
        <div class="flex-1 min-w-[240px]">
          <input
            type="email"
            id="test-recipient"
            name="testEmail"
            required
            placeholder="admin@yourdomain.com"
            class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono"
          />
        </div>
        <Button type="submit" id="send-test-btn" variant="secondary" size="sm">
          Send Test Email
        </Button>
      </form>
    </Card>
  </div>

  <script is:inline>
    const smtpForm = document.getElementById('smtp-form');
    const saveBtn = document.getElementById('save-smtp-btn');

    if (smtpForm) {
      smtpForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';

        const formData = new FormData(smtpForm);
        const payload = {
          enabled: formData.get('enabled') === 'true',
          host: formData.get('host'),
          port: parseInt(formData.get('port') || '587', 10),
          username: formData.get('username'),
          password: formData.get('password'),
          security: formData.get('security'),
          fromName: formData.get('fromName'),
          fromEmail: formData.get('fromEmail'),
          replyTo: formData.get('replyTo')
        };

        try {
          const res = await fetch('/api/v1/admin/email-test', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'save_config', config: payload })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            alert('SMTP Configuration saved successfully!');
            window.location.reload();
          } else {
            alert(data.message || 'Failed to save configuration');
          }
        } catch {
          alert('Network error saving SMTP config');
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Configuration';
        }
      });
    }

    const testForm = document.getElementById('test-email-form');
    const sendTestBtn = document.getElementById('send-test-btn');

    if (testForm) {
      testForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        sendTestBtn.disabled = true;
        sendTestBtn.textContent = 'Sending...';

        const testEmail = document.getElementById('test-recipient').value;

        try {
          const res = await fetch('/api/v1/admin/email-test', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'send_test', testEmail })
          });
          const data = await res.json();
          alert(data.message);
        } catch {
          alert('Network error sending test email');
        } finally {
          sendTestBtn.disabled = false;
          sendTestBtn.textContent = 'Send Test Email';
        }
      });
    }
  </script>
</AdminLayout>
