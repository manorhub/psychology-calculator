---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { getD1Database } from '@/lib/db/client';
import { AIService } from '@/services/ai/ai.service';

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const aiService = new AIService(db, (env as any) || {});

const [isMasterEnabled, analytics, configsWithKeys, recentGenerations] = await Promise.all([
  aiService.isMasterAiEnabled(),
  aiService.getAIAnalytics(),
  aiService.getConfigsWithKeyStatus(),
  aiService.getGenerations(5, 0)
]);
---

<AdminLayout title="AI Interpretation Engine Management" description="Multi-provider AI orchestration, API key management, and token accounting">
  <div class="space-y-8">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight flex items-center gap-3">
          <span>AI Interpretation Engine</span>
          <Badge variant={isMasterEnabled ? 'success' : 'danger'} size="sm">
            {isMasterEnabled ? 'SYSTEM ACTIVE' : 'SYSTEM DISABLED'}
          </Badge>
        </h1>
        <p class="text-xs text-slate-500 mt-1">
          Multi-provider orchestration (Gemini, OpenAI, OpenRouter, DeepSeek), API keys, and cost accounting.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/ai/prompts"
          class="px-4 py-2 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 rounded-xl text-xs font-bold transition-all shadow-2xs"
        >
          Manage Prompts →
        </a>
        <a
          href="/admin/ai/generations"
          class="px-4 py-2 bg-slate-900 hover:bg-black text-white rounded-xl text-xs font-bold transition-all shadow-2xs"
        >
          View All Generations →
        </a>
      </div>
    </div>

    <!-- Master AI System Control Banner -->
    <Card class="p-6 bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white border-none shadow-md">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="space-y-1 max-w-2xl">
          <div class="flex items-center gap-2">
            <span class="text-xl">⚡</span>
            <h2 class="text-lg font-bold text-white tracking-tight">Master AI Generation Switch</h2>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed">
            {isMasterEnabled
              ? 'AI psychological interpretations are actively enabled platform-wide. Qualified assessment takers can generate in-depth reports.'
              : 'AI generation is currently disabled platform-wide. No LLM calls or API token charges will be incurred.'}
          </p>
        </div>

        <div class="flex items-center gap-3 self-start md:self-auto flex-shrink-0">
          <button
            type="button"
            id="master-ai-toggle-btn"
            data-active={isMasterEnabled ? 'true' : 'false'}
            class={`px-6 py-3 rounded-xl text-xs font-bold cursor-pointer transition-all shadow-sm flex items-center gap-2 ${
              isMasterEnabled
                ? 'bg-rose-600 hover:bg-rose-700 text-white'
                : 'bg-emerald-500 hover:bg-emerald-600 text-slate-950 font-black'
            }`}
          >
            <span>{isMasterEnabled ? '⏸ Turn OFF AI Platform-Wide' : '▶ Turn ON AI Platform-Wide'}</span>
          </button>
        </div>
      </div>
    </Card>

    <!-- Aggregate Analytics Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <Card class="p-5 space-y-1">
        <span class="text-xs font-semibold text-slate-500">Total Generations</span>
        <div class="text-2xl font-black text-slate-900 font-mono">{analytics.totalGenerations}</div>
        <span class="text-[10px] text-emerald-700 font-bold block">{analytics.successfulGenerations} Successful</span>
      </Card>

      <Card class="p-5 space-y-1">
        <span class="text-xs font-semibold text-slate-500">Total Tokens Processed</span>
        <div class="text-2xl font-black text-slate-900 font-mono">{analytics.totalTokens.toLocaleString()}</div>
        <span class="text-[10px] text-slate-400 font-mono block">Input + Output</span>
      </Card>

      <Card class="p-5 space-y-1">
        <span class="text-xs font-semibold text-slate-500">Estimated AI Cost</span>
        <div class="text-2xl font-black text-emerald-700 font-mono">${analytics.totalEstimatedCost.toFixed(4)}</div>
        <span class="text-[10px] text-slate-400 font-mono block">API usage accrued</span>
      </Card>

      <Card class="p-5 space-y-1">
        <span class="text-xs font-semibold text-slate-500">Average Latency</span>
        <div class="text-2xl font-black text-slate-900 font-mono">{analytics.averageLatencyMs}ms</div>
        <span class="text-[10px] text-slate-400 font-mono block">Server execution</span>
      </Card>
    </div>

    <!-- Provider Orchestration & API Key Setup -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-lg font-bold text-slate-900">Provider Orchestration & API Keys</h2>
          <p class="text-xs text-slate-500">Enable/disable individual providers, set priority routing, and update API keys directly.</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {configsWithKeys.map((cfg) => (
          <Card class="p-6 space-y-5 border border-slate-200">
            <!-- Card Header -->
            <div class="flex items-start justify-between gap-4 pb-4 border-b border-slate-100">
              <div class="space-y-1">
                <div class="flex items-center gap-2">
                  <h3 class="font-extrabold text-base text-slate-900 uppercase tracking-tight">
                    {cfg.provider}
                  </h3>
                  <span class="px-2 py-0.5 rounded-full text-[10px] font-mono font-bold bg-slate-100 text-slate-700">
                    Priority #{cfg.priority}
                  </span>
                </div>
                <p class="text-xs text-slate-500 font-mono">Model: <strong>{cfg.model}</strong></p>
              </div>

              <div class="flex flex-col items-end gap-1.5">
                <button
                  type="button"
                  class="provider-toggle-btn inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold cursor-pointer transition-all border"
                  data-config-id={cfg.id}
                  data-enabled={cfg.is_enabled ? 'true' : 'false'}
                  style={
                    cfg.is_enabled
                      ? 'background-color: #ecfdf5; color: #047857; border-color: #a7f3d0;'
                      : 'background-color: #f1f5f9; color: #64748b; border-color: #e2e8f0;'
                  }
                >
                  <span class={`w-2 h-2 rounded-full ${cfg.is_enabled ? 'bg-emerald-500' : 'bg-slate-400'}`}></span>
                  <span>{cfg.is_enabled ? 'Active (ON)' : 'Disabled (OFF)'}</span>
                </button>

                <span class="text-[10px] text-slate-400">
                  {cfg.hasApiKey ? (
                    <span class="text-emerald-700 font-semibold">✓ Key Set ({cfg.maskedKey})</span>
                  ) : (
                    <span class="text-amber-600 font-semibold">⚠️ Key Missing</span>
                  )}
                </span>
              </div>
            </div>

            <!-- Configuration Form -->
            <form class="provider-config-form space-y-4" data-config-id={cfg.id}>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">
                    Model Name
                  </label>
                  <input
                    type="text"
                    name="model"
                    value={cfg.model}
                    class="w-full px-3 py-2 text-xs font-mono rounded-xl border border-slate-200 bg-white focus:ring-2 focus:ring-teal-600 focus:outline-none"
                    placeholder="e.g. gemini-1.5-flash"
                    required
                  />
                </div>

                <div>
                  <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">
                    Credit Cost
                  </label>
                  <input
                    type="number"
                    name="creditCost"
                    value={cfg.credit_cost}
                    min="0"
                    max="100"
                    class="w-full px-3 py-2 text-xs font-mono rounded-xl border border-slate-200 bg-white focus:ring-2 focus:ring-teal-600 focus:outline-none"
                    required
                  />
                </div>
              </div>

              <div>
                <label class="block text-[11px] font-bold text-slate-700 uppercase tracking-wider mb-1">
                  API Key Secret ({cfg.api_key_reference})
                </label>
                <div class="relative">
                  <input
                    type="password"
                    name="apiKey"
                    class="api-key-input w-full px-3 py-2 text-xs font-mono rounded-xl border border-slate-200 bg-white focus:ring-2 focus:ring-teal-600 focus:outline-none pr-16"
                    placeholder={cfg.hasApiKey ? `Leave blank to keep (${cfg.maskedKey})` : `Paste ${cfg.provider.toUpperCase()} API Key`}
                  />
                  <button
                    type="button"
                    class="toggle-pwd-visibility-btn absolute right-2.5 top-1/2 -translate-y-1/2 text-[11px] font-bold text-slate-400 hover:text-slate-700 cursor-pointer px-1 py-0.5"
                  >
                    Show
                  </button>
                </div>
                <p class="text-[10px] text-slate-400 mt-1">
                  Keys are securely encrypted and stored in Cloudflare D1 settings.
                </p>
              </div>

              <div class="flex items-center justify-between pt-2 border-t border-slate-100">
                <label class="inline-flex items-center gap-2 text-xs font-semibold text-slate-700 cursor-pointer">
                  <input
                    type="checkbox"
                    name="isEnabled"
                    checked={cfg.is_enabled === 1}
                    class="rounded border-slate-300 text-teal-600 focus:ring-teal-500"
                  />
                  <span>Enable this Provider</span>
                </label>

                <Button type="submit" variant="primary" size="sm">
                  Save Credentials
                </Button>
              </div>
            </form>
          </Card>
        ))}
      </div>
    </div>

    <!-- Recent Generation Logs -->
    <div class="space-y-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-bold text-slate-900">Recent Generation Activity</h2>
        <a href="/admin/ai/generations" class="text-xs font-semibold text-teal-700 hover:text-teal-800">
          View All Logs →
        </a>
      </div>

      <Card class="p-0 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-600">
            <thead class="bg-slate-50 text-slate-700 font-bold border-b border-slate-200">
              <tr>
                <th class="p-4">Date</th>
                <th class="p-4">Provider / Model</th>
                <th class="p-4">Status</th>
                <th class="p-4">Tokens</th>
                <th class="p-4">Latency</th>
                <th class="p-4">Est. Cost</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {recentGenerations.length === 0 ? (
                <tr>
                  <td colspan="6" class="p-6 text-center text-slate-400">
                    No AI generation events recorded yet.
                  </td>
                </tr>
              ) : (
                recentGenerations.map((gen) => (
                  <tr class="hover:bg-slate-50/50">
                    <td class="p-4 font-mono text-[11px] text-slate-500">
                      {new Date(gen.created_at).toLocaleTimeString()}
                    </td>
                    <td class="p-4 font-semibold text-slate-900">
                      {gen.provider} / <span class="font-mono text-slate-500">{gen.model}</span>
                    </td>
                    <td class="p-4">
                      <Badge variant={gen.status === 'completed' ? 'success' : 'danger'}>
                        {gen.status}
                      </Badge>
                    </td>
                    <td class="p-4 font-mono">{gen.total_tokens.toLocaleString()}</td>
                    <td class="p-4 font-mono">{gen.generation_time_ms}ms</td>
                    <td class="p-4 font-mono text-emerald-700">${gen.estimated_cost.toFixed(4)}</td>
                  </tr>
                ))
              )}
            </tbody>
          </table>
        </div>
      </Card>
    </div>
  </div>
</AdminLayout>

<script>
  // 1. Master AI Toggle Handler
  const masterToggleBtn = document.getElementById('master-ai-toggle-btn');
  masterToggleBtn?.addEventListener('click', async () => {
    const isCurrentlyActive = masterToggleBtn.getAttribute('data-active') === 'true';
    const newTarget = !isCurrentlyActive;
    const confirmMsg = newTarget
      ? 'Enable AI Interpretation Engine platform-wide?'
      : 'Disable AI Interpretation Engine platform-wide? No new AI reports will be generated.';

    if (!confirm(confirmMsg)) return;

    try {
      const res = await fetch('/api/admin/ai/toggle-master', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ isEnabled: newTarget })
      });
      const data = (await res.json()) as any;
      if (res.ok && data.success) {
        window.location.reload();
      } else {
        alert(data.error?.message || 'Failed to update Master AI status');
      }
    } catch {
      alert('Network error while updating master switch');
    }
  });

  // 2. Individual Provider Toggle Button Handler
  document.querySelectorAll('.provider-toggle-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const configId = (btn as HTMLElement).dataset.configId;
      const isCurrentlyEnabled = (btn as HTMLElement).dataset.enabled === 'true';
      const newEnabled = !isCurrentlyEnabled;

      if (!configId) return;

      try {
        const res = await fetch('/api/admin/ai/toggle-provider', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ configId, isEnabled: newEnabled })
        });
        const data = (await res.json()) as any;
        if (res.ok && data.success) {
          window.location.reload();
        } else {
          alert(data.error?.message || 'Failed to toggle provider');
        }
      } catch {
        alert('Network error while toggling provider');
      }
    });
  });

  // 3. Provider Configuration & API Key Save Form Handler
  document.querySelectorAll('.provider-config-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const configId = (form as HTMLElement).dataset.configId;
      if (!configId) return;

      const formData = new FormData(form as HTMLFormElement);
      const model = String(formData.get('model') || '');
      const creditCost = parseInt(String(formData.get('creditCost') || '5'), 10);
      const isEnabled = formData.get('isEnabled') === 'on';
      const apiKey = String(formData.get('apiKey') || '').trim();

      const payload: any = {
        configId,
        model,
        creditCost,
        isEnabled
      };
      if (apiKey) {
        payload.apiKey = apiKey;
      }

      try {
        const res = await fetch('/api/admin/ai/save-config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = (await res.json()) as any;
        if (res.ok && data.success) {
          alert('✓ Provider configuration & API key updated successfully!');
          window.location.reload();
        } else {
          alert(data.error?.message || 'Failed to save configuration');
        }
      } catch {
        alert('Network error while saving configuration');
      }
    });
  });

  // 4. API Key Show/Hide Password Visibility Toggle
  document.querySelectorAll('.toggle-pwd-visibility-btn').forEach((toggleBtn) => {
    toggleBtn.addEventListener('click', () => {
      const input = toggleBtn.parentElement?.querySelector('.api-key-input') as HTMLInputElement;
      if (!input) return;
      if (input.type === 'password') {
        input.type = 'text';
        toggleBtn.textContent = 'Hide';
      } else {
        input.type = 'password';
        toggleBtn.textContent = 'Show';
      }
    });
  });
</script>
