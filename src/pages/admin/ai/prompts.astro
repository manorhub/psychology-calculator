---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import { getD1Database } from '@/lib/db/client';
import { AIService } from '@/services/ai/ai.service';

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const aiService = new AIService(db, (env as any) || {});

const prompts = await aiService.getPrompts();
---

<AdminLayout title="AI Prompt Templates & Versioning">
  <div class="space-y-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">AI Prompt Management</h1>
        <p class="text-xs text-slate-500 mt-1">
          Admin-managed versioned prompt templates. Changes take effect on newly generated reports.
        </p>
      </div>
      <a
        href="/admin/ai"
        class="text-xs font-semibold text-teal-700 hover:text-teal-800"
      >
        ← Back to AI Dashboard
      </a>
    </div>

    <div class="space-y-6">
      {prompts.map((p) => (
        <Card class="p-6 sm:p-8 space-y-4">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <div class="flex items-center gap-2">
                <h2 class="text-base sm:text-lg font-bold text-slate-900">{p.name}</h2>
                <Badge variant={p.status === 'active' ? 'success' : 'default'}>
                  v{p.version} • {p.status}
                </Badge>
              </div>
              <span class="text-xs font-mono text-slate-400 mt-0.5 block">slug: {p.slug}</span>
            </div>
            <span class="text-[11px] text-slate-400 font-mono">
              Updated: {new Date(p.updated_at).toLocaleDateString()}
            </span>
          </div>

          <div class="space-y-2">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Prompt Template</span>
            <pre class="p-4 bg-slate-900 text-slate-100 rounded-2xl text-xs font-mono whitespace-pre-wrap leading-relaxed overflow-x-auto max-h-72">{p.prompt_template}</pre>
          </div>

          <div class="flex items-center justify-between text-xs text-slate-500 pt-2 border-t border-slate-100">
            <span>Template Variables: <code>&#123;&#123;assessment_name&#125;&#125;</code>, <code>&#123;&#123;primary_result_name&#125;&#125;</code>, <code>&#123;&#123;dimensions_summary&#125;&#125;</code>, <code>&#123;&#123;overall_score&#125;&#125;</code></span>
          </div>
        </Card>
      ))}
    </div>
  </div>
</AdminLayout>
