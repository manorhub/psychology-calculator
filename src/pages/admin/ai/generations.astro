---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import { getD1Database } from '@/lib/db/client';
import { AIService } from '@/services/ai/ai.service';

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const aiService = new AIService(db, (env as any) || {});

const generations = await aiService.getGenerations(50, 0);
---

<AdminLayout title="AI Generation History & Audit Log">
  <div class="space-y-8">
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">AI Generation Audit Log</h1>
        <p class="text-xs text-slate-500 mt-1">
          Historical record of all AI report synthesis attempts, latency, token consumption, and error categories.
        </p>
      </div>
      <a
        href="/admin/ai"
        class="text-xs font-semibold text-teal-700 hover:text-teal-800"
      >
        ← Back to AI Dashboard
      </a>
    </div>

    <Card class="p-0 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-600">
          <thead class="bg-slate-50 text-slate-700 font-bold border-b border-slate-200">
            <tr>
              <th class="p-4">Timestamp</th>
              <th class="p-4">Attempt ID</th>
              <th class="p-4">Provider / Model</th>
              <th class="p-4">Prompt</th>
              <th class="p-4">Status</th>
              <th class="p-4">Tokens</th>
              <th class="p-4">Latency</th>
              <th class="p-4">Est. Cost</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {generations.length === 0 ? (
              <tr>
                <td colspan="8" class="p-8 text-center text-slate-400">
                  No generation events recorded in database yet.
                </td>
              </tr>
            ) : (
              generations.map((gen) => (
                <tr class="hover:bg-slate-50/50">
                  <td class="p-4 font-mono text-[11px] text-slate-500">
                    {new Date(gen.created_at).toLocaleString()}
                  </td>
                  <td class="p-4 font-mono text-[11px] text-slate-500">
                    {gen.attempt_id.substring(0, 8)}...
                  </td>
                  <td class="p-4 font-semibold text-slate-900">
                    {gen.provider} / <span class="font-mono text-slate-500">{gen.model}</span>
                  </td>
                  <td class="p-4 font-mono text-[11px] text-slate-500">
                    {gen.prompt_slug} (v{gen.prompt_version})
                  </td>
                  <td class="p-4">
                    <Badge variant={gen.status === 'completed' ? 'success' : 'danger'}>
                      {gen.status}
                    </Badge>
                  </td>
                  <td class="p-4 font-mono">{gen.total_tokens.toLocaleString()}</td>
                  <td class="p-4 font-mono">{gen.generation_time_ms}ms</td>
                  <td class="p-4 font-mono text-emerald-700">${gen.estimated_cost.toFixed(4)}</td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </Card>
  </div>
</AdminLayout>
