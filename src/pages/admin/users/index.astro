---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Pagination from '@/components/admin/Pagination.astro';
import { getD1Database } from '@/lib/db/client';
import { AdminService } from '@/services/admin.service';

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const adminService = new AdminService(db);

const url = Astro.url;
const page = parseInt(url.searchParams.get('page') || '1', 10);
const limit = parseInt(url.searchParams.get('limit') || '10', 10);
const search = url.searchParams.get('q') || '';
const status = url.searchParams.get('status') || '';
const role = url.searchParams.get('role') || '';

const result = await adminService.getUsers({ page, limit, search, status, role });
---

<AdminLayout title="User Management" description="View and manage MindMetrics registered users">
  <div class="space-y-6">
    <!-- Page Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">User Directory</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Manage accounts, security status, and roles</p>
      </div>
    </div>

    <!-- Filters & Search Bar -->
    <Card class="p-4">
      <form method="GET" class="grid grid-cols-1 sm:grid-cols-4 gap-3">
        <div class="sm:col-span-2">
          <input
            type="text"
            name="q"
            value={search}
            placeholder="Search by email or name..."
            class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-teal-600"
          />
        </div>

        <div>
          <select
            name="status"
            class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-600"
          >
            <option value="">All Statuses</option>
            <option value="active" selected={status === 'active'}>Active</option>
            <option value="pending_verification" selected={status === 'pending_verification'}>Pending Verification</option>
            <option value="suspended" selected={status === 'suspended'}>Suspended</option>
          </select>
        </div>

        <div class="flex gap-2">
          <select
            name="role"
            class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-600"
          >
            <option value="">All Roles</option>
            <option value="user" selected={role === 'user'}>User</option>
            <option value="admin" selected={role === 'admin'}>Admin</option>
          </select>

          <Button type="submit" variant="primary" size="sm">
            Filter
          </Button>
        </div>
      </form>
    </Card>

    <!-- Users Table -->
    <Card class="p-0 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-slate-50/80 border-b border-slate-200 text-slate-500 font-semibold uppercase tracking-wider">
              <th class="py-3.5 px-4 sm:px-6">User</th>
              <th class="py-3.5 px-4">Role</th>
              <th class="py-3.5 px-4">Status</th>
              <th class="py-3.5 px-4">Credits</th>
              <th class="py-3.5 px-4">Verified</th>
              <th class="py-3.5 px-4">Joined Date</th>
              <th class="py-3.5 px-4">Last Login</th>
              <th class="py-3.5 px-4 text-right">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {result.items.length === 0 ? (
              <tr>
                <td colspan="8" class="p-8 text-center text-slate-500">
                  No users found matching the selected criteria.
                </td>
              </tr>
            ) : (
              result.items.map((user) => (
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="py-3.5 px-4 sm:px-6">
                    <div class="flex items-center gap-3">
                      <div class="w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-xs">
                        {user.displayName ? user.displayName.substring(0, 1).toUpperCase() : 'U'}
                      </div>
                      <div>
                        <div class="font-bold text-slate-900">{user.displayName || 'No Name'}</div>
                        <div class="text-[11px] text-slate-500 font-mono">{user.email}</div>
                      </div>
                    </div>
                  </td>
                  <td class="py-3.5 px-4">
                    <Badge variant={user.role === 'admin' ? 'info' : 'default'} size="sm">
                      {user.role.toUpperCase()}
                    </Badge>
                  </td>
                  <td class="py-3.5 px-4">
                    <Badge
                      variant={
                        user.status === 'active'
                          ? 'success'
                          : user.status === 'suspended'
                          ? 'danger'
                          : 'warning'
                      }
                      size="sm"
                    >
                      {user.status.replace('_', ' ').toUpperCase()}
                    </Badge>
                  </td>
                  <td class="py-3.5 px-4">
                    <div class="flex items-center gap-1.5">
                      <span class="font-mono font-bold text-teal-800 text-xs">{user.credits}</span>
                      <button
                        type="button"
                        class="quick-add-credits-btn px-2 py-0.5 rounded-md text-[10px] font-bold bg-teal-50 hover:bg-teal-100 text-teal-700 border border-teal-200 cursor-pointer transition-all"
                        data-user-id={user.id}
                        data-user-email={user.email}
                        title="Add credits to this user"
                      >
                        + Add
                      </button>
                    </div>
                  </td>
                  <td class="py-3.5 px-4">
                    {user.emailVerified ? (
                      <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                        ✓ Yes
                      </span>
                    ) : (
                      <button
                        type="button"
                        class="quick-verify-btn inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-800 hover:bg-emerald-50 hover:text-emerald-700 hover:border-emerald-300 border border-amber-200 transition-all cursor-pointer"
                        data-user-id={user.id}
                        title="Click to manually verify this user"
                      >
                        ⚡ Verify Now
                      </button>
                    )}
                  </td>
                  <td class="py-3.5 px-4 text-slate-600">
                    {new Date(user.createdAt).toLocaleDateString()}
                  </td>
                  <td class="py-3.5 px-4 text-slate-500">
                    {user.lastLoginAt ? new Date(user.lastLoginAt).toLocaleDateString() : 'Never'}
                  </td>
                  <td class="py-3.5 px-4 text-right">
                    <a
                      href={`/admin/users/${user.id}`}
                      class="inline-flex items-center px-2.5 py-1 text-xs font-semibold text-teal-700 hover:text-teal-800 hover:bg-teal-50 rounded-lg transition-colors"
                    >
                      View Details →
                    </a>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

      <Pagination
        currentPage={result.page}
        totalPages={result.totalPages}
        totalItems={result.total}
        limit={result.limit}
        baseUrl={url.toString()}
      />
    </Card>
  </div>
</AdminLayout>

<script>
  document.querySelectorAll('.quick-verify-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const userId = (btn as HTMLElement).dataset.userId;
      if (!userId || !confirm('Manually mark this user as verified? They will immediately be able to log in without clicking an email link.')) return;

      try {
        const res = await fetch('/api/admin/users/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId, isVerified: true })
        });
        const data = (await res.json()) as any;
        if (res.ok && data.success) {
          window.location.reload();
        } else {
          alert(data.error?.message || 'Verification failed');
        }
      } catch {
        alert('Network error during verification');
      }
    });
  });

  document.querySelectorAll('.quick-add-credits-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      e.preventDefault();
      const userId = (btn as HTMLElement).dataset.userId;
      const userEmail = (btn as HTMLElement).dataset.userEmail;
      if (!userId) return;

      const input = prompt(`Enter number of credits to add to ${userEmail} (e.g. 10, 50, 100):`, '10');
      if (!input) return;

      const amount = parseInt(input.trim(), 10);
      if (isNaN(amount) || amount === 0) {
        alert('Please enter a valid non-zero number of credits.');
        return;
      }

      try {
        const res = await fetch('/api/admin/users/credits', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId, amount, reason: 'Admin quick credit top-up' })
        });
        const data = (await res.json()) as any;
        if (res.ok && data.success) {
          alert(data.data?.message || 'Credits updated successfully!');
          window.location.reload();
        } else {
          alert(data.error?.message || 'Failed to update credits');
        }
      } catch {
        alert('Network error while updating credits');
      }
    });
  });
</script>
