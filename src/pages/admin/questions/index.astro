---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
---

<AdminLayout title="Questions & Options" description="Manage questions and Likert response scales">
  <div class="space-y-6">
    <div class="flex items-center justify-between pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">Question Item Bank</h1>
          <Badge variant="info" size="sm">Phase 4 Target</Badge>
        </div>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Configure psychometric items, response formats, and display orders</p>
      </div>
    </div>

    <Card class="p-8 text-center space-y-3">
      <div class="text-3xl">❓</div>
      <h3 class="text-lg font-bold text-slate-900">Dynamic Question Builder</h3>
      <p class="text-xs text-slate-500 max-w-md mx-auto">
        The interactive item bank editor, Likert scale customizer, and question ordering system will be implemented in <strong>Phase 4: Assessment Engine & Builder</strong>.
      </p>
    </Card>
  </div>
</AdminLayout>
