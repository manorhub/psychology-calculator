---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { getD1Database } from '@/lib/db/client';
import { AnalyticsService } from '@/services/analytics/analytics.service';
import type { AnalyticsRange } from '@/types/database';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const analyticsService = new AnalyticsService(db);

const url = new URL(Astro.request.url);
const range = (url.searchParams.get('range') as AnalyticsRange) || '30d';

const metrics = await analyticsService.getOverviewMetrics(range);

const ranges: { key: AnalyticsRange; label: string }[] = [
  { key: 'today', label: 'Today' },
  { key: '7d', label: 'Last 7 Days' },
  { key: '30d', label: 'Last 30 Days' },
  { key: '90d', label: 'Last 90 Days' },
  { key: 'this_year', label: 'This Year' },
  { key: 'all', label: 'All Time' }
];
---

<AdminLayout title="Analytics & Business Intelligence">
  <div class="space-y-8 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <a href="/admin" class="text-xs font-semibold text-indigo-600 hover:underline">Admin</a>
          <span class="text-xs text-slate-400">/</span>
          <span class="text-xs font-semibold text-slate-600">Analytics</span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">
          Business Intelligence & Analytics
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Live, zero-fabrication metrics across users, assessment funnels, AI synthesis, and subscriptions.
        </p>
      </div>

      <!-- Date Range Selector -->
      <div class="flex items-center gap-2 flex-wrap">
        {ranges.map((r) => (
          <a
            href={`/admin/analytics?range=${r.key}`}
            class={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all ${
              range === r.key
                ? 'bg-indigo-600 text-white shadow-xs'
                : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50'
            }`}
          >
            {r.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Sub Navigation Tabs -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 border-b border-slate-100">
      <a href={`/admin/analytics?range=${range}`} class="px-3.5 py-2 rounded-lg text-xs font-bold bg-indigo-50 text-indigo-700">
        📊 Overview
      </a>
      <a href={`/admin/analytics/users?range=${range}`} class="px-3.5 py-2 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100">
        👥 Users & Funnel
      </a>
      <a href={`/admin/analytics/assessments?range=${range}`} class="px-3.5 py-2 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100">
        📝 Assessments
      </a>
      <a href={`/admin/analytics/ai?range=${range}`} class="px-3.5 py-2 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100">
        ✨ AI Usage & Cost
      </a>
      <a href={`/admin/analytics/revenue?range=${range}`} class="px-3.5 py-2 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100">
        💳 Revenue & Plans
      </a>
      <a href={`/admin/analytics/content?range=${range}`} class="px-3.5 py-2 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100">
        📄 Content & CTAs
      </a>
      <a href={`/admin/analytics/system?range=${range}`} class="px-3.5 py-2 rounded-lg text-xs font-semibold text-slate-600 hover:bg-slate-100">
        🛡️ System Health
      </a>
    </div>

    <!-- KPI Metric Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      <!-- Total Users -->
      <Card class="p-5 border-slate-200 bg-white shadow-xs space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Total Users</span>
          <span class="text-lg">👥</span>
        </div>
        <div class="text-2xl font-black text-slate-900 font-mono">
          {metrics.totalUsers}
        </div>
        <div class="text-xs text-slate-500 flex items-center gap-1">
          <span class="font-bold text-teal-600">+{metrics.newUsers}</span> in selected period
        </div>
      </Card>

      <!-- Assessment Starts & Rate -->
      <Card class="p-5 border-slate-200 bg-white shadow-xs space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Assessment Starts</span>
          <span class="text-lg">📝</span>
        </div>
        <div class="text-2xl font-black text-slate-900 font-mono">
          {metrics.assessmentStarts}
        </div>
        <div class="text-xs text-slate-500 flex items-center gap-1">
          <span class="font-bold text-indigo-600">{metrics.completionRate}%</span> completion rate ({metrics.assessmentCompletions} finished)
        </div>
      </Card>

      <!-- AI Reports & Cost -->
      <Card class="p-5 border-slate-200 bg-white shadow-xs space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">AI Reports Synthesized</span>
          <span class="text-lg">✨</span>
        </div>
        <div class="text-2xl font-black text-slate-900 font-mono">
          {metrics.aiReportsGenerated}
        </div>
        <div class="text-xs text-slate-500 flex items-center gap-1">
          Est. Cost: <span class="font-bold text-slate-700 font-mono">${metrics.estimatedAiCost}</span> ({metrics.aiSuccessRate}% success)
        </div>
      </Card>

      <!-- Revenue & Subscriptions -->
      <Card class="p-5 border-slate-200 bg-white shadow-xs space-y-2">
        <div class="flex items-center justify-between">
          <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Gross Revenue</span>
          <span class="text-lg">💳</span>
        </div>
        <div class="text-2xl font-black text-emerald-700 font-mono">
          ${metrics.grossRevenue.toFixed(2)}
        </div>
        <div class="text-xs text-slate-500 flex items-center gap-1">
          <span class="font-bold text-indigo-600">{metrics.activeSubscriptions}</span> active Pro subscriptions
        </div>
      </Card>
    </div>

    <!-- Quick Export Actions & External Integrations -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
      <!-- Left: Data Export Center -->
      <Card class="lg:col-span-7 p-6 border-slate-200 bg-white space-y-4 shadow-xs">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <div>
            <h3 class="text-sm font-bold text-slate-900">Download Analytical CSV Exports</h3>
            <p class="text-xs text-slate-500">Generate clean CSV reports for selected period ({range})</p>
          </div>
          <span class="text-xs font-bold text-indigo-600 font-mono">RFC 4180</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
          <a
            href={`/api/v1/admin/analytics/export?type=assessments&range=${range}`}
            class="p-3 bg-slate-50 hover:bg-indigo-50 border border-slate-200 hover:border-indigo-200 rounded-xl flex items-center justify-between text-xs font-bold text-slate-700 hover:text-indigo-700 transition-colors"
          >
            <span>📝 Assessment Analytics</span>
            <span>⬇️</span>
          </a>
          <a
            href={`/api/v1/admin/analytics/export?type=revenue&range=${range}`}
            class="p-3 bg-slate-50 hover:bg-indigo-50 border border-slate-200 hover:border-indigo-200 rounded-xl flex items-center justify-between text-xs font-bold text-slate-700 hover:text-indigo-700 transition-colors"
          >
            <span>💳 Revenue & Plans</span>
            <span>⬇️</span>
          </a>
          <a
            href={`/api/v1/admin/analytics/export?type=ai&range=${range}`}
            class="p-3 bg-slate-50 hover:bg-indigo-50 border border-slate-200 hover:border-indigo-200 rounded-xl flex items-center justify-between text-xs font-bold text-slate-700 hover:text-indigo-700 transition-colors"
          >
            <span>✨ AI Costs & Tokens</span>
            <span>⬇️</span>
          </a>
          <a
            href={`/api/v1/admin/analytics/export?type=content&range=${range}`}
            class="p-3 bg-slate-50 hover:bg-indigo-50 border border-slate-200 hover:border-indigo-200 rounded-xl flex items-center justify-between text-xs font-bold text-slate-700 hover:text-indigo-700 transition-colors"
          >
            <span>📄 Content & CTAs</span>
            <span>⬇️</span>
          </a>
        </div>
      </Card>

      <!-- Right: External Analytics Connectors Status -->
      <Card class="lg:col-span-5 p-6 border-slate-200 bg-white space-y-4 shadow-xs">
        <div class="border-b border-slate-100 pb-3">
          <h3 class="text-sm font-bold text-slate-900">External Integrations</h3>
          <p class="text-xs text-slate-500">Real-time status of traffic & search connectors</p>
        </div>

        <div class="space-y-3">
          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200">
            <div class="flex items-center gap-2.5">
              <span class="text-base">📈</span>
              <div>
                <div class="text-xs font-bold text-slate-900">Google Analytics 4</div>
                <div class="text-[11px] text-slate-500">Client Acquisition & Tagging</div>
              </div>
            </div>
            <Badge variant="success" size="sm">Active (Client Tagged)</Badge>
          </div>

          <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 border border-slate-200">
            <div class="flex items-center gap-2.5">
              <span class="text-base">🔍</span>
              <div>
                <div class="text-xs font-bold text-slate-900">Google Search Console</div>
                <div class="text-[11px] text-slate-500">Domain Verification & Sitemap</div>
              </div>
            </div>
            <Badge variant="default" size="sm">Sitemap Connected</Badge>
          </div>
        </div>
      </Card>
    </div>
  </div>
</AdminLayout>
