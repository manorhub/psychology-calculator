---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import { getD1Database } from '@/lib/db/client';
import { AnalyticsService } from '@/services/analytics/analytics.service';
import type { AnalyticsRange } from '@/types/database';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const analyticsService = new AnalyticsService(db);

const url = new URL(Astro.request.url);
const range = (url.searchParams.get('range') as AnalyticsRange) || '30d';
const selectedAssessmentId = url.searchParams.get('assessment_id') || undefined;

const data = await analyticsService.getAssessmentAnalytics(range, selectedAssessmentId);

const ranges: { key: AnalyticsRange; label: string }[] = [
  { key: 'today', label: 'Today' },
  { key: '7d', label: 'Last 7 Days' },
  { key: '30d', label: 'Last 30 Days' },
  { key: '90d', label: 'Last 90 Days' },
  { key: 'this_year', label: 'This Year' },
  { key: 'all', label: 'All Time' }
];
---

<AdminLayout title="Assessment Analytics & Drop-off">
  <div class="space-y-8 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <a href="/admin/analytics" class="text-xs font-semibold text-indigo-600 hover:underline">Analytics</a>
          <span class="text-xs text-slate-400">/</span>
          <span class="text-xs font-semibold text-slate-600">Assessments</span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Assessment Performance & Drop-off</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Evaluate completion bottlenecks, question drop-off friction, and AI report conversion rates.
        </p>
      </div>

      <!-- Date Range Selector -->
      <div class="flex items-center gap-2 flex-wrap">
        {ranges.map((r) => (
          <a
            href={`/admin/analytics/assessments?range=${r.key}${selectedAssessmentId ? `&assessment_id=${selectedAssessmentId}` : ''}`}
            class={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all ${
              range === r.key
                ? 'bg-indigo-600 text-white shadow-xs'
                : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50'
            }`}
          >
            {r.label}
          </a>
        ))}
      </div>
    </div>

    <!-- Assessment Performance Ranking Table -->
    <Card class="border-slate-200 bg-white overflow-hidden shadow-xs">
      <div class="p-4 border-b border-slate-100 flex items-center justify-between">
        <div>
          <h3 class="text-sm font-bold text-slate-900">Psychometric Instruments Ranking</h3>
          <p class="text-xs text-slate-500">Sorted by completed evaluations in selected period</p>
        </div>
        <a
          href={`/api/v1/admin/analytics/export?type=assessments&range=${range}`}
          class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-bold transition-colors"
        >
          ⬇️ Export CSV
        </a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 text-slate-500 font-bold uppercase border-b border-slate-100">
            <tr>
              <th class="p-3.5">Instrument Name</th>
              <th class="p-3.5">Category</th>
              <th class="p-3.5">Starts</th>
              <th class="p-3.5">Completions</th>
              <th class="p-3.5">Completion Rate</th>
              <th class="p-3.5">AI Reports</th>
              <th class="p-3.5">Avg Duration</th>
              <th class="p-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700">
            {data.items.map((item) => (
              <tr class={`hover:bg-slate-50/60 transition-colors ${selectedAssessmentId === item.id ? 'bg-indigo-50/40' : ''}`}>
                <td class="p-3.5 font-bold text-slate-900">
                  {item.name}
                  <div class="font-mono text-[10px] text-slate-400">/{item.slug}</div>
                </td>
                <td class="p-3.5">
                  <Badge variant="default" size="sm">
                    {item.categoryName}
                  </Badge>
                </td>
                <td class="p-3.5 font-mono font-semibold">{item.starts}</td>
                <td class="p-3.5 font-mono font-bold text-indigo-600">{item.completions}</td>
                <td class="p-3.5 font-mono">
                  <span class={`font-bold ${item.completionRate >= 70 ? 'text-teal-600' : item.completionRate >= 40 ? 'text-amber-600' : 'text-slate-600'}`}>
                    {item.completionRate}%
                  </span>
                </td>
                <td class="p-3.5 font-mono">{item.aiReports} ({item.aiConversionRate}%)</td>
                <td class="p-3.5 font-mono text-slate-500">{item.avgDurationMinutes} mins</td>
                <td class="p-3.5 text-right">
                  <a
                    href={`/admin/analytics/assessments?range=${range}&assessment_id=${item.id}`}
                    class="px-2.5 py-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 rounded-lg font-bold text-xs transition-colors inline-block"
                  >
                    Drop-off →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Card>

    <!-- Question Drop-Off Heatmap (if assessment selected) -->
    {selectedAssessmentId && data.dropOff && data.dropOff.length > 0 && (
      <Card class="p-6 border-indigo-200 bg-white shadow-sm space-y-4">
        <div class="border-b border-slate-100 pb-3 flex items-center justify-between">
          <div>
            <h3 class="text-sm font-bold text-slate-900">Question Drop-Off Analysis</h3>
            <p class="text-xs text-slate-500">Identify specific questions causing participant drop-off</p>
          </div>
          <a
            href={`/admin/analytics/assessments?range=${range}`}
            class="text-xs font-bold text-slate-500 hover:underline"
          >
            ✕ Clear Selection
          </a>
        </div>

        <div class="space-y-3">
          {data.dropOff.map((q) => (
            <div class="p-3 bg-slate-50 rounded-xl border border-slate-100 flex items-center justify-between gap-4 text-xs">
              <div class="flex items-center gap-3">
                <span class="w-6 h-6 rounded-lg bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center text-xs">
                  {q.questionNumber}
                </span>
                <span class="font-medium text-slate-800">{q.questionText}</span>
              </div>
              <div class="flex items-center gap-4 shrink-0">
                <span class="font-mono text-slate-500">{q.answersCount} answered</span>
                <Badge variant={q.dropOffRate > 25 ? 'danger' : q.dropOffRate > 10 ? 'warning' : 'success'} size="sm">
                  {q.dropOffRate}% drop-off
                </Badge>
              </div>
            </div>
          ))}
        </div>
      </Card>
    )}
  </div>
</AdminLayout>
