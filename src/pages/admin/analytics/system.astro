---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import { getD1Database } from '@/lib/db/client';
import { AnalyticsService } from '@/services/analytics/analytics.service';
import type { AnalyticsRange } from '@/types/database';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const analyticsService = new AnalyticsService(db);

const url = new URL(Astro.request.url);
const range = (url.searchParams.get('range') as AnalyticsRange) || '30d';

const data = await analyticsService.getSystemHealth(range);

const ranges: { key: AnalyticsRange; label: string }[] = [
  { key: 'today', label: 'Today' },
  { key: '7d', label: 'Last 7 Days' },
  { key: '30d', label: 'Last 30 Days' },
  { key: '90d', label: 'Last 90 Days' },
  { key: 'this_year', label: 'This Year' },
  { key: 'all', label: 'All Time' }
];
---

<AdminLayout title="System Health & Operational Failures">
  <div class="space-y-8 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <a href="/admin/analytics" class="text-xs font-semibold text-indigo-600 hover:underline">Analytics</a>
          <span class="text-xs text-slate-400">/</span>
          <span class="text-xs font-semibold text-slate-600">System Health</span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Operational Health & Failure Monitor</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Monitor transactional email reliability, AI synthesis failures, and webhook execution logs.
        </p>
      </div>

      <!-- Date Range Selector -->
      <div class="flex items-center gap-2 flex-wrap">
        {ranges.map((r) => (
          <a
            href={`/admin/analytics/system?range=${r.key}`}
            class={`px-3 py-1.5 rounded-xl text-xs font-bold transition-all ${
              range === r.key
                ? 'bg-indigo-600 text-white shadow-xs'
                : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-50'
            }`}
          >
            {r.label}
          </a>
        ))}
      </div>
    </div>

    <!-- KPI Summary Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      <Card class="p-5 border-slate-200 bg-white shadow-xs space-y-1">
        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Email Delivery Rate</span>
        <div class="text-2xl font-black text-slate-900 font-mono">{data.emailDeliveryRate}%</div>
        <span class="text-xs text-slate-500 font-semibold">{data.failedEmailsCount} failed jobs</span>
      </Card>

      <Card class="p-5 border-slate-200 bg-white shadow-xs space-y-1">
        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">AI Generation Errors</span>
        <div class="text-2xl font-black text-slate-900 font-mono">{data.failedAiGenerationsCount}</div>
        <span class="text-xs text-slate-500 font-semibold">Failed synthesis attempts</span>
      </Card>

      <Card class="p-5 border-slate-200 bg-white shadow-xs space-y-1">
        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Webhook Failures</span>
        <div class="text-2xl font-black text-slate-900 font-mono">{data.webhookFailuresCount}</div>
        <span class="text-xs text-slate-500 font-semibold">Payment / billing events</span>
      </Card>

      <Card class="p-5 border-slate-200 bg-white shadow-xs space-y-1">
        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">System Status</span>
        <div class="text-2xl font-black text-teal-700">Healthy</div>
        <span class="text-xs text-slate-500 font-semibold">Cloudflare Workers runtime</span>
      </Card>
    </div>

    <!-- Operational Error Log Table -->
    <Card class="p-6 border-slate-200 bg-white shadow-xs space-y-4">
      <div class="border-b border-slate-100 pb-3">
        <h3 class="text-sm font-bold text-slate-900">Recent Operational Events & Failures</h3>
        <p class="text-xs text-slate-500">Live operational ledger for debugging system anomalies</p>
      </div>

      {data.recentErrors.length === 0 ? (
        <div class="p-8 text-center text-slate-400 text-xs">
          No system failures or error records logged in this period.
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-500 font-bold uppercase border-b border-slate-100">
              <tr>
                <th class="p-3">Service</th>
                <th class="p-3">Action</th>
                <th class="p-3">Details</th>
                <th class="p-3 text-right">Timestamp</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
              {data.recentErrors.map((err) => (
                <tr>
                  <td class="p-3 font-bold text-slate-900">{err.service}</td>
                  <td class="p-3 font-mono">{err.action}</td>
                  <td class="p-3 text-slate-600 font-mono text-[11px] max-w-xs truncate">{err.error}</td>
                  <td class="p-3 text-right font-mono text-slate-400">{err.timestamp}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </Card>
  </div>
</AdminLayout>
