---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Input from '@/components/ui/Input.astro';
import { RedirectService } from '@/services/seo/redirect.service';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = env?.DB || null;

const redirectService = new RedirectService(db);
const redirects = await redirectService.getAllRedirects();
---

<AdminLayout title="URL Redirects Manager — Admin Control">
  <div class="space-y-8 max-w-6xl">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          URL Redirects & Canonical Routing
        </h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Manage 301 permanent and 302 temporary redirects with automatic circular loop protection
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/settings/seo"
          class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold rounded-xl transition-all"
        >
          ⚙️ Global SEO Settings
        </a>
      </div>
    </div>

    <!-- Status Message -->
    <div id="red-msg" class="hidden p-4 rounded-xl text-xs font-semibold"></div>

    <!-- Add Redirect Form -->
    <Card class="p-6 sm:p-8 space-y-6">
      <div class="border-b border-slate-100 pb-3">
        <h2 class="text-sm font-bold uppercase tracking-wider text-slate-400">
          Create New Redirect Rule
        </h2>
      </div>

      <form id="create-redirect-form" class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-end">
        <Input
          id="oldPath"
          name="oldPath"
          label="Source URL Path (Old)"
          placeholder="/old-assessment-path"
          required
        />

        <Input
          id="newPath"
          name="newPath"
          label="Destination URL Path (New)"
          placeholder="/assessments/new-path"
          required
        />

        <div class="space-y-1.5">
          <label for="statusCode" class="text-xs font-semibold text-slate-700">HTTP Status Code</label>
          <div class="flex gap-2">
            <select
              id="statusCode"
              name="statusCode"
              class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-900 focus:bg-white focus:outline-none focus:ring-2 focus:ring-indigo-500"
            >
              <option value="301">301 - Permanent Move</option>
              <option value="302">302 - Temporary Redirect</option>
            </select>
            <Button type="submit" variant="primary" id="create-btn" class="shrink-0">
              Add Redirect
            </Button>
          </div>
        </div>
      </form>
    </Card>

    <!-- Redirects Ledger Table -->
    <Card class="overflow-hidden border-slate-200">
      <div class="p-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
        <h2 class="text-xs font-bold uppercase tracking-wider text-slate-700">Configured Redirects ({redirects.length})</h2>
      </div>

      {redirects.length === 0 ? (
        <div class="p-12 text-center text-slate-400 text-xs">
          No URL redirect rules configured.
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs text-slate-600">
            <thead class="bg-slate-50/50 text-[10px] uppercase font-bold text-slate-400 border-b border-slate-200">
              <tr>
                <th class="px-4 py-3">Source Path (Old)</th>
                <th class="px-4 py-3">Destination Path (New)</th>
                <th class="px-4 py-3">Type</th>
                <th class="px-4 py-3">Hits</th>
                <th class="px-4 py-3">Created</th>
                <th class="px-4 py-3 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {redirects.map((r) => (
                <tr class="hover:bg-slate-50/60 transition-colors">
                  <td class="px-4 py-3 font-mono font-bold text-rose-700 text-[11px]">
                    {r.old_path}
                  </td>
                  <td class="px-4 py-3 font-mono font-bold text-emerald-700 text-[11px]">
                    {r.new_path}
                  </td>
                  <td class="px-4 py-3">
                    <Badge variant={r.status_code === 301 ? 'success' : 'info'} size="sm">
                      {r.status_code}
                    </Badge>
                  </td>
                  <td class="px-4 py-3 font-mono text-[11px] text-slate-500">
                    {r.hit_count} hits
                  </td>
                  <td class="px-4 py-3 text-slate-400 text-[10px]">
                    {new Date(r.created_at).toLocaleDateString()}
                  </td>
                  <td class="px-4 py-3 text-right">
                    <button
                      type="button"
                      data-delete-id={r.id}
                      class="delete-btn text-rose-600 hover:text-rose-800 font-bold text-xs cursor-pointer"
                    >
                      Delete
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </Card>
  </div>

  <script is:inline>
    const form = document.getElementById('create-redirect-form') as HTMLFormElement;
    const msg = document.getElementById('red-msg') as HTMLDivElement;

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      msg.className = 'hidden';

      const formData = new FormData(form);
      const payload = {
        oldPath: formData.get('oldPath') as string,
        newPath: formData.get('newPath') as string,
        statusCode: Number(formData.get('statusCode') || 301)
      };

      try {
        const res = await fetch('/api/v1/admin/redirects', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = (await res.json()) as any;
        if (!res.ok) throw new Error(data.error?.message || 'Failed to create redirect');

        msg.textContent = '✓ Redirect rule created successfully!';
        msg.className = 'p-4 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200 block';

        setTimeout(() => window.location.reload(), 1000);
      } catch (err: any) {
        msg.textContent = `❌ ${err.message || 'Error creating redirect'}`;
        msg.className = 'p-4 rounded-xl text-xs font-semibold bg-rose-50 text-rose-800 border border-rose-200 block';
      }
    });

    document.querySelectorAll('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const id = target.getAttribute('data-delete-id');
        if (!id || !confirm('Are you sure you want to delete this redirect rule?')) return;

        try {
          const res = await fetch('/api/v1/admin/redirects', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
          });

          const data = (await res.json()) as any;
          if (!res.ok) throw new Error(data.error?.message || 'Failed to delete redirect');

          window.location.reload();
        } catch (err: any) {
          alert(`Error: ${err.message}`);
        }
      });
    });
  </script>
</AdminLayout>
