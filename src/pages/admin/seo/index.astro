---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
---

<AdminLayout title="SEO & OpenGraph" description="Manage dynamic search engine optimization and social metadata">
  <div class="space-y-6">
    <div class="flex items-center justify-between pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">SEO Metadata & Social Graph</h1>
          <Badge variant="info" size="sm">Phase 7 Target</Badge>
        </div>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Configure global canonical links, meta tags, and OpenGraph social preview images</p>
      </div>
    </div>

    <Card class="p-8 text-center space-y-3">
      <div class="text-3xl">🔍</div>
      <h3 class="text-lg font-bold text-slate-900">SEO Control Center</h3>
      <p class="text-xs text-slate-500 max-w-md mx-auto">
        Global and entity-level meta descriptions, robots directives, structured JSON-LD schemas, and OpenGraph images will be fully managed in <strong>Phase 7: CMS & SEO Engine</strong>.
      </p>
    </Card>
  </div>
</AdminLayout>
