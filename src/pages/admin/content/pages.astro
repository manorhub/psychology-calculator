---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { CmsService } from '@/services/content/cms.service';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = env?.DB || null;

const cmsService = new CmsService(db);
const pages = await cmsService.getAllPagesAdmin();
---

<AdminLayout title="Static CMS Pages">
  <div class="space-y-6 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <a href="/admin/content" class="text-xs font-semibold text-indigo-600 hover:underline">CMS</a>
          <span class="text-xs text-slate-400">/</span>
          <span class="text-xs font-semibold text-slate-600">Pages</span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Static CMS Pages</h1>
      </div>

      <button
        onclick="openNewPageModal()"
        class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl transition-colors shadow-sm inline-flex items-center gap-1.5"
      >
        ➕ Create New Page
      </button>
    </div>

    <!-- Pages Table -->
    <Card class="border-slate-200 bg-white overflow-hidden shadow-sm">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 text-slate-500 font-bold uppercase border-b border-slate-100">
            <tr>
              <th class="p-3.5">Page Title</th>
              <th class="p-3.5">Slug / URL</th>
              <th class="p-3.5">Status</th>
              <th class="p-3.5">SEO Title</th>
              <th class="p-3.5">Updated</th>
              <th class="p-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700">
            {pages.map((p) => (
              <tr class="hover:bg-slate-50/60 transition-colors">
                <td class="p-3.5 font-bold text-slate-900">{p.title}</td>
                <td class="p-3.5 font-mono text-slate-500">/p/{p.slug}</td>
                <td class="p-3.5">
                  <Badge variant={p.status === 'published' ? 'success' : 'default'} size="sm">
                    {p.status}
                  </Badge>
                </td>
                <td class="p-3.5 text-slate-500 max-w-xs truncate">{p.seo_title || 'Default'}</td>
                <td class="p-3.5 text-slate-400 font-mono">
                  {p.updated_at ? new Date(p.updated_at).toLocaleDateString() : '—'}
                </td>
                <td class="p-3.5 text-right space-x-3">
                  <a href={`/p/${p.slug}`} target="_blank" class="text-indigo-600 hover:underline font-bold">
                    View
                  </a>
                  <button
                    onclick={`editPage(${JSON.stringify(p).replace(/"/g, '&quot;')})`}
                    class="text-slate-600 hover:underline font-bold"
                  >
                    Edit
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Card>

    <!-- Page Editor Modal -->
    <div id="page-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl max-w-2xl w-full p-6 space-y-4 shadow-2xl border border-slate-200 max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 id="modal-title" class="text-base font-bold text-slate-900">Edit Static Page</h3>
          <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 text-lg">✕</button>
        </div>

        <form id="page-form" class="space-y-4">
          <input type="hidden" id="page-id" name="id" />

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Title</label>
            <input type="text" id="page-title" name="title" required class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs" />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Slug</label>
            <input type="text" id="page-slug" name="slug" required class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono" />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Content (Markdown / Safe HTML)</label>
            <textarea id="page-content" name="content" rows="8" required class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono"></textarea>
          </div>

          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">SEO Title Override</label>
              <input type="text" id="page-seo-title" name="seo_title" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs" />
            </div>
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Status</label>
              <select id="page-status" name="status" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs">
                <option value="published">Published</option>
                <option value="draft">Draft</option>
              </select>
            </div>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-2">
            <button type="button" onclick="closeModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl">
              Cancel
            </button>
            <Button type="submit" variant="primary" size="md">
              Save Page
            </Button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    const modal = document.getElementById('page-modal');
    const form = document.getElementById('page-form');

    function openNewPageModal() {
      document.getElementById('modal-title').textContent = 'Create Static Page';
      form.reset();
      document.getElementById('page-id').value = '';
      modal.classList.remove('hidden');
    }

    function editPage(page) {
      document.getElementById('modal-title').textContent = `Edit Page: ${page.title}`;
      document.getElementById('page-id').value = page.id;
      document.getElementById('page-title').value = page.title;
      document.getElementById('page-slug').value = page.slug;
      document.getElementById('page-content').value = page.content;
      document.getElementById('page-seo-title').value = page.seo_title || '';
      document.getElementById('page-status').value = page.status;
      modal.classList.remove('hidden');
    }

    function closeModal() {
      modal.classList.add('hidden');
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        try {
          const res = await fetch('/api/v1/admin/content', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ entity: 'page', data: payload })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            window.location.reload();
          } else {
            alert(data.message || 'Failed to save page');
          }
        } catch {
          alert('Network error saving page');
        }
      });
    }
  </script>
</AdminLayout>
