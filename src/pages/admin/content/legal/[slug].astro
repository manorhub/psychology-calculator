---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import { getD1Database } from '@/lib/db/client';
import { SettingsService } from '@/services/settings/settings.service';

export const prerender = false;

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/admin/content/legal');

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const settingsService = new SettingsService(db);

const page = await settingsService.getLegalPageBySlug(slug);
if (!page) return Astro.redirect('/admin/content/legal');
---

<AdminLayout title={`Edit ${page.title}`}>
  <div class="space-y-8 max-w-4xl mx-auto">
    <!-- Header -->
    <div class="flex items-center justify-between pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <a href="/admin/content/legal" class="text-xs font-semibold text-indigo-600 hover:underline">Legal Pages</a>
          <span class="text-xs text-slate-400">/</span>
          <span class="text-xs font-semibold text-slate-600">{page.slug}</span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Edit {page.title}</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Update the markdown content for <code>/{page.slug}</code>.
        </p>
      </div>

      <div class="flex items-center gap-2">
        <a
          href={`/legal/${page.slug}`}
          target="_blank"
          class="px-3.5 py-2 rounded-xl text-xs font-bold bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 shadow-2xs"
        >
          View Public Page ↗
        </a>
      </div>
    </div>

    <!-- Editor Form -->
    <form id="legal-form" class="space-y-6">
      <input type="hidden" name="slug" value={page.slug} />

      <Card class="p-6 border-slate-200 bg-white shadow-xs space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700">Document Title</label>
            <input
              type="text"
              name="title"
              value={page.title}
              class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 font-semibold"
            />
          </div>

          <div class="space-y-1.5">
            <label class="text-xs font-bold text-slate-700">Publication Status</label>
            <select
              name="is_published"
              class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-indigo-500 font-semibold"
            >
              <option value="1" selected={page.is_published === 1}>Published (Publicly Accessible)</option>
              <option value="0" selected={page.is_published === 0}>Draft (Hidden from Public)</option>
            </select>
          </div>
        </div>

        <div class="space-y-1.5 pt-2">
          <label class="text-xs font-bold text-slate-700">Markdown Content</label>
          <textarea
            name="content_markdown"
            rows="16"
            class="w-full px-3.5 py-2 border border-slate-300 rounded-xl text-xs font-mono focus:ring-2 focus:ring-indigo-500 leading-relaxed"
          >{page.content_markdown}</textarea>
        </div>
      </Card>

      <div class="flex items-center justify-end gap-3 pt-2">
        <button
          type="submit"
          class="px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-bold transition-all shadow-xs"
        >
          Save Legal Document
        </button>
      </div>
    </form>
  </div>

  <script is:inline>
    const form = document.getElementById('legal-form');
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const payload = {
        slug: formData.get('slug'),
        title: formData.get('title'),
        content_markdown: formData.get('content_markdown'),
        is_published: formData.get('is_published') === '1'
      };

      try {
        const res = await fetch('/api/v1/admin/content/legal/save', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const json = await res.json();
        if (json.success) {
          alert('Legal document saved successfully!');
        } else {
          alert('Failed to save document: ' + (json.error?.message || 'Error'));
        }
      } catch (err) {
        alert('Network error: ' + err.message);
      }
    });
  </script>
</AdminLayout>
