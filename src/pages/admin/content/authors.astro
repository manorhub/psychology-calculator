---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { CmsService } from '@/services/content/cms.service';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = env?.DB || null;

const cmsService = new CmsService(db);
const authors = await cmsService.getAuthors();
---

<AdminLayout title="Blog Authors">
  <div class="space-y-6 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2">
          <a href="/admin/content" class="text-xs font-semibold text-indigo-600 hover:underline">CMS</a>
          <span class="text-xs text-slate-400">/</span>
          <span class="text-xs font-semibold text-slate-600">Authors</span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Authors & Contributors</h1>
      </div>

      <button
        onclick="openNewAuthorModal()"
        class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl transition-colors shadow-sm inline-flex items-center gap-1.5"
      >
        ➕ Add Author
      </button>
    </div>

    <!-- Authors Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {authors.map((a) => (
        <Card class="p-6 border-slate-200 bg-white shadow-sm flex flex-col justify-between">
          <div class="space-y-4">
            <div class="flex items-start justify-between gap-3">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center text-sm">
                  {a.name.charAt(0)}
                </div>
                <div>
                  <h3 class="text-sm font-bold text-slate-900">{a.name}</h3>
                  <div class="text-[11px] text-slate-500 font-medium">{a.role_title || 'Researcher'}</div>
                </div>
              </div>
              <Badge variant={a.status === 'active' ? 'success' : 'slate'} size="sm">
                {a.status}
              </Badge>
            </div>

            {a.bio && (
              <p class="text-xs text-slate-600 line-clamp-3 leading-relaxed">
                {a.bio}
              </p>
            )}
          </div>

          <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between">
            <span class="text-[11px] font-mono text-slate-400">slug: {a.slug}</span>
            <button
              onclick={`editAuthor(${JSON.stringify(a).replace(/"/g, '&quot;')})`}
              class="text-xs font-bold text-indigo-600 hover:text-indigo-800"
            >
              Edit Profile →
            </button>
          </div>
        </Card>
      ))}
    </div>

    <!-- Author Modal -->
    <div id="author-modal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4">
      <div class="bg-white rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl border border-slate-200">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <h3 id="modal-title" class="text-base font-bold text-slate-900">Edit Author Profile</h3>
          <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600 text-lg">✕</button>
        </div>

        <form id="author-form" class="space-y-4">
          <input type="hidden" id="author-id" name="id" />

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Name</label>
            <input type="text" id="author-name" name="name" required class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs" />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Role / Title</label>
            <input type="text" id="author-role" name="role_title" placeholder="e.g. Cognitive Psychologist & Researcher" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs" />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Bio</label>
            <textarea id="author-bio" name="bio" rows="3" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs"></textarea>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Avatar Image URL</label>
            <input type="text" id="author-avatar" name="avatar_url" placeholder="/images/authors/avatar.png" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono" />
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Status</label>
            <select id="author-status" name="status" class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs">
              <option value="active">Active</option>
              <option value="inactive">Inactive</option>
            </select>
          </div>

          <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-2">
            <button type="button" onclick="closeModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl">
              Cancel
            </button>
            <Button type="submit" variant="primary" size="md">
              Save Author
            </Button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script is:inline>
    const modal = document.getElementById('author-modal');
    const form = document.getElementById('author-form');

    function openNewAuthorModal() {
      document.getElementById('modal-title').textContent = 'Create Author Profile';
      form.reset();
      document.getElementById('author-id').value = '';
      modal.classList.remove('hidden');
    }

    function editAuthor(a) {
      document.getElementById('modal-title').textContent = `Edit Profile: ${a.name}`;
      document.getElementById('author-id').value = a.id;
      document.getElementById('author-name').value = a.name;
      document.getElementById('author-role').value = a.role_title || '';
      document.getElementById('author-bio').value = a.bio || '';
      document.getElementById('author-avatar').value = a.avatar_url || '';
      document.getElementById('author-status').value = a.status;
      modal.classList.remove('hidden');
    }

    function closeModal() {
      modal.classList.add('hidden');
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        try {
          const res = await fetch('/api/v1/admin/content', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ entity: 'author', data: payload })
          });
          const data = await res.json();
          if (res.ok && data.success) {
            window.location.reload();
          } else {
            alert(data.message || 'Failed to save author');
          }
        } catch {
          alert('Network error saving author');
        }
      });
    }
  </script>
</AdminLayout>
