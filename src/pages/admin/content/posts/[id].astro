---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import { BlogService } from '@/services/content/blog.service';
import { CmsService } from '@/services/content/cms.service';
import { executeQuery } from '@/lib/db/query';
import type { AssessmentRow } from '@/types/database';

export const prerender = false;

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/content/posts');

const env = Astro.locals.runtime?.env;
const db = env?.DB || null;

const blogService = new BlogService(db);
const cmsService = new CmsService(db);

const [post, authors, categories, ctas, assessments] = await Promise.all([
  blogService.getPostById(id),
  cmsService.getAuthors('active'),
  cmsService.getBlogCategories('active'),
  cmsService.getContentCtas('active'),
  db ? executeQuery<AssessmentRow>(db, "SELECT * FROM assessments WHERE status = 'published' ORDER BY name ASC") : []
]);

if (!post) {
  return Astro.redirect('/admin/content/posts');
}

const tagNames = post.tags ? post.tags.map((t) => t.name).join(', ') : '';
---

<AdminLayout title={`Edit: ${post.title}`}>
  <div class="max-w-5xl mx-auto space-y-6">
    <!-- Header -->
    <div class="flex items-center justify-between">
      <div>
        <div class="flex items-center gap-2">
          <a href="/admin/content/posts" class="text-xs font-semibold text-indigo-600 hover:underline">← All Articles</a>
          <span class="text-xs text-slate-400">/</span>
          <span class="text-xs font-mono text-slate-500">{post.id}</span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1 line-clamp-1">{post.title}</h1>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={`/blog/${post.slug}?preview=true`}
          target="_blank"
          class="px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-colors"
        >
          👁️ Preview Draft
        </a>
      </div>
    </div>

    <form id="post-editor-form" class="space-y-6">
      <input type="hidden" name="id" value={post.id} />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Main Content Column -->
        <div class="lg:col-span-8 space-y-6">
          <Card class="p-6 border-slate-200 bg-white space-y-4 shadow-sm">
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Article Title <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                name="title"
                value={post.title}
                required
                class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-base font-bold text-slate-900 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white"
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                URL Slug
              </label>
              <input
                type="text"
                name="slug"
                value={post.slug}
                class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white"
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Excerpt / Meta Snippet
              </label>
              <textarea
                name="excerpt"
                rows="3"
                class="w-full px-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white"
              >{post.excerpt || ''}</textarea>
            </div>

            <div>
              <div class="flex items-center justify-between mb-1">
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider">
                  Article Body (Markdown / Safe HTML) <span class="text-rose-500">*</span>
                </label>
                <span class="text-[11px] text-slate-400">⏱️ Est. ~{post.reading_time_minutes} min read</span>
              </div>
              <textarea
                name="content"
                rows="20"
                required
                class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white"
              >{post.content}</textarea>
            </div>
          </Card>

          <!-- Assessment Integration Card -->
          <Card class="p-6 border-slate-200 bg-white space-y-4 shadow-sm">
            <h3 class="text-sm font-bold text-slate-900 flex items-center gap-2">
              <span>🎯</span> Assessment & Conversion CTA Integration
            </h3>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                  Recommend Assessment
                </label>
                <select
                  name="related_assessment_id"
                  class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white"
                >
                  <option value="">None / Generic CTA</option>
                  {assessments.map((asm) => (
                    <option value={asm.id} selected={post.related_assessment_id === asm.id}>{asm.name}</option>
                  ))}
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                  Custom CTA Block
                </label>
                <select
                  name="cta_id"
                  class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white"
                >
                  <option value="">Default Assessment Banner</option>
                  {ctas.map((cta) => (
                    <option value={cta.id} selected={post.cta_id === cta.id}>{cta.title}</option>
                  ))}
                </select>
              </div>
            </div>
          </Card>
        </div>

        <!-- Sidebar Options Column -->
        <div class="lg:col-span-4 space-y-6">
          <!-- Publishing Controls -->
          <Card class="p-6 border-slate-200 bg-white space-y-4 shadow-sm">
            <h3 class="text-sm font-bold text-slate-900">Publishing Status</h3>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Status</label>
              <select
                name="status"
                class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white"
              >
                <option value="draft" selected={post.status === 'draft'}>Draft (Private)</option>
                <option value="published" selected={post.status === 'published'}>Published (Public)</option>
                <option value="scheduled" selected={post.status === 'scheduled'}>Scheduled (Future)</option>
                <option value="archived" selected={post.status === 'archived'}>Archived</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Publish Date
              </label>
              <input
                type="datetime-local"
                name="published_at"
                value={post.published_at ? new Date(post.published_at).toISOString().slice(0, 16) : ''}
                class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white"
              />
            </div>

            <div class="flex items-center gap-2 pt-2">
              <input
                type="checkbox"
                id="featured"
                name="featured"
                value="1"
                checked={post.featured === 1}
                class="w-4 h-4 text-indigo-600 rounded border-slate-300 focus:ring-indigo-500"
              />
              <label for="featured" class="text-xs font-bold text-slate-700">
                Feature as Spotlight Article
              </label>
            </div>

            <div class="pt-4 border-t border-slate-100 space-y-2">
              <Button type="submit" id="save-btn" variant="primary" size="md" class="w-full">
                Save Changes
              </Button>
            </div>
          </Card>

          <!-- Taxonomy & Attribution -->
          <Card class="p-6 border-slate-200 bg-white space-y-4 shadow-sm">
            <h3 class="text-sm font-bold text-slate-900">Taxonomy & Author</h3>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Category</label>
              <select
                name="category_id"
                class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white"
              >
                <option value="">Select Category</option>
                {categories.map((c) => (
                  <option value={c.id} selected={post.category_id === c.id}>{c.name}</option>
                ))}
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">Author</label>
              <select
                name="author_id"
                class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white"
              >
                <option value="">Default Editorial Team</option>
                {authors.map((a) => (
                  <option value={a.id} selected={post.author_id === a.id}>{a.name} ({a.role_title})</option>
                ))}
              </select>
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Tags (Comma-separated)
              </label>
              <input
                type="text"
                name="tags"
                value={tagNames}
                class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white"
              />
            </div>

            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">
                Featured Image URL
              </label>
              <input
                type="text"
                name="featured_image_url"
                value={post.featured_image_url || ''}
                class="w-full px-3.5 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs font-mono text-slate-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white"
              />
            </div>
          </Card>
        </div>
      </div>
    </form>
  </div>

  <script is:inline>
    const form = document.getElementById('post-editor-form');
    const saveBtn = document.getElementById('save-btn');

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        saveBtn.disabled = true;
        saveBtn.textContent = 'Saving...';

        const formData = new FormData(form);
        const data = Object.fromEntries(formData.entries());
        data.featured = formData.get('featured') ? 1 : 0;
        data.tags = (data.tags || '').split(',').map((t) => t.trim()).filter(Boolean);

        try {
          const res = await fetch('/api/v1/admin/posts', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'update', post: data })
          });
          const result = await res.json();

          if (res.ok && result.success) {
            alert('Article saved successfully!');
            window.location.reload();
          } else {
            alert(result.message || 'Failed to update article');
          }
        } catch (err) {
          alert('Network error saving article');
        } finally {
          saveBtn.disabled = false;
          saveBtn.textContent = 'Save Changes';
        }
      });
    }
  </script>
</AdminLayout>
