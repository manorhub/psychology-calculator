---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { fetchFirst, executeQuery } from '@/lib/db/query';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = env?.DB || null;

let stats = {
  posts: 0,
  publishedPosts: 0,
  draftPosts: 0,
  pages: 0,
  categories: 0,
  authors: 0,
  tags: 0,
  media: 0
};

let recentPosts: any[] = [];

if (db) {
  const [
    totalPosts,
    pubPosts,
    drafts,
    totalPages,
    totalCats,
    totalAuthors,
    totalTags,
    totalMedia,
    recent
  ] = await Promise.all([
    fetchFirst<{ count: number }>(db, 'SELECT COUNT(*) as count FROM posts'),
    fetchFirst<{ count: number }>(db, "SELECT COUNT(*) as count FROM posts WHERE status = 'published'"),
    fetchFirst<{ count: number }>(db, "SELECT COUNT(*) as count FROM posts WHERE status = 'draft'"),
    fetchFirst<{ count: number }>(db, 'SELECT COUNT(*) as count FROM pages'),
    fetchFirst<{ count: number }>(db, 'SELECT COUNT(*) as count FROM blog_categories'),
    fetchFirst<{ count: number }>(db, 'SELECT COUNT(*) as count FROM authors'),
    fetchFirst<{ count: number }>(db, 'SELECT COUNT(*) as count FROM tags'),
    fetchFirst<{ count: number }>(db, 'SELECT COUNT(*) as count FROM media_items'),
    executeQuery<any>(db, 'SELECT * FROM posts ORDER BY updated_at DESC LIMIT 5')
  ]);

  stats = {
    posts: totalPosts?.count || 0,
    publishedPosts: pubPosts?.count || 0,
    draftPosts: drafts?.count || 0,
    pages: totalPages?.count || 0,
    categories: totalCats?.count || 0,
    authors: totalAuthors?.count || 0,
    tags: totalTags?.count || 0,
    media: totalMedia?.count || 0
  };

  recentPosts = recent;
}
---

<AdminLayout title="Content CMS & Blog Engine">
  <div class="space-y-8 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight">Content CMS & Blog Management</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Dynamic management for articles, static pages, authors, categories, tags, and media assets.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/content/posts/new"
          class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-xl transition-colors shadow-sm flex items-center gap-1.5"
        >
          ✏️ Write New Article
        </a>
      </div>
    </div>

    <!-- Quick Stats Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      <Card class="p-5 border-slate-200 bg-white">
        <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Total Articles</div>
        <div class="text-2xl font-black text-slate-900 mt-1">{stats.posts}</div>
        <div class="text-[11px] text-emerald-600 font-semibold mt-1">
          {stats.publishedPosts} Published • {stats.draftPosts} Drafts
        </div>
      </Card>

      <Card class="p-5 border-slate-200 bg-white">
        <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Static Pages</div>
        <div class="text-2xl font-black text-slate-900 mt-1">{stats.pages}</div>
        <div class="text-[11px] text-slate-400 mt-1">About, Privacy, Terms, Disclaimer</div>
      </Card>

      <Card class="p-5 border-slate-200 bg-white">
        <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Categories & Tags</div>
        <div class="text-2xl font-black text-slate-900 mt-1">{stats.categories} / {stats.tags}</div>
        <div class="text-[11px] text-slate-400 mt-1">Taxonomy Nodes</div>
      </Card>

      <Card class="p-5 border-slate-200 bg-white">
        <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider">Media Assets (R2)</div>
        <div class="text-2xl font-black text-slate-900 mt-1">{stats.media}</div>
        <div class="text-[11px] text-slate-400 mt-1">Uploaded Images & Cards</div>
      </Card>
    </div>

    <!-- Content Sections Matrix -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <Card class="p-6 border-slate-200 bg-white hover:border-indigo-200 transition-colors flex flex-col justify-between">
        <div class="space-y-2">
          <div class="text-2xl">📝</div>
          <h3 class="text-base font-bold text-slate-900">Blog Articles</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Create, edit, duplicate, schedule, and publish educational psychology guides and research posts.
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400">{stats.posts} Items</span>
          <a href="/admin/content/posts" class="text-xs font-bold text-indigo-600 hover:text-indigo-800">
            Manage Posts →
          </a>
        </div>
      </Card>

      <Card class="p-6 border-slate-200 bg-white hover:border-indigo-200 transition-colors flex flex-col justify-between">
        <div class="space-y-2">
          <div class="text-2xl">📄</div>
          <h3 class="text-base font-bold text-slate-900">Static Pages</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Manage company, informational, and legal policy pages (/about, /privacy-policy, /terms, /disclaimer).
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400">{stats.pages} Pages</span>
          <a href="/admin/content/pages" class="text-xs font-bold text-indigo-600 hover:text-indigo-800">
            Manage Pages →
          </a>
        </div>
      </Card>

      <Card class="p-6 border-slate-200 bg-white hover:border-indigo-200 transition-colors flex flex-col justify-between">
        <div class="space-y-2">
          <div class="text-2xl">🏷️</div>
          <h3 class="text-base font-bold text-slate-900">Taxonomy & Tags</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Structure your knowledge library with dynamic categories, topic filters, and content tags.
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400">{stats.categories} Categories</span>
          <a href="/admin/content/categories" class="text-xs font-bold text-indigo-600 hover:text-indigo-800">
            Manage Taxonomy →
          </a>
        </div>
      </Card>

      <Card class="p-6 border-slate-200 bg-white hover:border-indigo-200 transition-colors flex flex-col justify-between">
        <div class="space-y-2">
          <div class="text-2xl">✍️</div>
          <h3 class="text-base font-bold text-slate-900">Authors & Byline Profiles</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Maintain accurate author profiles, credentials, bios, avatars, and social links.
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400">{stats.authors} Profiles</span>
          <a href="/admin/content/authors" class="text-xs font-bold text-indigo-600 hover:text-indigo-800">
            Manage Authors →
          </a>
        </div>
      </Card>

      <Card class="p-6 border-slate-200 bg-white hover:border-indigo-200 transition-colors flex flex-col justify-between">
        <div class="space-y-2">
          <div class="text-2xl">🖼️</div>
          <h3 class="text-base font-bold text-slate-900">Media Library</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Upload images to Cloudflare R2, manage accessibility alt text, and copy CDN media links.
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400">{stats.media} Files</span>
          <a href="/admin/content/media" class="text-xs font-bold text-indigo-600 hover:text-indigo-800">
            Open Media Library →
          </a>
        </div>
      </Card>

      <Card class="p-6 border-slate-200 bg-white hover:border-indigo-200 transition-colors flex flex-col justify-between">
        <div class="space-y-2">
          <div class="text-2xl">⚡</div>
          <h3 class="text-base font-bold text-slate-900">Assessment CTAs</h3>
          <p class="text-xs text-slate-500 leading-relaxed">
            Build and attach reusable call-to-action blocks that connect educational articles to test funnels.
          </p>
        </div>
        <div class="pt-4 mt-4 border-t border-slate-100 flex items-center justify-between">
          <span class="text-xs font-semibold text-slate-400">Dynamic</span>
          <a href="/admin/content/posts" class="text-xs font-bold text-indigo-600 hover:text-indigo-800">
            Configure in Editor →
          </a>
        </div>
      </Card>
    </div>

    <!-- Recent Content Table -->
    <Card class="border-slate-200 bg-white overflow-hidden">
      <div class="p-5 border-b border-slate-100 flex items-center justify-between">
        <h3 class="text-sm font-bold text-slate-900">Recent Content Updates</h3>
        <a href="/admin/content/posts" class="text-xs font-semibold text-indigo-600 hover:underline">
          View all →
        </a>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 text-slate-500 font-bold uppercase border-b border-slate-100">
            <tr>
              <th class="p-3.5">Title</th>
              <th class="p-3.5">Status</th>
              <th class="p-3.5">Reading Time</th>
              <th class="p-3.5">Updated</th>
              <th class="p-3.5 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700">
            {recentPosts.map((p) => (
              <tr class="hover:bg-slate-50/60 transition-colors">
                <td class="p-3.5 font-bold text-slate-900">
                  <a href={`/admin/content/posts/${p.id}`} class="hover:text-indigo-600">
                    {p.title}
                  </a>
                </td>
                <td class="p-3.5">
                  <Badge
                    variant={
                      p.status === 'published'
                        ? 'success'
                        : p.status === 'scheduled'
                          ? 'warning'
                          : 'slate'
                    }
                    size="sm"
                  >
                    {p.status}
                  </Badge>
                </td>
                <td class="p-3.5 text-slate-500">⏱️ {p.reading_time_minutes} mins</td>
                <td class="p-3.5 text-slate-400 font-mono">
                  {p.updated_at ? new Date(p.updated_at).toLocaleDateString() : '—'}
                </td>
                <td class="p-3.5 text-right space-x-2">
                  <a
                    href={`/blog/${p.slug}?preview=true`}
                    target="_blank"
                    class="text-indigo-600 hover:underline font-semibold"
                  >
                    Preview
                  </a>
                  <a
                    href={`/admin/content/posts/${p.id}`}
                    class="text-slate-600 hover:underline font-semibold"
                  >
                    Edit
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Card>
  </div>
</AdminLayout>
