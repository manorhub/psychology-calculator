---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import { getD1Database } from '@/lib/db/client';
import { EmailService } from '@/services/email.service';
import type { EmailJobStatus } from '@/types/database';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const emailService = new EmailService(db);

const url = new URL(Astro.request.url);
const statusFilter = url.searchParams.get('status') as EmailJobStatus | undefined;
const eventFilter = url.searchParams.get('event') || undefined;

const { jobs, total } = await emailService.getEmailJobs(50, 0, statusFilter, eventFilter);
---

<AdminLayout title="Email Delivery Logs">
  <div class="space-y-6 max-w-7xl mx-auto">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <div class="flex items-center gap-2">
          <a href="/admin/settings/email" class="text-xs font-semibold text-indigo-600 hover:underline">SMTP Settings</a>
          <span class="text-xs text-slate-400">/</span>
          <a href="/admin/email/templates" class="text-xs font-semibold text-indigo-600 hover:underline">Templates</a>
          <span class="text-xs text-slate-400">/</span>
          <span class="text-xs font-semibold text-slate-600">Logs</span>
        </div>
        <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Email Delivery Logs & Audit Ledger</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">
          Monitor real-time transactional delivery status, inspect message payloads, and retry failed SMTP transmissions.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin/email/templates"
          class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition-colors flex items-center gap-1.5"
        >
          ✉️ Email Templates
        </a>
        <a
          href="/admin/settings/email"
          class="px-4 py-2 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-bold rounded-xl transition-colors flex items-center gap-1.5"
        >
          ⚙️ SMTP Settings
        </a>
      </div>
    </div>

    <!-- Status Filters -->
    <div class="flex items-center gap-2 overflow-x-auto pb-1">
      <a
        href="/admin/email/logs"
        class={`px-3.5 py-1.5 rounded-full text-xs font-semibold transition-colors ${
          !statusFilter ? 'bg-indigo-600 text-white shadow-xs' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'
        }`}
      >
        All Jobs ({total})
      </a>
      <a
        href="/admin/email/logs?status=sent"
        class={`px-3.5 py-1.5 rounded-full text-xs font-semibold transition-colors ${
          statusFilter === 'sent' ? 'bg-indigo-600 text-white shadow-xs' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'
        }`}
      >
        ✓ Sent
      </a>
      <a
        href="/admin/email/logs?status=failed"
        class={`px-3.5 py-1.5 rounded-full text-xs font-semibold transition-colors ${
          statusFilter === 'failed' ? 'bg-rose-600 text-white shadow-xs' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'
        }`}
      >
        ⚠️ Failed
      </a>
      <a
        href="/admin/email/logs?status=queued"
        class={`px-3.5 py-1.5 rounded-full text-xs font-semibold transition-colors ${
          statusFilter === 'queued' ? 'bg-indigo-600 text-white shadow-xs' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50'
        }`}
      >
        ⏳ Queued
      </a>
    </div>

    <!-- Logs Table -->
    <Card class="border-slate-200 bg-white overflow-hidden shadow-sm">
      {jobs.length === 0 ? (
        <div class="p-12 text-center text-slate-500 text-xs">
          No email jobs found matching the current criteria.
        </div>
      ) : (
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-500 font-bold uppercase border-b border-slate-100">
              <tr>
                <th class="p-3.5">Recipient</th>
                <th class="p-3.5">Subject & Event Key</th>
                <th class="p-3.5">Status</th>
                <th class="p-3.5">Attempts</th>
                <th class="p-3.5">Created / Sent</th>
                <th class="p-3.5 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 text-slate-700">
              {jobs.map((j) => (
                <tr class="hover:bg-slate-50/60 transition-colors">
                  <td class="p-3.5 font-mono text-slate-900 font-semibold whitespace-nowrap">
                    {j.recipient}
                  </td>
                  <td class="p-3.5 max-w-sm">
                    <div class="font-bold text-slate-900 truncate">{j.subject}</div>
                    <div class="font-mono text-[10px] text-indigo-600 font-medium">{j.event_key}</div>
                    {j.last_error && (
                      <div class="text-[10px] text-rose-600 font-mono mt-0.5 max-w-xs truncate" title={j.last_error}>
                        ⚠️ {j.last_error}
                      </div>
                    )}
                  </td>
                  <td class="p-3.5 whitespace-nowrap">
                    <Badge
                      variant={
                        j.status === 'sent'
                          ? 'success'
                          : j.status === 'failed'
                            ? 'danger'
                            : j.status === 'sending'
                              ? 'warning'
                              : 'default'
                      }
                      size="sm"
                    >
                      {j.status === 'sent' ? '✓ Sent' : j.status === 'failed' ? '⚠️ Failed' : j.status}
                    </Badge>
                  </td>
                  <td class="p-3.5 font-mono text-slate-600 whitespace-nowrap">
                    {j.attempts} / {j.max_attempts}
                  </td>
                  <td class="p-3.5 font-mono text-[11px] text-slate-500 whitespace-nowrap">
                    <div>Created: {new Date(j.created_at).toLocaleTimeString()}</div>
                    {j.sent_at && <div class="text-teal-600 font-medium">Sent: {new Date(j.sent_at).toLocaleTimeString()}</div>}
                  </td>
                  <td class="p-3.5 text-right whitespace-nowrap space-x-1.5">
                    {j.payload && (
                      <button
                        onclick={`showPayload(${JSON.stringify(j.payload)})`}
                        class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg text-xs font-semibold transition-colors cursor-pointer"
                        title="Inspect event payload data"
                      >
                        🔍 Payload
                      </button>
                    )}
                    {j.status === 'failed' && (
                      <button
                        onclick={`retryJob('${j.id}')`}
                        class="px-2.5 py-1 bg-amber-50 hover:bg-amber-100 text-amber-700 rounded-lg text-xs font-bold transition-colors cursor-pointer inline-flex items-center gap-1"
                        title="Retry delivery now"
                      >
                        🔄 Retry
                      </button>
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </Card>
  </div>

  <script is:inline>
    function showPayload(payloadStr) {
      try {
        const parsed = typeof payloadStr === 'string' ? JSON.parse(payloadStr) : payloadStr;
        alert('Event Payload:\n\n' + JSON.stringify(parsed, null, 2));
      } catch {
        alert('Payload: ' + payloadStr);
      }
    }

    async function retryJob(jobId) {
      if (!confirm('Retry sending this email job now?')) return;
      try {
        const res = await fetch('/api/v1/admin/email-test', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'retry_job', jobId })
        });
        const data = await res.json();
        alert(data.message);
        window.location.reload();
      } catch {
        alert('Network error retrying job');
      }
    }
  </script>
</AdminLayout>
