---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Input from '@/components/ui/Input.astro';
import Button from '@/components/ui/Button.astro';
import Alert from '@/components/ui/Alert.astro';
import { getD1Database } from '@/lib/db/client';
import { AssessmentBuilderService } from '@/services/assessment-builder.service';

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const service = new AssessmentBuilderService(db);

const categories = await service.getCategories();
---

<AdminLayout title="Create Assessment" description="Initialize a new psychometric instrument">
  <div class="max-w-4xl space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <a href="/admin/assessments" class="text-xs font-semibold text-teal-700 hover:text-teal-800 flex items-center gap-1 mb-1">
          ← Back to Assessments Catalog
        </a>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Create Assessment</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Configure foundational details, category, and metadata</p>
      </div>
    </div>

    <div id="error-alert" class="hidden">
      <Alert variant="danger" title="Validation Error">
        <span id="error-msg"></span>
      </Alert>
    </div>

    <form id="create-assessment-form" class="space-y-6">
      <Card title="Core Information" subtitle="Instrument name, category, and URL identifier">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <Input
            id="name"
            name="name"
            label="Assessment Name"
            placeholder="e.g. Attachment Style Assessment"
            required={true}
          />

          <Input
            id="slug"
            name="slug"
            label="URL Slug"
            placeholder="e.g. attachment-style"
            hint="Unique URL identifier (lowercase letters, numbers, hyphens)"
            required={true}
          />

          <div>
            <label for="category_id" class="block text-xs font-semibold text-slate-700 mb-1">
              Category <span class="text-rose-500">*</span>
            </label>
            <select
              id="category_id"
              name="category_id"
              required
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-800 focus:ring-2 focus:ring-teal-600"
            >
              <option value="">Select a Category...</option>
              {categories.map((c) => (
                <option value={c.id}>{c.name}</option>
              ))}
            </select>
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <Input
                id="estimated_minutes"
                name="estimated_minutes"
                type="number"
                label="Est. Time (Mins)"
                value="10"
                required={true}
              />
            </div>
            <div>
              <label for="access_type" class="block text-xs font-semibold text-slate-700 mb-1">
                Access Type
              </label>
              <select
                id="access_type"
                name="access_type"
                class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-800 focus:ring-2 focus:ring-teal-600"
              >
                <option value="free">Free</option>
                <option value="premium">Premium</option>
              </select>
            </div>
          </div>

          <div class="sm:col-span-2">
            <Input
              id="short_description"
              name="short_description"
              label="Short Summary"
              placeholder="Brief 1-2 sentence description shown in catalog cards"
              required={true}
            />
          </div>

          <div class="sm:col-span-2">
            <label for="long_description" class="block text-xs font-semibold text-slate-700 mb-1">
              Comprehensive Description
            </label>
            <textarea
              id="long_description"
              name="long_description"
              rows="3"
              placeholder="Detailed explanation of what the assessment evaluates..."
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl p-3 text-slate-800 focus:ring-2 focus:ring-teal-600"
            ></textarea>
          </div>
        </div>
      </Card>

      <Card title="Instructions & Disclaimers" subtitle="Participant instructions and clinical disclaimers">
        <div class="space-y-4">
          <div>
            <label for="instructions" class="block text-xs font-semibold text-slate-700 mb-1">
              Participant Instructions
            </label>
            <textarea
              id="instructions"
              name="instructions"
              rows="3"
              placeholder="e.g. Answer honestly based on how you genuinely feel, not how you think you should feel..."
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl p-3 text-slate-800 focus:ring-2 focus:ring-teal-600"
            ></textarea>
          </div>

          <div>
            <label for="disclaimer" class="block text-xs font-semibold text-slate-700 mb-1">
              Assessment Disclaimer
            </label>
            <textarea
              id="disclaimer"
              name="disclaimer"
              rows="2"
              placeholder="e.g. This assessment is designed for self-discovery and educational purposes only and does not constitute medical diagnosis."
              class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl p-3 text-slate-800 focus:ring-2 focus:ring-teal-600"
            ></textarea>
          </div>

          <div class="flex items-center gap-3 pt-2">
            <input
              type="checkbox"
              id="featured"
              name="featured"
              value="true"
              class="w-4 h-4 text-teal-600 rounded border-slate-300 focus:ring-teal-500"
            />
            <label for="featured" class="text-xs font-semibold text-slate-800">
              Feature on Homepage and Assessment Hub
            </label>
          </div>
        </div>
      </Card>

      <div class="flex justify-end gap-3">
        <Button href="/admin/assessments" variant="outline" size="md">
          Cancel
        </Button>
        <Button type="submit" variant="primary" size="md" id="submit-btn">
          Create Draft & Open Builder →
        </Button>
      </div>
    </form>
  </div>
</AdminLayout>

<script>
  const nameInput = document.getElementById('name') as HTMLInputElement | null;
  const slugInput = document.getElementById('slug') as HTMLInputElement | null;
  const form = document.getElementById('create-assessment-form') as HTMLFormElement | null;
  const errorAlert = document.getElementById('error-alert');
  const errorMsg = document.getElementById('error-msg');
  const submitBtn = document.getElementById('submit-btn');

  // Auto-slugify name
  nameInput?.addEventListener('input', () => {
    if (slugInput && !slugInput.dataset.touched) {
      slugInput.value = nameInput.value
        .toLowerCase()
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/(^-|-$)+/g, '');
    }
  });

  slugInput?.addEventListener('input', () => {
    if (slugInput) slugInput.dataset.touched = 'true';
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorAlert?.classList.add('hidden');
    submitBtn?.setAttribute('disabled', 'true');

    const formData = new FormData(form);
    const payload = {
      name: String(formData.get('name') || ''),
      slug: String(formData.get('slug') || ''),
      category_id: String(formData.get('category_id') || ''),
      short_description: String(formData.get('short_description') || ''),
      long_description: String(formData.get('long_description') || ''),
      instructions: String(formData.get('instructions') || ''),
      disclaimer: String(formData.get('disclaimer') || ''),
      estimated_minutes: parseInt(String(formData.get('estimated_minutes') || '10'), 10),
      access_type: String(formData.get('access_type') || 'free'),
      featured: formData.get('featured') === 'true'
    };

    try {
      const res = await fetch('/api/admin/assessments', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data: any = await res.json();

      if (!res.ok || !data.success) {
        if (errorMsg) errorMsg.textContent = data.error?.message || 'Failed to create assessment.';
        errorAlert?.classList.remove('hidden');
        submitBtn?.removeAttribute('disabled');
        return;
      }

      // Redirect directly to the full builder
      window.location.href = `/admin/assessments/${data.data.id}`;
    } catch {
      if (errorMsg) errorMsg.textContent = 'A network error occurred.';
      errorAlert?.classList.remove('hidden');
      submitBtn?.removeAttribute('disabled');
    }
  });
</script>
