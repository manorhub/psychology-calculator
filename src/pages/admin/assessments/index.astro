---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import Pagination from '@/components/admin/Pagination.astro';
import { getD1Database } from '@/lib/db/client';
import { AssessmentBuilderService } from '@/services/assessment-builder.service';

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const service = new AssessmentBuilderService(db);

const url = Astro.url;
const page = parseInt(url.searchParams.get('page') || '1', 10);
const limit = parseInt(url.searchParams.get('limit') || '10', 10);
const search = url.searchParams.get('q') || '';
const status = url.searchParams.get('status') || '';
const categoryId = url.searchParams.get('category_id') || '';
const accessType = url.searchParams.get('access_type') || '';

const [result, categories] = await Promise.all([
  service.getAssessments({ page, limit, search, status, categoryId, accessType }),
  service.getCategories()
]);
---

<AdminLayout title="Assessments Catalog" description="Manage psychological assessment instruments, questions, and scoring models">
  <div class="space-y-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-slate-200">
      <div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Assessments Catalog</h1>
        <p class="text-xs sm:text-sm text-slate-500 mt-1">Configure instruments, item banks, dimensions, scoring rules, and interpretations</p>
      </div>

      <div class="flex items-center gap-3">
        <Button href="/admin/assessments/new" variant="primary" size="sm">
          + Create Assessment
        </Button>
      </div>
    </div>

    <!-- Search & Filter Bar -->
    <Card class="p-4">
      <form method="GET" class="grid grid-cols-1 sm:grid-cols-4 gap-3">
        <div>
          <input
            type="text"
            name="q"
            value={search}
            placeholder="Search by name or slug..."
            class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3.5 py-2.5 text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-teal-600"
          />
        </div>

        <div>
          <select
            name="category_id"
            class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-600"
          >
            <option value="">All Categories</option>
            {categories.map((c) => (
              <option value={c.id} selected={categoryId === c.id}>{c.name}</option>
            ))}
          </select>
        </div>

        <div>
          <select
            name="status"
            class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-600"
          >
            <option value="">All Statuses</option>
            <option value="draft" selected={status === 'draft'}>Draft</option>
            <option value="published" selected={status === 'published'}>Published</option>
            <option value="archived" selected={status === 'archived'}>Archived</option>
          </select>
        </div>

        <div class="flex gap-2">
          <select
            name="access_type"
            class="w-full text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2.5 text-slate-800 focus:outline-none focus:ring-2 focus:ring-teal-600"
          >
            <option value="">All Access Types</option>
            <option value="free" selected={accessType === 'free'}>Free</option>
            <option value="premium" selected={accessType === 'premium'}>Premium</option>
          </select>

          <Button type="submit" variant="primary" size="sm">
            Filter
          </Button>
        </div>
      </form>
    </Card>

    <!-- Assessments Table -->
    <Card class="p-0 overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs border-collapse">
          <thead>
            <tr class="bg-slate-50/80 border-b border-slate-200 text-slate-500 font-semibold uppercase tracking-wider">
              <th class="py-3.5 px-4 sm:px-6">Assessment</th>
              <th class="py-3.5 px-4">Category</th>
              <th class="py-3.5 px-4 text-center">Items</th>
              <th class="py-3.5 px-4 text-center">Dimensions</th>
              <th class="py-3.5 px-4">Access</th>
              <th class="py-3.5 px-4">Status</th>
              <th class="py-3.5 px-4 text-right">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {result.items.length === 0 ? (
              <tr>
                <td colspan="7" class="p-8 text-center text-slate-500 font-sans">
                  No assessments found matching the selected filters.
                </td>
              </tr>
            ) : (
              result.items.map((test) => (
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="py-3.5 px-4 sm:px-6">
                    <div class="font-bold text-slate-900 flex items-center gap-2">
                      <a href={`/admin/assessments/${test.id}`} class="hover:text-teal-700">
                        {test.name}
                      </a>
                      {test.featured === 1 && (
                        <span class="px-1.5 py-0.5 text-[9px] font-bold bg-amber-100 text-amber-800 rounded">
                          ★ FEATURED
                        </span>
                      )}
                    </div>
                    <div class="text-[11px] text-slate-500 font-mono mt-0.5">/{test.slug} • v{test.version}</div>
                  </td>
                  <td class="py-3.5 px-4 text-slate-700 font-medium">
                    {test.category_name || 'Uncategorized'}
                  </td>
                  <td class="py-3.5 px-4 text-center font-bold text-slate-900">
                    {test.question_count}
                  </td>
                  <td class="py-3.5 px-4 text-center font-bold text-slate-900">
                    {test.dimension_count}
                  </td>
                  <td class="py-3.5 px-4">
                    <span class={`inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold ${
                      test.access_type === 'premium' ? 'bg-amber-100 text-amber-900' : 'bg-slate-100 text-slate-700'
                    }`}>
                      {test.access_type.toUpperCase()}
                    </span>
                  </td>
                  <td class="py-3.5 px-4">
                    <Badge
                      variant={
                        test.status === 'published'
                          ? 'success'
                          : test.status === 'draft'
                          ? 'warning'
                          : 'default'
                      }
                      size="sm"
                    >
                      {test.status.toUpperCase()}
                    </Badge>
                  </td>
                  <td class="py-3.5 px-4 text-right whitespace-nowrap">
                    <div class="flex items-center justify-end gap-1.5">
                      <a
                        href={`/admin/assessments/${test.id}/preview`}
                        class="p-1.5 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-lg"
                        title="Interactive Preview"
                      >
                        👁️
                      </a>
                      <a
                        href={`/admin/assessments/${test.id}`}
                        class="px-2 py-1 font-semibold text-teal-700 hover:text-teal-800 hover:bg-teal-50 rounded-lg transition-colors"
                      >
                        Edit Builder →
                      </a>
                    </div>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>

      <Pagination
        currentPage={result.page}
        totalPages={result.totalPages}
        totalItems={result.total}
        limit={result.limit}
        baseUrl={url.toString()}
      />
    </Card>
  </div>
</AdminLayout>
