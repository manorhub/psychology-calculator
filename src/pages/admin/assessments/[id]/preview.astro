---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import { getD1Database } from '@/lib/db/client';
import { AssessmentBuilderService } from '@/services/assessment-builder.service';
import { requireAdmin } from '@/lib/auth/guards';

requireAdmin(Astro.locals);
const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/assessments');

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const service = new AssessmentBuilderService(db);

const full = await service.getAssessmentFull(id);
if (!full) return Astro.redirect('/admin/assessments');

const { assessment, dimensions, questions, resultTypes } = full;
---

<BaseLayout title={`Preview: ${assessment.name}`} description="Assessment Preview Mode">
  <!-- Top Preview Bar -->
  <div class="bg-amber-500 text-slate-950 px-4 py-2 text-xs font-bold flex items-center justify-between shadow-sm">
    <div class="flex items-center gap-2">
      <span class="px-2 py-0.5 bg-black text-white rounded text-[10px] uppercase tracking-wider">Preview Mode</span>
      <span>Viewing draft test layout. Responses are evaluated in memory and not saved to database.</span>
    </div>
    <a
      href={`/admin/assessments/${assessment.id}`}
      class="px-3 py-1 bg-black text-white hover:bg-slate-900 rounded-lg text-xs transition-colors"
    >
      Return to Builder →
    </a>
  </div>

  <div class="max-w-3xl mx-auto py-10 px-4 sm:px-6 space-y-8">
    <!-- Assessment Intro Card -->
    <Card class="p-8 text-center space-y-4">
      <div class="flex justify-center">
        <Badge variant={assessment.status === 'published' ? 'success' : 'warning'} size="sm">
          {assessment.status.toUpperCase()}
        </Badge>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        {assessment.name}
      </h1>

      <p class="text-sm text-slate-600 max-w-xl mx-auto">
        {assessment.short_description}
      </p>

      <div class="flex items-center justify-center gap-6 text-xs text-slate-500 pt-2">
        <span>⏱️ ~{assessment.estimated_minutes} minutes</span>
        <span>📝 {questions.length} questions</span>
        <span>🎯 {dimensions.length} evaluated dimensions</span>
      </div>

      {assessment.instructions && (
        <div class="mt-4 p-4 rounded-xl bg-slate-50 border border-slate-200 text-xs text-slate-700 text-left">
          <strong class="text-slate-900 block mb-1">Instructions:</strong>
          {assessment.instructions}
        </div>
      )}
    </Card>

    <!-- Interactive Question Preview List -->
    <div class="space-y-6" id="preview-questions-container">
      <h2 class="text-lg font-bold text-slate-900">Assessment Questions</h2>

      {questions.map((q, idx) => (
        <Card class="p-6 space-y-4">
          <div class="flex items-start gap-3">
            <span class="w-7 h-7 rounded-lg bg-teal-50 text-teal-700 font-bold text-xs flex items-center justify-center flex-shrink-0">
              {idx + 1}
            </span>
            <div class="flex-1">
              <h3 class="text-sm font-bold text-slate-900">{q.question_text}</h3>
            </div>
          </div>

          <!-- Options Render -->
          <div class="space-y-2 pt-2">
            {q.options.map((opt) => (
              <label class="flex items-center justify-between p-3 rounded-xl border border-slate-200 hover:border-teal-500 hover:bg-teal-50/30 cursor-pointer transition-colors text-xs font-medium text-slate-800">
                <div class="flex items-center gap-3">
                  <input
                    type="radio"
                    name={`preview_q_${q.id}`}
                    value={opt.option_value}
                    class="w-4 h-4 text-teal-600 border-slate-300 focus:ring-teal-500"
                  />
                  <span>{opt.option_text}</span>
                </div>
                <span class="text-[10px] text-slate-400 font-mono">Value: {opt.option_value}</span>
              </label>
            ))}
          </div>
        </Card>
      ))}
    </div>

    <!-- Result Outcome Structure Preview -->
    <Card title="Configured Result Outcome Archetypes" subtitle="Preview of how results and interpretations will render">
      <div class="divide-y divide-slate-100">
        {resultTypes.length === 0 ? (
          <p class="text-xs text-slate-500 p-4 text-center">No result archetypes configured yet.</p>
        ) : (
          resultTypes.map((rt) => (
            <div class="py-4 space-y-2">
              <div class="flex items-center justify-between">
                <h4 class="text-xs font-bold text-slate-900">{rt.name}</h4>
                <span class="text-[11px] font-mono text-teal-700 font-semibold">
                  Score Range: {rt.minimum_score} - {rt.maximum_score}
                </span>
              </div>
              <p class="text-xs text-slate-600">{rt.description || 'No description set.'}</p>
              {rt.contents.map((c) => (
                <div class="p-3 bg-slate-50 rounded-xl text-xs text-slate-700 border border-slate-100">
                  <strong class="block text-[10px] uppercase tracking-wider text-slate-400 mb-1">{c.title} ({c.section_type})</strong>
                  {c.content}
                </div>
              ))}
            </div>
          ))
        )}
      </div>
    </Card>

    {assessment.disclaimer && (
      <div class="p-4 rounded-xl bg-slate-100 text-[11px] text-slate-500 text-center">
        {assessment.disclaimer}
      </div>
    )}
  </div>
</BaseLayout>
