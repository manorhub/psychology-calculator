---
import AdminLayout from '@/layouts/AdminLayout.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import { getD1Database } from '@/lib/db/client';
import { ExperimentService } from '@/services/growth/experiment.service';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const expService = new ExperimentService(db);

const experiments = await expService.getAllExperiments();
const experimentReports = await Promise.all(
  experiments.map((e) => expService.getExperimentAnalytics(e.id))
);
---

<AdminLayout title="A/B Testing & Conversion Experiments">
  <div class="space-y-8">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">A/B Testing & Experiments</h1>
        <p class="text-sm text-slate-500">Run controlled, deterministic experiments on copy, CTAs, and layout</p>
      </div>
      <a
        href="/admin/growth"
        class="inline-flex items-center gap-2 px-4 py-2 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-sm font-semibold rounded-xl shadow-sm transition"
      >
        ← Back to Growth Dashboard
      </a>
    </div>

    <!-- Active Experiments Explorer -->
    {experimentReports.length === 0 ? (
      <Card>
        <div class="p-12 text-center">
          <p class="text-slate-500 text-sm mb-4">No A/B experiments created yet.</p>
          <p class="text-xs text-slate-400">Experiments allow testing distinct headlines, CTA buttons, and layouts safely without affecting scoring algorithms or disclaimers.</p>
        </div>
      </Card>
    ) : (
      <div class="space-y-6">
        {experimentReports.map((report) => (
          <Card>
            <div class="p-6 space-y-6">
              <!-- Experiment Header -->
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-100 pb-4">
                <div>
                  <div class="flex items-center gap-3">
                    <h3 class="text-lg font-bold text-slate-900">{report.experiment.name}</h3>
                    <Badge variant={report.experiment.status === 'running' ? 'default' : 'outline'}>
                      {report.experiment.status.toUpperCase()}
                    </Badge>
                  </div>
                  <p class="text-xs text-slate-500 mt-1">
                    Placement: <span class="font-mono font-medium text-slate-700">{report.experiment.target_placement}</span> • Metric: <span class="font-medium text-slate-700">{report.experiment.primary_metric}</span>
                  </p>
                </div>

                <div class="flex items-center gap-2">
                  {report.experiment.status === 'running' ? (
                    <button
                      onclick={`toggleExperiment('${report.experiment.id}', 'paused')`}
                      class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-800 text-xs font-semibold rounded-lg border border-amber-200 transition"
                    >
                      ⏸ Pause Experiment
                    </button>
                  ) : (
                    <button
                      onclick={`toggleExperiment('${report.experiment.id}', 'running')`}
                      class="px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-emerald-800 text-xs font-semibold rounded-lg border border-emerald-200 transition"
                    >
                      ▶ Start Experiment
                    </button>
                  )}
                </div>
              </div>

              <!-- Status Notice -->
              <div class="p-3.5 bg-slate-50 rounded-xl border border-slate-100 flex items-center justify-between">
                <span class="text-xs font-medium text-slate-700">
                  {report.statusMessage}
                </span>
                <span class="text-xs text-slate-500 font-mono">
                  {report.totalParticipants} Participants • {report.totalConversions} Conversions
                </span>
              </div>

              <!-- Variants Performance Table -->
              <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-slate-600">
                  <thead class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                    <tr>
                      <th class="py-2.5 px-4">Variant</th>
                      <th class="py-2.5 px-4 text-center">Role</th>
                      <th class="py-2.5 px-4 text-center">Participants</th>
                      <th class="py-2.5 px-4 text-center">Conversions</th>
                      <th class="py-2.5 px-4 text-center">Conversion Rate</th>
                      <th class="py-2.5 px-4 text-center">Uplift vs Control</th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-slate-100">
                    {report.variants.map((v) => (
                      <tr>
                        <td class="py-3 px-4 font-semibold text-slate-900">{v.name}</td>
                        <td class="py-3 px-4 text-center">
                          {v.isControl ? (
                            <span class="text-xs bg-slate-100 text-slate-700 px-2 py-0.5 rounded font-mono">Control</span>
                          ) : (
                            <span class="text-xs bg-indigo-50 text-indigo-700 px-2 py-0.5 rounded font-mono">Variant</span>
                          )}
                        </td>
                        <td class="py-3 px-4 text-center font-medium">{v.participants}</td>
                        <td class="py-3 px-4 text-center font-medium text-indigo-600">{v.conversions}</td>
                        <td class="py-3 px-4 text-center font-bold text-slate-900">{v.conversionRate}%</td>
                        <td class="py-3 px-4 text-center">
                          {v.isControl ? (
                            <span class="text-xs text-slate-400">Baseline</span>
                          ) : (
                            <span class={`text-xs font-bold ${v.upliftPercentage >= 0 ? 'text-emerald-600' : 'text-rose-600'}`}>
                              {v.upliftPercentage >= 0 ? `+${v.upliftPercentage}%` : `${v.upliftPercentage}%`}
                            </span>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </Card>
        ))}
      </div>
    )}
  </div>

  <script is:inline>
    async function toggleExperiment(experimentId, status) {
      try {
        const res = await fetch('/api/admin/growth/experiments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'set_status', experimentId, status })
        });
        const data = await res.json();
        if (data.success) {
          window.location.reload();
        } else {
          alert(data.error?.message || 'Failed to toggle experiment');
        }
      } catch {
        alert('Network error updating experiment status');
      }
    }
  </script>
</AdminLayout>
