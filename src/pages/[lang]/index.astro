---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import { ConfigService } from '@/services/config.service';
import { AssessmentService } from '@/services/assessment.service';
import { CreditService } from '@/services/credit.service';
import { getD1Database } from '@/lib/db/client';
import {
  type SupportedLocale,
  isValidLocale,
  getLocalizedPath,
  normalizeLocale
} from '@/i18n';
import { getLandingTranslations } from '@/i18n/landing';
import { TranslationsService } from '@/i18n/translations.service';

export const prerender = false;

const { lang } = Astro.params;
if (!isValidLocale(lang)) {
  return Astro.redirect('/404');
}

const currentLocale = lang as SupportedLocale;
const lt = getLandingTranslations(currentLocale);

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);

// 1. Dynamic Site Config
const configService = new ConfigService(db);
const config = await configService.getSiteConfig();

// 2. Dynamic Categories & Published/Featured Assessments
const assessmentService = new AssessmentService(db);
const transService = new TranslationsService(db);

const rawCategories = await assessmentService.getCategories();
let rawFeaturedAssessments = await assessmentService.getFeaturedAssessments();

if (rawFeaturedAssessments.length === 0) {
  const allAssessments = await assessmentService.getPublishedAssessments();
  rawFeaturedAssessments = allAssessments.slice(0, 6);
}

// Fallback seed assessments for safe rendering
if (rawFeaturedAssessments.length === 0) {
  rawFeaturedAssessments = [
    {
      id: 'asm_big_five',
      category_id: 'cat_personality',
      category_name: 'Personality',
      name: 'Big Five (OCEAN) Personality Test',
      slug: 'big-five-personality-test',
      short_description: 'Explore your tendencies across Openness, Conscientiousness, Extraversion, Agreeableness, and Emotional Stability.',
      estimated_minutes: 6,
      question_count: 25,
      access_type: 'free',
      status: 'published',
      featured: 1,
      display_order: 1,
      version: 1,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    },
    {
      id: 'asm_openness',
      category_id: 'cat_personality',
      category_name: 'Personality',
      name: 'Openness to Experience Test',
      slug: 'openness-to-experience-test',
      short_description: 'Explore how you tend to approach new ideas, imagination, intellectual curiosity, and creative pursuits.',
      estimated_minutes: 6,
      question_count: 25,
      access_type: 'free',
      status: 'published',
      featured: 1,
      display_order: 2,
      version: 1,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    },
    {
      id: 'asm_attachment',
      category_id: 'cat_relationships',
      category_name: 'Relationships',
      name: 'Adult Attachment Style Test',
      slug: 'adult-attachment-style',
      short_description: 'Reflect on how you relate to closeness, emotional security, communication, and independence in relationships.',
      estimated_minutes: 6,
      question_count: 25,
      access_type: 'free',
      status: 'published',
      featured: 1,
      display_order: 3,
      version: 1,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    },
    {
      id: 'asm_eq',
      category_id: 'cat_eq',
      category_name: 'Emotional Intelligence',
      name: 'Emotional Intelligence (EQ) Test',
      slug: 'emotional-intelligence-eq',
      short_description: 'Examine your emotional awareness, empathy, self-reflection, and social adaptability in daily life.',
      estimated_minutes: 6,
      question_count: 25,
      access_type: 'free',
      status: 'published',
      featured: 1,
      display_order: 4,
      version: 1,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    },
    {
      id: 'asm_career',
      category_id: 'cat_career',
      category_name: 'Career & Work',
      name: 'Workplace Motivation & Style Test',
      slug: 'work-style-test',
      short_description: 'Understand what energizes your work, leadership instincts, problem-solving, and professional collaboration.',
      estimated_minutes: 6,
      question_count: 25,
      access_type: 'free',
      status: 'published',
      featured: 1,
      display_order: 5,
      version: 1,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    },
    {
      id: 'asm_mindset',
      category_id: 'cat_mindset',
      category_name: 'Self-Development',
      name: 'Resilience & Adaptability Test',
      slug: 'resilience-test',
      short_description: 'Gain perspective on how you navigate setbacks, handle uncertainty, and maintain constructive focus under stress.',
      estimated_minutes: 5,
      question_count: 20,
      access_type: 'free',
      status: 'published',
      featured: 1,
      display_order: 6,
      version: 1,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    }
  ];
}

// Localize Categories
const categories = await Promise.all(
  rawCategories.map(async (cat) => {
    const loc = await transService.getLocalizedCategory(cat.id, currentLocale);
    return {
      ...cat,
      name: loc?.name || cat.name,
      description: loc?.description || cat.description
    };
  })
);
const categoryMap = new Map(categories.map((c) => [c.id, c.name]));

// Localize Featured Assessments
const featuredAssessments = await Promise.all(
  rawFeaturedAssessments.map(async (asm) => {
    const loc = await transService.getLocalizedAssessment(asm.id, currentLocale);
    return {
      ...asm,
      name: loc?.name || asm.name,
      short_description: loc?.shortDescription || asm.short_description,
      category_name: (asm.category_id && categoryMap.get(asm.category_id)) || asm.category_name
    };
  })
);

// 3. Dynamic Credit Economics
const creditService = new CreditService(db);
const reportCost = await creditService.getReportCreditCost();

// 4. Structured Data Schemas
const siteUrl = config.siteUrl || 'https://psychologycalculator.com';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: config.siteName,
  url: `${siteUrl}/${currentLocale}`,
  description: lt.hero.subtitle,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/${currentLocale}/assessments?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: config.siteName,
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: lt.popular.title,
  itemListElement: featuredAssessments.slice(0, 6).map((asm, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `${siteUrl}/${currentLocale}/assessments/${asm.slug}`,
    name: asm.name,
    description: asm.short_description
  }))
};

const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: lt.faqs.items.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};

const localizedHomeTitles: Record<SupportedLocale, string> = {
  en: 'Psychology Tests & Assessments',
  es: 'Tests Psicológicos y de Personalidad',
  fr: 'Tests Psychologiques & Personnalité',
  de: 'Psychologische Tests & Analysen',
  pt: 'Testes Psicológicos & Personalidade',
  hi: 'मनोवैज्ञानिक परीक्षण व व्यक्तित्व'
};
---

<PublicLayout
  title={localizedHomeTitles[currentLocale] || 'Psychology Tests & Assessments'}
  description={lt.hero.subtitle}
  locale={currentLocale}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
  </Fragment>

  <!-- 1. Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 via-teal-50/20 to-white pt-12 pb-16 sm:pt-20 sm:pb-24 border-b border-slate-200/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <!-- Left Hero Copy -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-teal-50 border border-teal-200/80 rounded-full text-teal-800 text-[11px] font-bold tracking-wider uppercase">
            <span>✦</span>
            <span>{lt.hero.badge}</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.12] text-balance">
            {lt.hero.title} <span class="text-teal-700">{lt.hero.titleHighlight}</span>
          </h1>

          <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto lg:mx-0">
            {lt.hero.subtitle}
          </p>

          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
            <a
              href={getLocalizedPath('/assessments/big-five-personality-test', currentLocale)}
              class="w-full sm:w-auto px-7 py-3.5 bg-teal-600 hover:bg-teal-700 text-white text-sm font-extrabold rounded-2xl shadow-md hover:shadow-lg transition-all text-center flex items-center justify-center gap-2 group cursor-pointer"
            >
              <span>{lt.hero.ctaPrimary}</span>
              <span class="group-hover:translate-x-0.5 transition-transform">→</span>
            </a>
            <a
              href={getLocalizedPath('/assessments', currentLocale)}
              class="w-full sm:w-auto px-6 py-3.5 bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 rounded-2xl text-sm font-bold transition-all text-center cursor-pointer"
            >
              {lt.hero.ctaSecondary}
            </a>
          </div>

          <!-- Micro-Trust Line -->
          <div class="pt-3 flex flex-wrap items-center justify-center lg:justify-start gap-x-5 gap-y-2 text-xs text-slate-500 font-medium">
            {lt.hero.trustItems.map((item) => (
              <span class="flex items-center gap-1.5">
                <span class="text-teal-600 font-bold">✓</span> {item}
              </span>
            ))}
          </div>
        </div>

        <!-- Right Hero Interactive Visual (Assessment & Dimension Preview) -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-full max-w-md bg-white rounded-3xl border border-slate-200/90 shadow-xl p-6 sm:p-7 space-y-5">
            <!-- Header of Preview Card -->
            <div class="flex items-center justify-between border-b border-slate-100 pb-4">
              <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700 block">{lt.hero.preview.tag}</span>
                <h3 class="text-sm font-black text-slate-900">{lt.hero.preview.title}</h3>
              </div>
              <span class="px-2.5 py-1 text-[10px] font-mono font-bold bg-teal-50 text-teal-800 border border-teal-200/60 rounded-full">
                {lt.hero.preview.alignment}
              </span>
            </div>

            <!-- Active Question Sample -->
            <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100 space-y-2">
              <div class="flex items-center justify-between text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                <span>{lt.hero.preview.questionLabel}</span>
                <span class="text-teal-700">{lt.hero.preview.questionTopic}</span>
              </div>
              <p class="text-xs font-semibold text-slate-800 leading-snug">
                {lt.hero.preview.questionText}
              </p>
              <div class="flex gap-1.5 pt-1">
                <span class="h-1.5 flex-1 rounded-full bg-slate-200"></span>
                <span class="h-1.5 flex-1 rounded-full bg-slate-200"></span>
                <span class="h-1.5 flex-1 rounded-full bg-slate-200"></span>
                <span class="h-1.5 flex-1 rounded-full bg-teal-500"></span>
                <span class="h-1.5 flex-1 rounded-full bg-slate-200"></span>
              </div>
            </div>

            <!-- Dimensional Breakdown Bars -->
            <div class="space-y-3 pt-1">
              <span class="text-[11px] font-bold text-slate-700 block">{lt.hero.preview.breakdownTitle}</span>
              
              {lt.hero.preview.dimensions.map((dim) => (
                <div class="space-y-1">
                  <div class="flex justify-between text-xs font-medium">
                    <span class="text-slate-700 font-semibold">{dim.name}</span>
                    <span class="text-teal-700 font-mono font-bold">{dim.pct}%</span>
                  </div>
                  <div class="h-2 w-full bg-slate-100 rounded-full overflow-hidden">
                    <div class="h-full bg-teal-500 rounded-full" style={`width: ${dim.pct}%`}></div>
                  </div>
                </div>
              ))}
            </div>

            <!-- Footer Badge -->
            <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
              <span>✓ {lt.hero.preview.freeResult}</span>
              <a href={getLocalizedPath('/assessments', currentLocale)} class="text-teal-700 font-bold hover:underline">
                {lt.hero.preview.explorePatterns}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Trust / Value Strip -->
  <section class="py-10 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 lg:gap-8">
        <div class="space-y-1">
          <div class="text-xs font-black text-slate-900 tracking-wider uppercase flex items-center gap-1.5">
            <span class="text-teal-600">✦</span> {lt.trustStrip.title1}
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            {lt.trustStrip.desc1}
          </p>
        </div>

        <div class="space-y-1">
          <div class="text-xs font-black text-slate-900 tracking-wider uppercase flex items-center gap-1.5">
            <span class="text-teal-600">✦</span> {lt.trustStrip.title2}
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            {lt.trustStrip.desc2}
          </p>
        </div>

        <div class="space-y-1">
          <div class="text-xs font-black text-slate-900 tracking-wider uppercase flex items-center gap-1.5">
            <span class="text-teal-600">✦</span> {lt.trustStrip.title3}
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            {lt.trustStrip.desc3}
          </p>
        </div>

        <div class="space-y-1">
          <div class="text-xs font-black text-slate-900 tracking-wider uppercase flex items-center gap-1.5">
            <span class="text-teal-600">✦</span> {lt.trustStrip.title4}
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            {lt.trustStrip.desc4}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Why Use Platform / Approach -->
  <section id="about" class="py-16 sm:py-24 bg-slate-50/60 border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center space-y-4 max-w-2xl mx-auto">
        <Badge variant="default" size="sm">{lt.approach.badge}</Badge>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          {lt.approach.title}
        </h2>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          {lt.approach.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-4 text-center">
        {lt.approach.steps.map((step) => (
          <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-2xs space-y-2">
            <div class="w-8 h-8 rounded-full bg-teal-50 text-teal-700 font-bold text-xs flex items-center justify-center mx-auto">{step.num}</div>
            <h3 class="text-xs font-bold text-slate-900">{step.title}</h3>
            <p class="text-[11px] text-slate-500">{step.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Assessment Categories Section -->
  <section id="categories" class="py-16 sm:py-24 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center space-y-3 max-w-2xl mx-auto">
        <Badge variant="info" size="sm">{lt.categories.badge}</Badge>
        <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">
          {lt.categories.title}
        </h2>
        <p class="text-sm sm:text-base text-slate-600">
          {lt.categories.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Category 1: Personality -->
        <div class="p-7 rounded-3xl bg-slate-50/70 border border-slate-200/90 hover:border-teal-300 hover:shadow-md transition-all flex flex-col justify-between space-y-6 group">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-2xl">🧠</span>
              <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full border border-teal-200/60">
                {lt.categories.personality.tag}
              </span>
            </div>
            <div class="space-y-1.5">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-teal-700 transition-colors">
                {lt.categories.personality.title}
              </h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                {lt.categories.personality.desc}
              </p>
            </div>
            <ul class="text-xs text-slate-600 space-y-1.5 pt-1 border-t border-slate-200/60">
              {lt.categories.personality.tests.map((tItem) => (
                <li class="flex items-center gap-1.5"><span>•</span> {tItem}</li>
              ))}
            </ul>
          </div>
          <a
            href={getLocalizedPath('/assessments/category/personality', currentLocale)}
            class="text-xs font-bold text-teal-700 hover:text-teal-800 inline-flex items-center gap-1 pt-2"
          >
            <span>{lt.categories.personality.cta}</span>
            <span>→</span>
          </a>
        </div>

        <!-- Category 2: Relationships -->
        <div class="p-7 rounded-3xl bg-slate-50/70 border border-slate-200/90 hover:border-teal-300 hover:shadow-md transition-all flex flex-col justify-between space-y-6 group">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-2xl">🤝</span>
              <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full border border-teal-200/60">
                {lt.categories.relationships.tag}
              </span>
            </div>
            <div class="space-y-1.5">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-teal-700 transition-colors">
                {lt.categories.relationships.title}
              </h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                {lt.categories.relationships.desc}
              </p>
            </div>
            <ul class="text-xs text-slate-600 space-y-1.5 pt-1 border-t border-slate-200/60">
              {lt.categories.relationships.tests.map((tItem) => (
                <li class="flex items-center gap-1.5"><span>•</span> {tItem}</li>
              ))}
            </ul>
          </div>
          <a
            href={getLocalizedPath('/assessments/category/relationships', currentLocale)}
            class="text-xs font-bold text-teal-700 hover:text-teal-800 inline-flex items-center gap-1 pt-2"
          >
            <span>{lt.categories.relationships.cta}</span>
            <span>→</span>
          </a>
        </div>

        <!-- Category 3: Emotional Intelligence -->
        <div class="p-7 rounded-3xl bg-slate-50/70 border border-slate-200/90 hover:border-teal-300 hover:shadow-md transition-all flex flex-col justify-between space-y-6 group">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-2xl">🌱</span>
              <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full border border-teal-200/60">
                {lt.categories.eq.tag}
              </span>
            </div>
            <div class="space-y-1.5">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-teal-700 transition-colors">
                {lt.categories.eq.title}
              </h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                {lt.categories.eq.desc}
              </p>
            </div>
            <ul class="text-xs text-slate-600 space-y-1.5 pt-1 border-t border-slate-200/60">
              {lt.categories.eq.tests.map((tItem) => (
                <li class="flex items-center gap-1.5"><span>•</span> {tItem}</li>
              ))}
            </ul>
          </div>
          <a
            href={getLocalizedPath('/assessments/category/emotional-intelligence', currentLocale)}
            class="text-xs font-bold text-teal-700 hover:text-teal-800 inline-flex items-center gap-1 pt-2"
          >
            <span>{lt.categories.eq.cta}</span>
            <span>→</span>
          </a>
        </div>

        <!-- Category 4: Career & Work Style -->
        <div class="p-7 rounded-3xl bg-slate-50/70 border border-slate-200/90 hover:border-teal-300 hover:shadow-md transition-all flex flex-col justify-between space-y-6 group">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-2xl">💼</span>
              <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full border border-teal-200/60">
                {lt.categories.career.tag}
              </span>
            </div>
            <div class="space-y-1.5">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-teal-700 transition-colors">
                {lt.categories.career.title}
              </h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                {lt.categories.career.desc}
              </p>
            </div>
            <ul class="text-xs text-slate-600 space-y-1.5 pt-1 border-t border-slate-200/60">
              {lt.categories.career.tests.map((tItem) => (
                <li class="flex items-center gap-1.5"><span>•</span> {tItem}</li>
              ))}
            </ul>
          </div>
          <a
            href={getLocalizedPath('/assessments/category/career-work', currentLocale)}
            class="text-xs font-bold text-teal-700 hover:text-teal-800 inline-flex items-center gap-1 pt-2"
          >
            <span>{lt.categories.career.cta}</span>
            <span>→</span>
          </a>
        </div>

        <!-- Category 5: Self-Development & Resilience -->
