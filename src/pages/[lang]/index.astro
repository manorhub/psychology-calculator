---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import { ConfigService } from '@/services/config.service';
import { AssessmentService } from '@/services/assessment.service';
import { CreditService } from '@/services/credit.service';
import { getD1Database } from '@/lib/db/client';
import {
  type SupportedLocale,
  isValidLocale,
  useTranslations,
  getLocalizedPath,
  normalizeLocale
} from '@/i18n';
import { TranslationsService } from '@/i18n/translations.service';

export const prerender = false;

const { lang } = Astro.params;
if (!isValidLocale(lang)) {
  return Astro.redirect('/404');
}

const currentLocale = lang as SupportedLocale;
const { t } = useTranslations(currentLocale);

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);

// 1. Dynamic Site Config
const configService = new ConfigService(db);
const config = await configService.getSiteConfig();

// 2. Dynamic Categories & Published/Featured Assessments
const assessmentService = new AssessmentService(db);
const transService = new TranslationsService(db);

const rawCategories = await assessmentService.getCategories();
let rawFeaturedAssessments = await assessmentService.getFeaturedAssessments();

if (rawFeaturedAssessments.length === 0) {
  const allAssessments = await assessmentService.getPublishedAssessments();
  rawFeaturedAssessments = allAssessments.slice(0, 6);
}

// Localize Categories
const categories = await Promise.all(
  rawCategories.map(async (cat) => {
    const loc = await transService.getLocalizedCategory(cat.id, currentLocale);
    return {
      ...cat,
      name: loc?.name || cat.name,
      description: loc?.description || cat.description
    };
  })
);

// Localize Featured Assessments
const featuredAssessments = await Promise.all(
  rawFeaturedAssessments.map(async (asm) => {
    const loc = await transService.getLocalizedAssessment(asm.id, currentLocale);
    return {
      ...asm,
      name: loc?.name || asm.name,
      short_description: loc?.shortDescription || asm.short_description
    };
  })
);

// 3. Credit Packages
const creditService = new CreditService(db);
const creditPackages = await creditService.getActivePackages();

const categoryColorMap: Record<string, { bg: string; text: string; border: string }> = {
  personality: { bg: 'bg-indigo-50', text: 'text-indigo-700', border: 'border-indigo-100' },
  relationships: { bg: 'bg-rose-50', text: 'text-rose-700', border: 'border-rose-100' },
  'emotional-intelligence': { bg: 'bg-teal-50', text: 'text-teal-700', border: 'border-teal-100' },
  'self-development': { bg: 'bg-amber-50', text: 'text-amber-700', border: 'border-amber-100' },
  communication: { bg: 'bg-sky-50', text: 'text-sky-700', border: 'border-sky-100' },
  default: { bg: 'bg-slate-50', text: 'text-slate-700', border: 'border-slate-100' }
};
---

<PublicLayout
  title={t.hero.title}
  description={t.hero.subtitle}
  locale={currentLocale}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-16 sm:pt-20 sm:pb-24 bg-gradient-to-b from-teal-50/40 via-white to-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="text-center max-w-3xl mx-auto space-y-6 sm:space-y-8">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-teal-50 border border-teal-200/80 text-teal-800 text-xs font-semibold shadow-2xs">
          <span>✨</span>
          <span>{t.hero.badge}</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-tight">
          {t.hero.title}
        </h1>

        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          {t.hero.subtitle}
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
          <a
            href={getLocalizedPath('/assessments', currentLocale)}
            class="w-full sm:w-auto px-7 py-3.5 bg-teal-600 hover:bg-teal-700 text-white font-bold text-sm rounded-2xl shadow-sm hover:shadow-md transition-all text-center"
          >
            {t.hero.ctaPrimary} →
          </a>
          <a
            href={getLocalizedPath('/pricing', currentLocale)}
            class="w-full sm:w-auto px-7 py-3.5 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-sm rounded-2xl border border-slate-200 shadow-2xs transition-all text-center"
          >
            {t.hero.ctaSecondary}
          </a>
        </div>

        <!-- Metric Badges -->
        <div class="grid grid-cols-3 gap-2 sm:gap-4 pt-6 max-w-xl mx-auto border-t border-slate-200/60">
          <div>
            <div class="text-base sm:text-xl font-bold text-slate-900 font-mono">37+</div>
            <div class="text-[11px] text-slate-500 font-medium mt-0.5">{t.hero.statAssessments}</div>
          </div>
          <div class="border-x border-slate-200/60">
            <div class="text-base sm:text-xl font-bold text-slate-900 font-mono">250k+</div>
            <div class="text-[11px] text-slate-500 font-medium mt-0.5">{t.hero.statTakers}</div>
          </div>
          <div>
            <div class="text-base sm:text-xl font-bold text-teal-700 font-mono">100%</div>
            <div class="text-[11px] text-slate-500 font-medium mt-0.5">{t.hero.statAccuracy}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Assessments Grid -->
  <section class="py-16 sm:py-20 bg-white border-y border-slate-200/80">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div class="space-y-2">
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            {t.common.exploreAssessments}
          </h2>
          <p class="text-sm text-slate-600">
            {t.common.tagline}
          </p>
        </div>

        <a
          href={getLocalizedPath('/assessments', currentLocale)}
          class="inline-flex items-center gap-1 text-sm font-semibold text-teal-700 hover:text-teal-800"
        >
          <span>{t.common.viewDetails}</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {featuredAssessments.map((asm) => (
          <div class="p-6 bg-white rounded-3xl border border-slate-200/90 shadow-2xs hover:border-teal-300 hover:shadow-md transition-all flex flex-col justify-between space-y-5 group">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-1 bg-teal-50 text-teal-800 text-[11px] font-bold rounded-lg border border-teal-200/60">
                  {asm.category_name || t.common.freeAssessment}
                </span>
                <span class="text-xs text-slate-400 font-mono">~{asm.estimated_minutes || 6} {t.common.minutes}</span>
              </div>

              <h3 class="text-lg font-bold text-slate-900 group-hover:text-teal-700 transition-colors">
                <a href={getLocalizedPath(`/assessments/${asm.slug}`, currentLocale)}>
                  {asm.name}
                </a>
              </h3>

              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed line-clamp-3">
                {asm.short_description}
              </p>
            </div>

            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs font-semibold text-slate-500">✓ {t.common.freeAssessment}</span>
              <a
                href={getLocalizedPath(`/assessments/${asm.slug}`, currentLocale)}
                class="inline-flex items-center gap-1 px-3.5 py-1.5 text-xs font-bold text-teal-700 hover:text-white bg-teal-50 hover:bg-teal-600 rounded-xl transition-all"
              >
                <span>{t.common.continue}</span>
                <span>→</span>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section class="py-16 sm:py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      <div class="text-center max-w-2xl mx-auto space-y-2">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          {t.nav.categories}
        </h2>
        <p class="text-sm text-slate-600">
          {t.hero.subtitle}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {categories.map((cat) => (
          <a
            href={getLocalizedPath(`/assessments/category/${cat.slug}`, currentLocale)}
            class="p-6 bg-white rounded-3xl border border-slate-200/90 shadow-2xs hover:border-teal-300 hover:shadow-md transition-all space-y-3 group block"
          >
            <h3 class="text-base font-bold text-slate-900 group-hover:text-teal-700 transition-colors">
              {cat.name}
            </h3>
            <p class="text-xs text-slate-600 leading-relaxed line-clamp-2">
              {cat.description}
            </p>
            <div class="text-xs font-semibold text-teal-700 pt-2 flex items-center gap-1">
              <span>{t.common.exploreAssessments}</span>
              <span>→</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</PublicLayout>
