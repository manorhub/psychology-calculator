---
import PublicLayout from '@/layouts/PublicLayout.astro';
import {
  type SupportedLocale,
  isValidLocale,
  useTranslations
} from '@/i18n';

export const prerender = false;

const { lang } = Astro.params;
if (!isValidLocale(lang)) {
  return Astro.redirect('/404');
}

const currentLocale = lang as SupportedLocale;
const { t } = useTranslations(currentLocale);
---

<PublicLayout
  title={`${t.footer.privacyPolicy} | PsychologyCalculator.com`}
  description="PsychologyCalculator.com Privacy Policy. Learn how your psychometric responses and account data are protected."
  locale={currentLocale}
>
  <div class="max-w-4xl mx-auto py-12 sm:py-20 px-4 sm:px-6 lg:px-8 space-y-10">
    <div class="space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-teal-50 text-teal-800 text-xs font-bold rounded-full border border-teal-200">
        <span>🛡️</span> {t.footer.privacyPolicy}
      </div>
      <h1 class="text-3xl sm:text-5xl font-black text-slate-900 tracking-tight">
        {t.footer.privacyPolicy}
      </h1>
      <p class="text-xs text-slate-500 font-mono">
        Last Updated: August 2026
      </p>
    </div>

    <div class="prose prose-slate max-w-none space-y-6 text-sm sm:text-base text-slate-700 leading-relaxed bg-white p-6 sm:p-10 rounded-3xl border border-slate-200 shadow-2xs">
      <h2 class="text-xl font-bold text-slate-900">1. Information We Collect</h2>
      <p>
        When you take an assessment as a guest, we do not require your name or email. Responses are evaluated in real time to compute dimension scores. If you create an account, we store your email address, encrypted credentials, and completed assessment history.
      </p>

      <h2 class="text-xl font-bold text-slate-900">2. How Assessment Data Is Used</h2>
      <p>
        Your assessment answers are processed strictly to calculate dimensional scores, determine trait archetypes, and generate requested AI psychometric dossiers. We never sell, rent, or monetize your individual responses.
      </p>

      <h2 class="text-xl font-bold text-slate-900">3. Encryption & Storage Security</h2>
      <p>
        All communications between your browser and our edge servers are protected using Transport Layer Security (TLS 1.3). Sensitive account information and transaction ledgers are stored securely on Cloudflare D1 distributed databases.
      </p>

      <h2 class="text-xl font-bold text-slate-900">4. Your Data Rights & Deletion</h2>
      <p>
        You have the right to export your assessment history or permanently delete your account at any time via your Profile Settings.
      </p>
    </div>
  </div>
</PublicLayout>
