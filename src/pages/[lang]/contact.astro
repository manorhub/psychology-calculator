---
import PublicLayout from '@/layouts/PublicLayout.astro';
import {
  type SupportedLocale,
  isValidLocale,
  useTranslations,
  getLocalizedPath
} from '@/i18n';

export const prerender = false;

const { lang } = Astro.params;
if (!isValidLocale(lang)) {
  return Astro.redirect('/404');
}

const currentLocale = lang as SupportedLocale;
const { t } = useTranslations(currentLocale);
---

<PublicLayout
  title={`${t.nav.contact} | PsychologyCalculator.com`}
  description="Contact the PsychologyCalculator.com research and support team."
  locale={currentLocale}
>
  <div class="max-w-3xl mx-auto py-12 sm:py-20 px-4 sm:px-6 lg:px-8 space-y-10">
    <div class="space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-teal-50 text-teal-800 text-xs font-bold rounded-full border border-teal-200">
        <span>✉️</span> {t.nav.contact}
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-slate-900 tracking-tight">
        Get in Touch
      </h1>
      <p class="text-sm sm:text-base text-slate-600">
        Have questions regarding an assessment, credit purchases, or research methodology? We're here to help.
      </p>
    </div>

    <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-200 shadow-2xs space-y-6">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100 space-y-1">
          <div class="text-xs font-bold text-slate-400 uppercase">Support Email</div>
          <div class="text-sm font-semibold text-slate-900">support@psychologycalculator.com</div>
        </div>
        <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100 space-y-1">
          <div class="text-xs font-bold text-slate-400 uppercase">Average Response Time</div>
          <div class="text-sm font-semibold text-slate-900">&lt; 24 Business Hours</div>
        </div>
      </div>

      <form class="space-y-4" onsubmit="event.preventDefault(); alert('Message received. Our support team will reach out shortly.');">
        <div class="space-y-1">
          <label class="text-xs font-bold text-slate-700">{t.auth.nameLabel}</label>
          <input type="text" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-600" />
        </div>
        <div class="space-y-1">
          <label class="text-xs font-bold text-slate-700">{t.auth.emailLabel}</label>
          <input type="email" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-600" />
        </div>
        <div class="space-y-1">
          <label class="text-xs font-bold text-slate-700">Message</label>
          <textarea rows="4" required class="w-full px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-teal-600"></textarea>
        </div>
        <button type="submit" class="w-full py-3 bg-teal-600 hover:bg-teal-700 text-white font-bold text-xs rounded-xl transition-all shadow-xs">
          {t.common.submit} Message →
        </button>
      </form>
    </div>
  </div>
</PublicLayout>
