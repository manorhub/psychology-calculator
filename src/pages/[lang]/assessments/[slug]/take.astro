---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getD1Database } from '@/lib/db/client';
import { AssessmentRuntimeService } from '@/services/assessment-runtime.service';
import {
  type SupportedLocale,
  isValidLocale,
  useTranslations,
  getLocalizedPath
} from '@/i18n';
import { TranslationsService } from '@/i18n/translations.service';

export const prerender = false;

const { lang, slug } = Astro.params;
if (!isValidLocale(lang) || !slug) {
  return Astro.redirect('/404');
}

const currentLocale = lang as SupportedLocale;
const { t } = useTranslations(currentLocale);

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const runtimeService = new AssessmentRuntimeService(db);
const transService = new TranslationsService(db);

const assessmentData = await runtimeService.getPublishedAssessmentBySlug(slug);
if (!assessmentData) {
  return new Response('Assessment Not Found or not published', { status: 404 });
}

const { assessment: rawAssessment, questions: rawQuestions, dimensions: rawDimensions, category: rawCategory } = assessmentData;
const estimatedMinutes = rawAssessment.estimated_minutes || Math.max(3, Math.ceil(rawQuestions.length * 0.25));

// Localize Assessment Content
const locAsm = await transService.getLocalizedAssessment(rawAssessment.id, currentLocale);
const assessment = {
  ...rawAssessment,
  name: locAsm?.name || rawAssessment.name,
  short_description: locAsm?.shortDescription || rawAssessment.short_description
};

// Localize Category
const locCat = rawCategory ? await transService.getLocalizedCategory(rawCategory.id, currentLocale) : null;
const category = rawCategory
  ? {
      ...rawCategory,
      name: locCat?.name || rawCategory.name
    }
  : null;

// Localize Dimensions Map
const dimensionMap = new Map<string, { id: string; name: string; description: string }>();
for (const d of rawDimensions) {
  const locDim = await transService.getLocalizedDimension(d.id, currentLocale);
  dimensionMap.set(d.id, {
    id: d.id,
    name: locDim?.name || d.name,
    description: locDim?.description || d.description || ''
  });
}

// Localize Questions Map
const questionTransMap = await transService.getLocalizedQuestionsMap(rawAssessment.id, currentLocale);

// Standard Likert option texts
const likertLabels: Record<string, string> = {
  '1': t.runner.stronglyDisagree,
  '2': t.runner.disagree,
  '3': t.runner.neutral,
  '4': t.runner.agree,
  '5': t.runner.stronglyAgree
};

// Enrich questions
const questions = rawQuestions.map((q, idx) => {
  const dId = q.dimension_id || 'general';
  const dim = dimensionMap.get(dId);
  const localizedText = questionTransMap.get(q.id) || q.question_text;

  // Localize options if likert 1-5
  const options = (q.options || []).map((opt) => {
    const val = String(opt.option_value || '');
    return {
      ...opt,
      option_text: likertLabels[val] || opt.option_text
    };
  });

  return {
    ...q,
    question_text: localizedText,
    dimensionId: dId,
    dimensionName: dim?.name || category?.name || 'Psychological Construct',
    dimensionDescription: dim?.description || '',
    options
  };
});

// Handle guest session
const currentUser = Astro.locals.user;
let guestSessionId = Astro.cookies.get('mm_guest_id')?.value || null;
if (!currentUser && !guestSessionId) {
  guestSessionId = crypto.randomUUID();
  Astro.cookies.set('mm_guest_id', guestSessionId, {
    path: '/',
    httpOnly: true,
    secure: import.meta.env.PROD,
    sameSite: 'lax',
    maxAge: 30 * 24 * 60 * 60
  });
}

// Start SSR Attempt
const urlAttemptId = Astro.url.searchParams.get('attemptId');
let initialAttemptId = urlAttemptId || '';

if (!initialAttemptId) {
  try {
    const { attempt } = await runtimeService.startOrResumeAttempt(
      assessment.id,
      currentUser?.id || null,
      guestSessionId
    );
    initialAttemptId = attempt.id;
  } catch (err) {
    console.error('SSR attempt start error:', err);
  }
}
---

<BaseLayout
  title={`${assessment.name} | Psychology Calculator`}
  description={assessment.short_description || 'Psychology Assessment in progress'}
  locale={currentLocale}
>
  <div class="min-h-screen bg-slate-50 text-slate-900 flex flex-col justify-between">
    <!-- Top Bar -->
    <header class="bg-white/95 backdrop-blur-md border-b border-slate-200/80 sticky top-0 z-30 shadow-2xs">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 py-3.5 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <a
            href={getLocalizedPath(`/assessments/${rawAssessment.slug}`, currentLocale)}
            class="group inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-xl transition-all"
            title="Exit assessment"
          >
            <span>✕</span>
            <span class="hidden sm:inline">{t.common.back}</span>
          </a>
          <span class="text-xs font-bold text-slate-900 truncate max-w-xs">{assessment.name}</span>
        </div>

        <div class="flex items-center gap-3">
          <span id="progress-step-text" class="text-xs font-bold font-mono text-teal-800">
            1 of {questions.length}
          </span>
          <div class="w-24 sm:w-36 bg-slate-100 rounded-full h-2 overflow-hidden border border-slate-200">
            <div
              id="progress-bar"
              class="bg-teal-600 h-full rounded-full transition-all duration-300"
              style="width: 10%;"
            ></div>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Container -->
    <main class="flex-1 max-w-2xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-14 flex flex-col justify-center">
      <!-- Question Card Container -->
      <div id="question-container" class="bg-white rounded-3xl p-6 sm:p-10 border border-slate-200 shadow-2xs space-y-8">
        <!-- Dimension Badge -->
        <div class="space-y-1">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-teal-50 text-teal-800 text-xs font-bold rounded-full border border-teal-200">
            <span id="current-dimension-name">Dimension</span>
          </div>
          <p id="current-dimension-desc" class="text-xs text-slate-500 line-clamp-1"></p>
        </div>

        <!-- Question Text -->
        <div class="space-y-2">
          <h2 id="current-question-text" class="text-lg sm:text-2xl font-bold text-slate-900 leading-snug">
            Question text loading...
          </h2>
        </div>

        <!-- Options List -->
        <div id="options-container" class="space-y-3 pt-2">
          <!-- Dynamic Buttons Rendered via JS -->
        </div>

        <!-- Navigation Buttons -->
        <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
          <button
            type="button"
            id="prev-btn"
            class="px-4 py-2 text-xs font-bold text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-xl transition-all"
          >
            ← {t.runner.previousQuestion}
          </button>
          <button
            type="button"
            id="next-btn"
            class="px-6 py-2.5 text-xs font-bold text-white bg-teal-600 hover:bg-teal-700 rounded-xl shadow-xs transition-all"
          >
            {t.runner.nextQuestion} →
          </button>
        </div>
      </div>

      <!-- Processing State Modal -->
      <div id="calculating-overlay" class="hidden text-center py-16 space-y-4">
        <div class="w-12 h-12 border-4 border-teal-600 border-t-transparent rounded-full animate-spin mx-auto"></div>
        <h3 class="text-lg font-bold text-slate-900">{t.runner.preparingResults}</h3>
      </div>
    </main>

    <!-- Footer Notice -->
    <footer class="p-4 text-center text-xs text-slate-400 border-t border-slate-200/60">
      {t.runner.guestNotice}
    </footer>
  </div>
</BaseLayout>

<script is:inline define:vars={{ questionsData: questions, attemptId: initialAttemptId, locale: currentLocale, assessmentSlug: rawAssessment.slug }}>
  let currentIndex = 0;
  const userAnswers = new Map(); // questionId -> optionValue

  const qText = document.getElementById('current-question-text');
  const dimName = document.getElementById('current-dimension-name');
  const dimDesc = document.getElementById('current-dimension-desc');
  const optionsDiv = document.getElementById('options-container');
  const stepText = document.getElementById('progress-step-text');
  const progressBar = document.getElementById('progress-bar');
  const prevBtn = document.getElementById('prev-btn');
  const nextBtn = document.getElementById('next-btn');
  const qContainer = document.getElementById('question-container');
  const calcOverlay = document.getElementById('calculating-overlay');

  function renderCurrentQuestion() {
    const q = questionsData[currentIndex];
    if (!q) return;

    qText.textContent = q.question_text;
    dimName.textContent = q.dimensionName || 'Psychological Trait';
    dimDesc.textContent = q.dimensionDescription || '';
    stepText.textContent = `${currentIndex + 1} of ${questionsData.length}`;
    
    const pct = Math.round(((currentIndex + 1) / questionsData.length) * 100);
    progressBar.style.width = `${pct}%`;

    prevBtn.style.visibility = currentIndex === 0 ? 'hidden' : 'visible';
    nextBtn.textContent = currentIndex === questionsData.length - 1 ? 'Finish Assessment ✓' : 'Next →';

    optionsDiv.innerHTML = '';
    const selectedVal = userAnswers.get(q.id);

    (q.options || []).forEach((opt) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      const isSelected = selectedVal === String(opt.option_value);

      btn.className = `w-full text-left p-4 rounded-2xl border text-xs sm:text-sm font-semibold transition-all flex items-center justify-between cursor-pointer ${
        isSelected
          ? 'bg-teal-50 border-teal-500 text-teal-950 ring-2 ring-teal-500/20'
          : 'bg-white border-slate-200 text-slate-700 hover:border-teal-300 hover:bg-slate-50'
      }`;

      btn.innerHTML = `
        <span>${opt.option_text}</span>
        <span class="w-4 h-4 rounded-full border ${isSelected ? 'border-teal-600 bg-teal-600 text-white flex items-center justify-center text-[10px]' : 'border-slate-300'}">
          ${isSelected ? '✓' : ''}
        </span>
      `;

      btn.addEventListener('click', () => {
        userAnswers.set(q.id, String(opt.option_value));
        // Auto advance after small delay
        renderCurrentQuestion();
        setTimeout(() => {
          if (currentIndex < questionsData.length - 1) {
            currentIndex++;
            renderCurrentQuestion();
          }
        }, 180);
      });

      optionsDiv.appendChild(btn);
    });
  }

  prevBtn?.addEventListener('click', () => {
    if (currentIndex > 0) {
      currentIndex--;
      renderCurrentQuestion();
    }
  });

  nextBtn?.addEventListener('click', async () => {
    const q = questionsData[currentIndex];
    if (!userAnswers.has(q.id)) {
      alert('Please select an option to continue.');
      return;
    }

    if (currentIndex < questionsData.length - 1) {
      currentIndex++;
      renderCurrentQuestion();
    } else {
      // Submit assessment
      qContainer.classList.add('hidden');
      calcOverlay.classList.remove('hidden');

      const answersPayload = [];
      for (const [qId, val] of userAnswers.entries()) {
        answersPayload.push({
          questionId: qId,
          answerValue: val
        });
      }

      try {
        const res = await fetch(`/api/v1/assessments/attempts/${attemptId}/submit`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            answers: answersPayload,
            locale
          })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          window.location.href = `/assessments/result/${attemptId}?lang=${locale}`;
        } else {
          window.location.href = `/assessments/result/${attemptId}?lang=${locale}`;
        }
      } catch {
        window.location.href = `/assessments/result/${attemptId}?lang=${locale}`;
      }
    }
  });

  renderCurrentQuestion();
</script>
