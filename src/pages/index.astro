---
import PublicLayout from '@/layouts/PublicLayout.astro';
import Badge from '@/components/ui/Badge.astro';
import { ConfigService } from '@/services/config.service';
import { AssessmentService } from '@/services/assessment.service';
import { CreditService } from '@/services/credit.service';
import { getD1Database } from '@/lib/db/client';

export const prerender = false;

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);

// 1. Dynamic Site Config
const configService = new ConfigService(db);
const config = await configService.getSiteConfig();

// 2. Dynamic Categories & Published/Featured Assessments
const assessmentService = new AssessmentService(db);
const categories = await assessmentService.getCategories();
let featuredAssessments = await assessmentService.getFeaturedAssessments();

// Fallback published assessments if DB has not populated featured flags
if (featuredAssessments.length === 0) {
  const allAssessments = await assessmentService.getPublishedAssessments();
  featuredAssessments = allAssessments.slice(0, 6);
}

// Fallback seed assessments for safe rendering
if (featuredAssessments.length === 0) {
  featuredAssessments = [
    {
      id: 'asm_big_five',
      category_id: 'cat_personality',
      category_name: 'Personality',
      name: 'Big Five (OCEAN) Personality Test',
      slug: 'big-five-personality-test',
      short_description: 'Explore your tendencies across Openness, Conscientiousness, Extraversion, Agreeableness, and Emotional Stability.',
      estimated_minutes: 6,
      question_count: 25,
      access_type: 'free',
      status: 'published',
      featured: 1,
      display_order: 1,
      version: 1,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    },
    {
      id: 'asm_openness',
      category_id: 'cat_personality',
      category_name: 'Personality',
      name: 'Openness to Experience Test',
      slug: 'openness-to-experience-test',
      short_description: 'Explore how you tend to approach new ideas, imagination, intellectual curiosity, and creative pursuits.',
      estimated_minutes: 6,
      question_count: 25,
      access_type: 'free',
      status: 'published',
      featured: 1,
      display_order: 2,
      version: 1,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    },
    {
      id: 'asm_attachment',
      category_id: 'cat_relationships',
      category_name: 'Relationships',
      name: 'Adult Attachment Style Test',
      slug: 'adult-attachment-style',
      short_description: 'Reflect on how you relate to closeness, emotional security, communication, and independence in relationships.',
      estimated_minutes: 6,
      question_count: 25,
      access_type: 'free',
      status: 'published',
      featured: 1,
      display_order: 3,
      version: 1,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    },
    {
      id: 'asm_eq',
      category_id: 'cat_eq',
      category_name: 'Emotional Intelligence',
      name: 'Emotional Intelligence (EQ) Test',
      slug: 'emotional-intelligence-eq',
      short_description: 'Examine your emotional awareness, empathy, self-reflection, and social adaptability in daily life.',
      estimated_minutes: 6,
      question_count: 25,
      access_type: 'free',
      status: 'published',
      featured: 1,
      display_order: 4,
      version: 1,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    },
    {
      id: 'asm_career',
      category_id: 'cat_career',
      category_name: 'Career & Work',
      name: 'Workplace Motivation & Style Test',
      slug: 'work-style-test',
      short_description: 'Understand what energizes your work, leadership instincts, problem-solving, and professional collaboration.',
      estimated_minutes: 6,
      question_count: 25,
      access_type: 'free',
      status: 'published',
      featured: 1,
      display_order: 5,
      version: 1,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    },
    {
      id: 'asm_mindset',
      category_id: 'cat_mindset',
      category_name: 'Self-Development',
      name: 'Resilience & Adaptability Test',
      slug: 'resilience-test',
      short_description: 'Gain perspective on how you navigate setbacks, handle uncertainty, and maintain constructive focus under stress.',
      estimated_minutes: 5,
      question_count: 20,
      access_type: 'free',
      status: 'published',
      featured: 1,
      display_order: 6,
      version: 1,
      created_at: new Date().toISOString(),
      updated_at: new Date().toISOString()
    }
  ];
}

// 3. Dynamic Credit Economics
const creditService = new CreditService(db);
const reportCost = await creditService.getReportCreditCost();

// 4. Structured Data Schemas
const siteUrl = config.siteUrl || 'https://psychologycalculator.com';

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Psychology Calculator',
  url: siteUrl,
  description: 'Online psychology tests and personality assessments designed for structured, practical self-reflection.',
  potentialAction: {
    '@type': 'SearchAction',
    target: `${siteUrl}/assessments?q={search_term_string}`,
    'query-input': 'required name=search_term_string'
  }
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Psychology Calculator',
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`
};

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Popular Psychology & Personality Assessments',
  itemListElement: featuredAssessments.slice(0, 6).map((asm, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    url: `${siteUrl}/assessments/${asm.slug}`,
    name: asm.name,
    description: asm.short_description
  }))
};

const faqsData = [
  {
    q: 'What is a psychology test?',
    a: 'A psychology test on PsychologyCalculator.com is a structured self-assessment questionnaire with standardized statements. It helps you reflect on specific behavioral traits, emotional tendencies, or relational patterns across multiple dimensions.'
  },
  {
    q: 'Are the personality tests free?',
    a: 'Yes. All assessments on PsychologyCalculator.com are 100% free to take. You will receive an immediate dimensional score breakdown and basic interpretation without paying anything.'
  },
  {
    q: 'Can I take a personality test without creating an account?',
    a: 'Yes. You can start and complete any assessment as a guest without creating an account or providing a credit card. Your basic result is generated immediately.'
  },
  {
    q: 'How long do the assessments take?',
    a: 'Most assessments consist of 20 to 25 focused questions and take approximately 5 to 7 minutes to complete at a comfortable pace.'
  },
  {
    q: 'What can I learn from a personality test?',
    a: 'You can discover your relative tendencies across specific dimensions—such as intellectual curiosity, emotional regulation, conscientiousness, or communication style—and understand how these patterns interact in everyday situations.'
  },
  {
    q: 'What is a personality assessment?',
    a: 'A personality assessment is a structured psychological tool that evaluates different facets of your behavioral style, decision-making preferences, and natural strengths rather than reducing you to a simplistic label.'
  },
  {
    q: 'Are these tests a clinical diagnosis?',
    a: 'No. Assessments on PsychologyCalculator.com are provided strictly for educational and personal self-reflection purposes. They are not clinical diagnoses and are not a substitute for professional mental health care.'
  },
  {
    q: 'How do detailed AI reports work?',
    a: 'If you want deeper narrative interpretation beyond your free basic score, you can optionally unlock a comprehensive AI report. It synthesizes cross-dimension patterns, strengths, blind spots, and communication tendencies, and includes a downloadable vector PDF.'
  },
  {
    q: 'Do I need a monthly subscription?',
    a: 'No. PsychologyCalculator.com uses a simple pay-as-you-go credit system with no recurring billing. You only purchase one-time credits when you want a detailed report.'
  },
  {
    q: 'Do credits expire?',
    a: 'No. Purchased credits never expire. A credit package bought today can be used whenever you choose.'
  }
];

const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqsData.map((faq) => ({
    '@type': 'Question',
    name: faq.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.a
    }
  }))
};
---

<PublicLayout
  title="Psychology Tests & Assessments"
  description="Explore thoughtful psychology tests and personality assessments online. Free to start, no account required for basic results. Get clear insights into your patterns and tendencies."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
  </Fragment>

  <!-- 1. Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-b from-slate-50 via-teal-50/20 to-white pt-12 pb-16 sm:pt-20 sm:pb-24 border-b border-slate-200/70">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        <!-- Left Hero Copy -->
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-teal-50 border border-teal-200/80 rounded-full text-teal-800 text-[11px] font-bold tracking-wider uppercase">
            <span>✦</span>
            <span>Psychometrics & Self-Discovery</span>
          </div>

          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 tracking-tight leading-[1.12] text-balance">
            Psychology Tests That Turn Your Answers Into <span class="text-teal-700">Useful Insights</span>
          </h1>

          <p class="text-base sm:text-lg text-slate-600 leading-relaxed max-w-2xl mx-auto lg:mx-0">
            Explore personality, relationships, emotional intelligence, career, and self-development assessments designed to help you understand your patterns, preferences, and tendencies.
          </p>

          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
            <a
              href="/assessments/big-five-personality-test"
              class="w-full sm:w-auto px-7 py-3.5 bg-teal-600 hover:bg-teal-700 text-white text-sm font-extrabold rounded-2xl shadow-md hover:shadow-lg transition-all text-center flex items-center justify-center gap-2 group"
            >
              <span>Take a Free Test</span>
              <span class="group-hover:translate-x-0.5 transition-transform">→</span>
            </a>
            <a
              href="#categories"
              class="w-full sm:w-auto px-6 py-3.5 bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-200 rounded-2xl text-sm font-bold transition-all text-center"
            >
              Explore Assessments
            </a>
          </div>

          <!-- Micro-Trust Line -->
          <div class="pt-3 flex flex-wrap items-center justify-center lg:justify-start gap-x-5 gap-y-2 text-xs text-slate-500 font-medium">
            <span class="flex items-center gap-1.5">
              <span class="text-teal-600 font-bold">✓</span> Free to start
            </span>
            <span class="flex items-center gap-1.5">
              <span class="text-teal-600 font-bold">✓</span> No account required for basic results
            </span>
            <span class="flex items-center gap-1.5">
              <span class="text-teal-600 font-bold">✓</span> Takes only a few minutes
            </span>
          </div>
        </div>

        <!-- Right Hero Interactive Visual (Assessment & Dimension Preview) -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-full max-w-md bg-white rounded-3xl border border-slate-200/90 shadow-xl p-6 sm:p-7 space-y-5">
            <!-- Header of Preview Card -->
            <div class="flex items-center justify-between border-b border-slate-100 pb-4">
              <div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700 block">Assessment Preview</span>
                <h3 class="text-sm font-black text-slate-900">Personality & Curiosity Profile</h3>
              </div>
              <span class="px-2.5 py-1 text-[10px] font-mono font-bold bg-teal-50 text-teal-800 border border-teal-200/60 rounded-full">
                78% Alignment
              </span>
            </div>

            <!-- Active Question Sample -->
            <div class="p-4 bg-slate-50 rounded-2xl border border-slate-100 space-y-2">
              <div class="flex items-center justify-between text-[10px] font-bold text-slate-400 uppercase tracking-wider">
                <span>Question 7 of 25</span>
                <span class="text-teal-700">Intellectual Curiosity</span>
              </div>
              <p class="text-xs font-semibold text-slate-800 leading-snug">
                "I enjoy exploring ideas and perspectives that challenge conventional thinking."
              </p>
              <div class="flex gap-1.5 pt-1">
                <span class="h-1.5 flex-1 rounded-full bg-slate-200"></span>
                <span class="h-1.5 flex-1 rounded-full bg-slate-200"></span>
                <span class="h-1.5 flex-1 rounded-full bg-slate-200"></span>
                <span class="h-1.5 flex-1 rounded-full bg-teal-500"></span>
                <span class="h-1.5 flex-1 rounded-full bg-slate-200"></span>
              </div>
            </div>

            <!-- Dimensional Breakdown Bars -->
            <div class="space-y-3 pt-1">
              <span class="text-[11px] font-bold text-slate-700 block">Dimensional Breakdown</span>
              
              <div class="space-y-1">
                <div class="flex justify-between text-xs font-medium">
                  <span class="text-slate-700 font-semibold">Intellectual Curiosity</span>
                  <span class="text-teal-700 font-mono font-bold">82%</span>
                </div>
                <div class="h-2 w-full bg-slate-100 rounded-full overflow-hidden">
                  <div class="h-full bg-teal-500 rounded-full" style="width: 82%"></div>
                </div>
              </div>

              <div class="space-y-1">
                <div class="flex justify-between text-xs font-medium">
                  <span class="text-slate-700 font-semibold">Self-Awareness</span>
                  <span class="text-teal-700 font-mono font-bold">74%</span>
                </div>
                <div class="h-2 w-full bg-slate-100 rounded-full overflow-hidden">
                  <div class="h-full bg-teal-500 rounded-full" style="width: 74%"></div>
                </div>
              </div>

              <div class="space-y-1">
                <div class="flex justify-between text-xs font-medium">
                  <span class="text-slate-700 font-semibold">Adaptability & Novelty</span>
                  <span class="text-teal-700 font-mono font-bold">69%</span>
                </div>
                <div class="h-2 w-full bg-slate-100 rounded-full overflow-hidden">
                  <div class="h-full bg-teal-500 rounded-full" style="width: 69%"></div>
                </div>
              </div>
            </div>

            <!-- Footer Badge -->
            <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
              <span>✓ Instant Free Result</span>
              <span class="text-teal-700 font-bold">Explore Dimension Patterns →</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Trust / Value Strip -->
  <section class="py-10 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 lg:gap-8">
        <div class="space-y-1">
          <div class="text-xs font-black text-slate-900 tracking-wider uppercase flex items-center gap-1.5">
            <span class="text-teal-600">✦</span> FREE TO START
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            Take assessments and see your basic results without creating an account.
          </p>
        </div>

        <div class="space-y-1">
          <div class="text-xs font-black text-slate-900 tracking-wider uppercase flex items-center gap-1.5">
            <span class="text-teal-600">✦</span> CLEAR RESULTS
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            Understand what your scores may mean across distinct psychological dimensions.
          </p>
        </div>

        <div class="space-y-1">
          <div class="text-xs font-black text-slate-900 tracking-wider uppercase flex items-center gap-1.5">
            <span class="text-teal-600">✦</span> PRIVATE BY DESIGN
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            Your personal responses and results are kept private and never published.
          </p>
        </div>

        <div class="space-y-1">
          <div class="text-xs font-black text-slate-900 tracking-wider uppercase flex items-center gap-1.5">
            <span class="text-teal-600">✦</span> DETAILED REPORTS
          </div>
          <p class="text-xs text-slate-500 leading-relaxed">
            Optional deeper AI-assisted synthesis with PDF reports when you want them.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Why Use PsychologyCalculator.com -->
  <section id="about" class="py-16 sm:py-24 bg-slate-50/60 border-b border-slate-200">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center space-y-4 max-w-2xl mx-auto">
        <Badge variant="default" size="sm">A Thoughtful Approach</Badge>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          A Better Way to Explore Your Personality
        </h2>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
          Many people take an online quiz, receive a rigid label, and have no idea what to do with it. We focus on nuanced dimensions so you can see your real tendencies in context.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-4 text-center">
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-2xs space-y-2">
          <div class="w-8 h-8 rounded-full bg-teal-50 text-teal-700 font-bold text-xs flex items-center justify-center mx-auto">1</div>
          <h3 class="text-xs font-bold text-slate-900">Take Assessment</h3>
          <p class="text-[11px] text-slate-500">Answer focused questions at your own pace.</p>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-2xs space-y-2">
          <div class="w-8 h-8 rounded-full bg-teal-50 text-teal-700 font-bold text-xs flex items-center justify-center mx-auto">2</div>
          <h3 class="text-xs font-bold text-slate-900">Understand Scores</h3>
          <p class="text-[11px] text-slate-500">See your raw and normalized percentiles.</p>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-2xs space-y-2">
          <div class="w-8 h-8 rounded-full bg-teal-50 text-teal-700 font-bold text-xs flex items-center justify-center mx-auto">3</div>
          <h3 class="text-xs font-bold text-slate-900">Explore Dimensions</h3>
          <p class="text-[11px] text-slate-500">Examine specific traits, facets, and strengths.</p>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-2xs space-y-2">
          <div class="w-8 h-8 rounded-full bg-teal-50 text-teal-700 font-bold text-xs flex items-center justify-center mx-auto">4</div>
          <h3 class="text-xs font-bold text-slate-900">Reflect on Patterns</h3>
          <p class="text-[11px] text-slate-500">Notice how your tendencies shape decisions.</p>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-2xs space-y-2">
          <div class="w-8 h-8 rounded-full bg-teal-50 text-teal-700 font-bold text-xs flex items-center justify-center mx-auto">5</div>
          <h3 class="text-xs font-bold text-slate-900">Optional AI Report</h3>
          <p class="text-[11px] text-slate-500">Unlock deep synthesis whenever you choose.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 4. Assessment Categories Section -->
  <section id="categories" class="py-16 sm:py-24 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center space-y-3 max-w-2xl mx-auto">
        <Badge variant="info" size="sm">Browse By Topic</Badge>
        <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">
          Explore Psychology Tests by Topic
        </h2>
        <p class="text-sm sm:text-base text-slate-600">
          Find structured assessments across personality traits, relational styles, emotional awareness, and career preferences.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Category 1: Personality Tests -->
        <div class="p-7 rounded-3xl bg-slate-50/70 border border-slate-200/90 hover:border-teal-300 hover:shadow-md transition-all flex flex-col justify-between space-y-6 group">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-2xl">🧠</span>
              <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full border border-teal-200/60">
                Core Traits
              </span>
            </div>
            <div class="space-y-1.5">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-teal-700 transition-colors">
                Personality Tests
              </h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                Explore core personality traits, behavioral tendencies, intellectual curiosity, and decision-making preferences.
              </p>
            </div>
            <ul class="text-xs text-slate-600 space-y-1.5 pt-1 border-t border-slate-200/60">
              <li class="flex items-center gap-1.5"><span>•</span> Big Five Personality Test</li>
              <li class="flex items-center gap-1.5"><span>•</span> Openness to Experience Test</li>
              <li class="flex items-center gap-1.5"><span>•</span> Conscientiousness & Focus Test</li>
            </ul>
          </div>
          <a
            href="/assessments/category/personality"
            class="text-xs font-bold text-teal-700 hover:text-teal-800 inline-flex items-center gap-1 pt-2"
          >
            <span>Explore Personality Tests</span>
            <span>→</span>
          </a>
        </div>

        <!-- Category 2: Relationship Tests -->
        <div class="p-7 rounded-3xl bg-slate-50/70 border border-slate-200/90 hover:border-teal-300 hover:shadow-md transition-all flex flex-col justify-between space-y-6 group">
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-2xl">🤝</span>
              <span class="text-[10px] font-bold uppercase tracking-wider text-teal-700 bg-teal-50 px-2.5 py-1 rounded-full border border-teal-200/60">
                Connection
              </span>
            </div>
            <div class="space-y-1.5">
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-teal-700 transition-colors">
                Relationship Tests
              </h3>
              <p class="text-xs text-slate-500 leading-relaxed">
                Explore communication patterns, adult attachment styles, emotional boundaries, and interpersonal compatibility.
              </p>
            </div>
            <ul class="text-xs text-slate-600 space-y-1.5 pt-1 border-t border-slate-200/60">
              <li class="flex items-center gap-1.5"><span>•</span> Adult Attachment Style Test</li>
              <li class="flex items-center gap-1.5"><span>•</span> Communication Style Assessment</li>
              <li class="flex items-center gap-1.5"><span>•</span> Relational Boundaries Test</li>
            </ul>
          </div>
          <a
            href="/assessments/category/relationships"
            class="text-xs font-bold text-teal-700 hover:text-teal-800 inline-flex items-center gap-1 pt-2"
          >
            <span>Explore Relationship Tests</span>
            <span>→</span>
          </a>
        </div>

        <!-- Category 3: Emotional Intelligence -->
        <div class="p-7 rounded-3xl bg-slate-50/70 border border-slate-200/90 hover:border-teal-300 hover:shadow-md transition-all flex flex-col justify-between space-y-6 group">
          <div class="space-y-4">
