---
import type { SanitizedPublicShareData } from '@/types/database';

interface Props {
  share: SanitizedPublicShareData;
  class?: string;
  isDownloadable?: boolean;
}

const { share, class: className = '', isDownloadable = false } = Astro.props;

const scorePercent = Math.min(100, Math.max(0, share.scorePercent || 0));
const dimensions = (share.dimensions || []).slice(0, 5);
---

<div
  id="share-card-container"
  class={`relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-950 via-slate-900 to-teal-950 text-white border border-teal-900/50 shadow-2xl p-6 sm:p-10 ${className}`}
>
  <!-- Background Ambient Glow -->
  <div class="absolute -top-20 -right-20 w-72 h-72 bg-teal-500/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-20 -left-20 w-72 h-72 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Header Branding -->
  <div class="relative z-10 flex items-center justify-between border-b border-slate-800/80 pb-5">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-xl bg-teal-500 text-slate-950 font-black flex items-center justify-center text-sm shadow-md">
        Ψ
      </div>
      <span class="font-extrabold text-sm sm:text-base tracking-tight text-white">
        Psychology<span class="text-teal-400">Calculator</span>.com
      </span>
    </div>
    <span class="px-3 py-1 rounded-full text-[11px] font-mono font-bold tracking-wider uppercase bg-teal-950 border border-teal-500/40 text-teal-300">
      Verified Outcome
    </span>
  </div>

  <!-- Main Content Grid -->
  <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center py-6">
    <!-- Left: Assessment Name & Profile Title -->
    <div class="lg:col-span-8 space-y-3">
      <span class="text-xs font-mono font-bold uppercase tracking-widest text-teal-400">
        {share.assessmentName}
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white tracking-tight leading-tight">
        {share.resultTitle}
      </h2>
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-slate-800/80 border border-slate-700/60 rounded-xl text-xs font-bold text-slate-200">
        <span>★</span>
        <span>{share.levelLabel}</span>
      </div>
      {share.resultSummary && (
        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-xl line-clamp-3 pt-1">
          {share.resultSummary}
        </p>
      )}
    </div>

    <!-- Right: Visual Score Meter -->
    <div class="lg:col-span-4 flex flex-col items-center justify-center">
      <div class="relative w-36 h-36 sm:w-40 sm:h-40 flex items-center justify-center">
        <svg class="w-full h-full transform -rotate-90" viewBox="0 0 160 160">
          <circle cx="80" cy="80" r="64" stroke="currentColor" stroke-width="12" class="text-slate-800" fill="transparent" />
          <circle
            cx="80"
            cy="80"
            r="64"
            stroke="currentColor"
            stroke-width="12"
            stroke-dasharray={2 * Math.PI * 64}
            stroke-dashoffset={(2 * Math.PI * 64) * (1 - scorePercent / 100)}
            stroke-linecap="round"
            class="text-teal-400"
            fill="transparent"
          />
        </svg>
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
          <span class="text-3xl font-black font-mono text-white tracking-tight">{scorePercent}%</span>
          <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest mt-0.5">Profile Match</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Dimension Breakdown Bars -->
  {dimensions.length > 0 && (
    <div class="relative z-10 border-t border-slate-800/80 pt-5 space-y-3">
      <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-slate-400 block">
        Core Dimension Breakdown
      </span>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
        {dimensions.map((dim) => (
          <div class="bg-slate-900/80 border border-slate-800 rounded-2xl p-3 space-y-1.5">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold text-slate-200 truncate">{dim.name}</span>
              <span class="font-mono font-extrabold text-teal-400">{dim.levelLabel || `${dim.scorePercent}%`}</span>
            </div>
            <div class="w-full h-1.5 bg-slate-800 rounded-full overflow-hidden">
              <div class="h-full bg-gradient-to-r from-teal-500 to-cyan-400 rounded-full" style={`width: ${dim.scorePercent}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Card Footer -->
  <div class="relative z-10 border-t border-slate-800/80 mt-6 pt-4 flex flex-wrap items-center justify-between gap-3 text-xs text-slate-400">
    <span>Psychometrics & Self-Discovery Engine</span>
    <span class="font-bold text-teal-300 flex items-center gap-1">
      <span>Discover your profile</span>
      <span>→</span>
    </span>
  </div>
</div>
