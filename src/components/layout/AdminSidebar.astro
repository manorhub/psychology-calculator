---
import { ADMIN_NAVIGATION } from '@/config/admin-nav';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<aside class="w-64 bg-slate-900 text-slate-300 min-h-screen flex flex-col shrink-0 border-r border-slate-800">
  <!-- Brand Header -->
  <div class="h-16 flex items-center px-6 border-b border-slate-800 gap-3">
    <div class="w-8 h-8 rounded-lg bg-teal-500 text-white flex items-center justify-center font-bold text-sm">
      Ψ
    </div>
    <div class="flex flex-col">
      <span class="font-bold text-white text-sm tracking-tight">MindMetrics</span>
      <span class="text-[10px] text-teal-400 font-semibold uppercase tracking-wider">Admin Console</span>
    </div>
  </div>

  <!-- Admin Navigation Groups -->
  <nav class="flex-1 overflow-y-auto px-4 py-6 space-y-6" aria-label="Admin Sidebar Navigation">
    {ADMIN_NAVIGATION.map((group) => (
      <div class="space-y-1.5">
        <h3 class="px-2 text-[10px] font-bold text-slate-400 uppercase tracking-wider">
          {group.title}
        </h3>
        <ul class="space-y-1">
          {group.items.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/admin' && currentPath.startsWith(item.href));
            return (
              <li>
                <a
                  href={item.href}
                  class={`flex items-center justify-between px-3 py-2 text-xs font-medium rounded-xl transition-colors ${
                    isActive
                      ? 'bg-teal-600/20 text-teal-300 font-semibold border border-teal-500/30'
                      : 'text-slate-400 hover:bg-slate-800 hover:text-slate-200'
                  }`}
                  title={item.description}
                >
                  <span class="truncate">{item.label}</span>
                  <span class="text-[9px] px-1.5 py-0.5 rounded bg-slate-800 text-slate-400 font-mono">
                    {item.phase}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>

  <!-- Admin Footer / Environment Indicator -->
  <div class="p-4 border-t border-slate-800 bg-slate-950/50">
    <div class="flex items-center justify-between text-xs text-slate-400">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span class="font-mono text-[11px]">Edge: Active</span>
      </div>
      <a href="/" class="text-teal-400 hover:text-teal-300 font-medium">
        Public Site &rarr;
      </a>
    </div>
  </div>
</aside>
