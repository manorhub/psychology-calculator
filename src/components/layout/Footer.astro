---
import type { DynamicSiteConfig } from '@/types/config';
import { useTranslations, getLocalizedPath, normalizeLocale } from '@/i18n';

interface Props {
  config: DynamicSiteConfig;
  locale?: string;
}

const { config, locale: propLocale } = Astro.props;
const currentLocale = normalizeLocale(propLocale || Astro.currentLocale || Astro.url.pathname.split('/')[1]);
const { t } = useTranslations(currentLocale);
const currentYear = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-200 bg-slate-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 lg:gap-12 pb-12 border-b border-slate-200">
      <!-- Brand & Mission Column -->
      <div class="md:col-span-1 space-y-4">
        <div class="flex items-center gap-2.5">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-teal-700 to-teal-500 flex items-center justify-center text-white font-bold text-lg shadow-sm shadow-teal-500/20">
            Ψ
          </div>
          <span class="font-bold text-lg text-slate-900 tracking-tight">
            {config.siteName}
          </span>
        </div>
        <p class="text-sm text-slate-500 leading-relaxed">
          {t.footer.description}
        </p>
        <p class="text-xs text-slate-400">
          Built with scientific rigor & privacy-first architecture.
        </p>
      </div>

      <!-- Dynamic Footer Sections -->
      <div class="md:col-span-3 grid grid-cols-2 sm:grid-cols-3 gap-8">
        {config.footerSections.map((section) => (
          <div class="space-y-3">
            <h4 class="text-xs font-semibold text-slate-900 uppercase tracking-wider">
              {section.title}
            </h4>
            <ul class="space-y-2">
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.isExternal ? link.href : getLocalizedPath(link.href, currentLocale)}
                    target={link.isExternal ? '_blank' : undefined}
                    rel={link.isExternal ? 'noopener noreferrer' : undefined}
                    class="text-sm text-slate-600 hover:text-slate-900 transition-colors"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Mandatory Psychology Disclaimer & Bottom Bar -->
    <div class="pt-8 space-y-6">
      <div class="p-4 rounded-xl bg-slate-100/80 border border-slate-200/80 text-xs text-slate-500 leading-relaxed">
        <span class="font-semibold text-slate-700 block sm:inline mr-1">{t.footer.legalDisclaimerTitle}:</span>
        {t.footer.legalDisclaimerText}
      </div>

      <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
        <p>© {currentYear} {config.siteName}. {t.common.allRightsReserved}</p>
        <p class="flex items-center gap-1">
          <span>Server-rendered on Cloudflare Edge</span>
        </p>
      </div>
    </div>
  </div>
</footer>
