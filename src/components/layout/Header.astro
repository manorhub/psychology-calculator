---
import type { DynamicSiteConfig } from '@/types/config';
import Button from '@/components/ui/Button.astro';
import LanguageSwitcher from '@/components/layout/LanguageSwitcher.astro';
import { type SupportedLocale, DEFAULT_LOCALE, getLocalizedPath } from '@/i18n';

interface Props {
  config: DynamicSiteConfig;
  currentLocale?: string;
}

const { config, currentLocale = DEFAULT_LOCALE } = Astro.props;
const user = Astro.locals.user;
const activeLocale = currentLocale || DEFAULT_LOCALE;

const homeHref = activeLocale === 'en' ? '/' : `/${activeLocale}`;
const assessmentsHref = activeLocale === 'en' ? '/assessments' : `/${activeLocale}/assessments`;
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200/80 bg-white/95 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Brand Logo -->
      <div class="flex items-center gap-8">
        <a href={homeHref} class="flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 rounded-lg">
          <div class="w-9 h-9 rounded-xl bg-teal-600 flex items-center justify-center text-white font-black text-lg shadow-sm shadow-teal-500/20 group-hover:scale-105 transition-transform">
            Ψ
          </div>
          <div class="flex flex-col">
            <span class="font-extrabold text-base sm:text-lg text-slate-900 tracking-tight leading-none">
              Psychology<span class="text-teal-600">Calculator</span>.com
            </span>
            <span class="text-[10px] text-teal-700 font-bold tracking-wider uppercase mt-0.5">
              Psychometrics & Self-Discovery
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Links -->
        <nav class="hidden md:flex items-center gap-1" aria-label="Main Navigation">
          <a
            href={assessmentsHref}
            class="px-3.5 py-2 text-sm font-semibold text-slate-700 hover:text-teal-700 hover:bg-teal-50/60 rounded-xl transition-colors"
          >
            Assessments
          </a>
          <a
            href={activeLocale === 'en' ? '/about' : `/${activeLocale}/about`}
            class="px-3.5 py-2 text-sm font-semibold text-slate-700 hover:text-teal-700 hover:bg-teal-50/60 rounded-xl transition-colors"
          >
            About
          </a>
          <a
            href={activeLocale === 'en' ? '/pricing' : `/${activeLocale}/pricing`}
            class="px-3.5 py-2 text-sm font-semibold text-slate-700 hover:text-teal-700 hover:bg-teal-50/60 rounded-xl transition-colors"
          >
            Pricing
          </a>
        </nav>
      </div>

      <!-- Action Buttons & Language Switcher -->
      <div class="flex items-center gap-2.5 sm:gap-3">
        <!-- Language Switcher Dropdown -->
        <LanguageSwitcher currentLocale={activeLocale} />

        {user ? (
          <a
            href="/dashboard"
            class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 text-xs font-bold text-slate-800 hover:text-teal-800 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors"
          >
            <span class="w-5 h-5 rounded-full bg-teal-700 text-white flex items-center justify-center text-[10px] font-bold">
              {user.profile.displayName ? user.profile.displayName.substring(0, 1).toUpperCase() : 'U'}
            </span>
            <span class="max-w-[120px] truncate">{user.profile.displayName || 'Dashboard'}</span>
          </a>
        ) : (
          <a
            href="/login"
            class="hidden sm:inline-flex px-3.5 py-2 text-xs sm:text-sm font-bold text-slate-700 hover:text-slate-900 hover:bg-slate-100 rounded-xl transition-colors"
          >
            Sign In
          </a>
        )}

        <Button href={assessmentsHref} variant="primary" size="sm">
          Take Free Test →
        </Button>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          id="mobile-menu-toggle"
          class="md:hidden p-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-xl transition-colors focus:outline-none focus:ring-2 focus:ring-teal-600"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 py-4 space-y-2 shadow-lg">
    <a
      href={assessmentsHref}
      class="block px-3 py-2 text-sm font-bold text-slate-800 hover:bg-teal-50 hover:text-teal-800 rounded-xl"
    >
      All Assessments
    </a>
    <a
      href={activeLocale === 'en' ? '/about' : `/${activeLocale}/about`}
      class="block px-3 py-2 text-sm font-bold text-slate-800 hover:bg-teal-50 hover:text-teal-800 rounded-xl"
    >
      About & Methodology
    </a>
    <a
      href={activeLocale === 'en' ? '/pricing' : `/${activeLocale}/pricing`}
      class="block px-3 py-2 text-sm font-bold text-slate-800 hover:bg-teal-50 hover:text-teal-800 rounded-xl"
    >
      Pricing & Credits
    </a>
    {user ? (
      <a
        href="/dashboard"
        class="block px-3 py-2 text-sm font-bold text-teal-800 bg-teal-50 rounded-xl"
      >
        My Dashboard ({user.profile.displayName || 'Member'})
      </a>
    ) : (
      <a
        href="/login"
        class="block px-3 py-2 text-sm font-bold text-slate-700 hover:bg-slate-50 rounded-xl"
      >
        Sign In / Register
      </a>
    )}
  </div>
</header>

<script is:inline>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      }
    });
  }
</script>
