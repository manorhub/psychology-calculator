---
import type { DynamicSiteConfig } from '@/types/config';
import Button from '@/components/ui/Button.astro';
import LanguageSwitcher from '@/components/layout/LanguageSwitcher.astro';
import { getD1Database } from '@/lib/db/client';
import { fetchFirst } from '@/lib/db/query';
import { useTranslations, getLocalizedPath, normalizeLocale } from '@/i18n';

interface Props {
  config: DynamicSiteConfig;
  locale?: string;
}

const { config, locale: propLocale } = Astro.props;
const currentLocale = normalizeLocale(propLocale || Astro.currentLocale || Astro.url.pathname.split('/')[1]);
const { t } = useTranslations(currentLocale);
const user = Astro.locals.user;

let userCredits: number | null = null;
if (user) {
  const env = Astro.locals.runtime?.env;
  const db = getD1Database(env);
  if (db) {
    const row = await fetchFirst<{ balance: number }>(
      db,
      'SELECT balance FROM credit_wallets WHERE user_id = ?',
      [user.id]
    );
    userCredits = row?.balance ?? 0;
  }
}
const publicNav = config.headerNavigation.filter(
  (item) => item.label.toLowerCase() !== 'admin' && item.href !== '/admin'
);
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200/80 bg-white/95 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20 gap-2">
      <!-- Brand Logo -->
      <div class="flex items-center gap-4 lg:gap-8 min-w-0">
        <a href={getLocalizedPath('/', currentLocale)} class="flex items-center gap-2 group focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 rounded-lg min-w-0">
          <div class="w-8 h-8 sm:w-9 sm:h-9 shrink-0 rounded-xl bg-gradient-to-tr from-teal-700 to-teal-500 flex items-center justify-center text-white font-bold text-base sm:text-lg shadow-sm shadow-teal-500/20 group-hover:scale-105 transition-transform">
            Ψ
          </div>
          <div class="flex flex-col min-w-0">
            <span class="font-bold text-sm sm:text-lg lg:text-xl text-slate-900 tracking-tight leading-tight truncate">
              {config.siteName}
            </span>
            <span class="text-[9px] sm:text-[10px] text-teal-700 font-semibold tracking-wider uppercase truncate hidden xs:inline-block">
              {t.common.tagline || config.siteTagline}
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Links (Dynamic & Localized) -->
        <nav class="hidden md:flex items-center gap-1" aria-label="Main Navigation">
          {publicNav.map((item) => (
            <a
              href={getLocalizedPath(item.href, currentLocale)}
              class="px-3.5 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 rounded-lg transition-colors"
            >
              {item.label}
              {item.badge && (
                <span class="ml-1.5 px-1.5 py-0.5 text-[10px] bg-teal-100 text-teal-800 rounded-full font-semibold">
                  {item.badge}
                </span>
              )}
            </a>
          ))}
        </nav>
      </div>

      <!-- Action Buttons & Language Switcher -->
      <div class="flex items-center gap-1.5 sm:gap-3 shrink-0">
        <!-- Language Switcher: Visible on tablet/desktop -->
        <div class="hidden sm:block">
          <LanguageSwitcher currentLocale={currentLocale} />
        </div>

        {user ? (
          <div class="flex items-center gap-1.5 sm:gap-2">
            <a
              href="/dashboard/credits"
              class="inline-flex items-center gap-1 px-2 py-1 sm:px-2.5 sm:py-1.5 text-[11px] sm:text-xs font-mono font-bold text-teal-800 bg-teal-50 hover:bg-teal-100 border border-teal-200 rounded-xl transition-all shadow-2xs"
              title="View your credit balance"
            >
              <span>💎</span>
              <span>{userCredits !== null ? `${userCredits}` : ''}<span class="hidden sm:inline"> {t.nav.credits}</span></span>
            </a>
            <a
              href="/dashboard"
              class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-all shadow-2xs"
            >
              <span>📊</span>
              <span>{t.nav.dashboard}</span>
            </a>
            {user.role === 'admin' && (
              <a
                href="/admin"
                class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-bold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 rounded-xl transition-colors"
              >
                <span>⚙️</span>
                <span>{t.nav.admin}</span>
              </a>
            )}
            <a
              href="/dashboard/profile"
              class="hidden md:inline-flex items-center gap-2 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors"
            >
              <span class="w-5 h-5 rounded-full bg-slate-900 text-white flex items-center justify-center text-[10px] font-bold">
                {user.profile.displayName ? user.profile.displayName.substring(0, 1).toUpperCase() : 'U'}
              </span>
              <span class="max-w-[100px] truncate">{user.profile.displayName || 'Profile'}</span>
            </a>
          </div>
        ) : (
          config.features.enableUserAccounts && (
            <a
              href="/login"
              class="hidden sm:inline-flex px-3.5 py-2 text-sm font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-100 rounded-xl transition-colors"
            >
              {t.nav.signIn}
            </a>
          )
        )}

        <div class="hidden sm:inline-flex">
          <Button href={getLocalizedPath(config.primaryCtaLink, currentLocale)} variant="primary" size="sm">
            {config.primaryCtaText || t.nav.register}
          </Button>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          id="mobile-menu-toggle"
          class="md:hidden p-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-xl transition-colors focus:outline-none focus:ring-2 focus:ring-teal-600 cursor-pointer"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 py-4 space-y-3 shadow-xl divide-y divide-slate-100">
    <div class="space-y-1">
      {publicNav.map((item) => (
        <a
          href={getLocalizedPath(item.href, currentLocale)}
          class="block px-3.5 py-2.5 text-base font-medium text-slate-700 hover:bg-teal-50 hover:text-teal-900 rounded-xl transition-colors"
        >
          {item.label}
          {item.badge && (
            <span class="ml-2 px-1.5 py-0.5 text-[10px] bg-teal-100 text-teal-800 rounded-full font-semibold">
              {item.badge}
            </span>
          )}
        </a>
      ))}
    </div>

    <!-- Mobile Language Switcher Section -->
    <div class="pt-3 space-y-1">
      <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider px-3.5 mb-1.5">
        Language
      </div>
      <div class="px-2">
        <LanguageSwitcher currentLocale={currentLocale} class="w-full" />
      </div>
    </div>

    {user ? (
      <div class="pt-3 space-y-1">
        <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider px-3.5 mb-1.5">
          Account & Dashboard
        </div>
        <a
          href="/dashboard"
          class="flex items-center gap-2 px-3.5 py-2.5 text-base font-bold text-teal-700 hover:bg-teal-50 rounded-xl"
        >
          <span>📊</span>
          <span>User Dashboard</span>
        </a>
        <a
          href="/dashboard/credits"
          class="flex items-center gap-2 px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 rounded-xl"
        >
          <span>💎</span>
          <span>Credits ({userCredits !== null ? userCredits : 0})</span>
        </a>
        <a
          href="/dashboard/assessments"
          class="flex items-center gap-2 px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 rounded-xl"
        >
          <span>📝</span>
          <span>My Assessments</span>
        </a>
        <a
          href="/dashboard/results"
          class="flex items-center gap-2 px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 rounded-xl"
        >
          <span>🎯</span>
          <span>My Results & History</span>
        </a>
        <a
          href="/dashboard/reports"
          class="flex items-center gap-2 px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 rounded-xl"
        >
          <span>✨</span>
          <span>AI Reports</span>
        </a>
        <a
          href="/dashboard/profile"
          class="flex items-center gap-2 px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 rounded-xl"
        >
          <span>👤</span>
          <span>Profile & Settings</span>
        </a>
        {user.role === 'admin' && (
          <a
            href="/admin"
            class="flex items-center gap-2 px-3.5 py-2 text-sm font-bold text-indigo-700 hover:bg-indigo-50 rounded-xl"
          >
            <span>⚙️</span>
            <span>Admin Control Center</span>
          </a>
        )}
      </div>
    ) : (
      <div class="pt-3 space-y-2">
        <a
          href={getLocalizedPath(config.primaryCtaLink, currentLocale)}
          class="block w-full py-3 text-center text-sm font-bold text-white bg-teal-600 hover:bg-teal-700 rounded-xl shadow-sm transition-all"
        >
          {config.primaryCtaText || t.nav.register}
        </a>
        {config.features.enableUserAccounts && (
          <a
            href="/login"
            class="block w-full py-2.5 text-center text-sm font-semibold text-slate-700 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors"
          >
            {t.nav.signIn}
          </a>
        )}
      </div>
    )}
  </div>
</header>

<script>
  function initMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    if (!toggleBtn || !menu) return;

    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      iconOpen?.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
    });

    document.addEventListener('click', (e) => {
      if (menu && !menu.contains(e.target as Node) && toggleBtn && !toggleBtn.contains(e.target as Node)) {
        menu.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      }
    });
  }

  initMobileMenu();
  document.addEventListener('astro:after-swap', initMobileMenu);
</script>
