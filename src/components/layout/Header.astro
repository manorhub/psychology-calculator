---
import type { DynamicSiteConfig } from '@/types/config';
import Button from '@/components/ui/Button.astro';
import LanguageSwitcher from '@/components/layout/LanguageSwitcher.astro';
import { getD1Database } from '@/lib/db/client';
import { fetchFirst } from '@/lib/db/query';
import { useTranslations, getLocalizedPath, normalizeLocale } from '@/i18n';

interface Props {
  config: DynamicSiteConfig;
  locale?: string;
}

const { config, locale: propLocale } = Astro.props;
const currentLocale = normalizeLocale(propLocale || Astro.currentLocale || Astro.url.pathname.split('/')[1]);
const { t } = useTranslations(currentLocale);
const user = Astro.locals.user;

let userCredits: number | null = null;
if (user) {
  const env = Astro.locals.runtime?.env;
  const db = getD1Database(env);
  if (db) {
    const row = await fetchFirst<{ balance: number }>(
      db,
      'SELECT balance FROM credit_wallets WHERE user_id = ?',
      [user.id]
    );
    userCredits = row?.balance ?? 0;
  }
}
const publicNav = config.headerNavigation.filter(
  (item) => item.label.toLowerCase() !== 'admin' && item.href !== '/admin'
);
---

<header class="sticky top-0 z-40 w-full border-b border-slate-200/80 bg-white/90 backdrop-blur-md">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Brand Logo -->
      <div class="flex items-center gap-8">
        <a href={getLocalizedPath('/', currentLocale)} class="flex items-center gap-2.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-teal-600 rounded-lg">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-teal-700 to-teal-500 flex items-center justify-center text-white font-bold text-lg shadow-sm shadow-teal-500/20 group-hover:scale-105 transition-transform">
            Ψ
          </div>
          <div class="flex flex-col">
            <span class="font-bold text-lg sm:text-xl text-slate-900 tracking-tight leading-none">
              {config.siteName}
            </span>
            <span class="text-[10px] text-teal-700 font-semibold tracking-wider uppercase mt-0.5">
              {t.common.brandName.split(' ')[0]}
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Links (Dynamic & Localized) -->
        <nav class="hidden md:flex items-center gap-1" aria-label="Main Navigation">
          {publicNav.map((item) => (
            <a
              href={getLocalizedPath(item.href, currentLocale)}
              class="px-3.5 py-2 text-sm font-medium text-slate-600 hover:text-slate-900 hover:bg-slate-50 rounded-lg transition-colors"
            >
              {item.label}
              {item.badge && (
                <span class="ml-1.5 px-1.5 py-0.5 text-[10px] bg-teal-100 text-teal-800 rounded-full font-semibold">
                  {item.badge}
                </span>
              )}
            </a>
          ))}
        </nav>
      </div>

      <!-- Action Buttons & Language Switcher -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Language Switcher -->
        <LanguageSwitcher currentLocale={currentLocale} />

        {user ? (
          <div class="flex items-center gap-2">
            <a
              href="/dashboard/credits"
              class="inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-mono font-bold text-teal-800 bg-teal-50 hover:bg-teal-100 border border-teal-200 rounded-xl transition-all shadow-2xs"
              title="View your credit balance & transaction ledger"
            >
              <span>💎</span>
              <span>{userCredits !== null ? `${userCredits} ${t.nav.credits}` : t.nav.credits}</span>
            </a>
            <a
              href="/dashboard"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-bold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-all shadow-2xs"
            >
              <span>📊</span>
              <span class="hidden sm:inline">{t.nav.dashboard}</span>
            </a>
            {user.role === 'admin' && (
              <a
                href="/admin"
                class="hidden sm:inline-flex items-center gap-1 px-2.5 py-1.5 text-xs font-bold text-indigo-700 bg-indigo-50 hover:bg-indigo-100 border border-indigo-200 rounded-xl transition-colors"
              >
                <span>⚙️</span>
                <span>{t.nav.admin}</span>
              </a>
            )}
            <a
              href="/dashboard/profile"
              class="hidden md:inline-flex items-center gap-2 px-3 py-1.5 text-xs font-semibold text-slate-700 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors"
            >
              <span class="w-5 h-5 rounded-full bg-slate-900 text-white flex items-center justify-center text-[10px] font-bold">
                {user.profile.displayName ? user.profile.displayName.substring(0, 1).toUpperCase() : 'U'}
              </span>
              <span class="max-w-[100px] truncate">{user.profile.displayName || 'Profile'}</span>
            </a>
          </div>
        ) : (
          config.features.enableUserAccounts && (
            <a
              href="/login"
              class="hidden sm:inline-flex px-3.5 py-2 text-sm font-medium text-slate-700 hover:text-slate-900 hover:bg-slate-100 rounded-xl transition-colors"
            >
              {t.nav.signIn}
            </a>
          )
        )}

        <Button href={getLocalizedPath(config.primaryCtaLink, currentLocale)} variant="primary" size="sm">
          {config.primaryCtaText || t.nav.register}
        </Button>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          id="mobile-menu-toggle"
          class="md:hidden p-2 text-slate-600 hover:text-slate-900 hover:bg-slate-100 rounded-xl transition-colors focus:outline-none focus:ring-2 focus:ring-teal-600"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Navigation -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-slate-200 bg-white px-4 py-4 space-y-2 shadow-lg">
    {publicNav.map((item) => (
      <a
        href={item.href}
        class="block px-3.5 py-2.5 text-base font-medium text-slate-700 hover:bg-slate-50 hover:text-slate-900 rounded-xl"
      >
        {item.label}
      </a>
    ))}
    {user ? (
      <div class="pt-2 border-t border-slate-100 space-y-1">
        <a
          href="/dashboard"
          class="block px-3.5 py-2.5 text-base font-bold text-teal-700 hover:bg-teal-50 rounded-xl"
        >
          📊 User Dashboard
        </a>
        <a
          href="/dashboard/assessments"
          class="block px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 rounded-xl"
        >
          📝 My Assessments
        </a>
        <a
          href="/dashboard/results"
          class="block px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 rounded-xl"
        >
          🎯 My Results & History
        </a>
        <a
          href="/dashboard/reports"
          class="block px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 rounded-xl"
        >
          ✨ AI Reports
        </a>
        <a
          href="/dashboard/profile"
          class="block px-3.5 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50 rounded-xl"
        >
          👤 Profile & Settings
        </a>
        {user.role === 'admin' && (
          <a
            href="/admin"
            class="block px-3.5 py-2 text-sm font-bold text-indigo-700 hover:bg-indigo-50 rounded-xl"
          >
            ⚙️ Admin Control Center
          </a>
        )}
      </div>
    ) : (
      config.features.enableUserAccounts && (
        <div class="pt-2 border-t border-slate-100">
          <a
            href="/login"
            class="block px-3.5 py-2.5 text-base font-medium text-slate-700 hover:bg-slate-50 hover:text-slate-900 rounded-xl"
          >
            Sign In
          </a>
        </div>
      )
    )}
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggleBtn?.addEventListener('click', () => {
    const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
    toggleBtn.setAttribute('aria-expanded', (!isExpanded).toString());
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>
