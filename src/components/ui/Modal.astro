---
interface Props {
  id: string;
  title: string;
  description?: string;
  class?: string;
}

const { id, title, description, class: className = '' } = Astro.props;
---

<dialog
  id={id}
  class={`rounded-2xl border border-slate-200 bg-white p-0 shadow-2xl backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm max-w-lg w-full m-auto ${className}`}
>
  <div class="p-6">
    <div class="flex items-start justify-between pb-4 border-b border-slate-100">
      <div>
        <h3 class="text-lg font-semibold text-slate-900">{title}</h3>
        {description && <p class="text-sm text-slate-500 mt-1">{description}</p>}
      </div>
      <button
        type="button"
        data-close-dialog={id}
        class="text-slate-400 hover:text-slate-600 rounded-lg p-1.5 hover:bg-slate-100 transition-colors"
        aria-label="Close dialog"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div class="py-4 text-slate-700 text-sm">
      <slot />
    </div>

    {Astro.slots.has('footer') && (
      <div class="pt-4 border-t border-slate-100 flex items-center justify-end gap-3">
        <slot name="footer" />
      </div>
    )}
  </div>
</dialog>

<script is:inline>
  // Lightweight accessible dialog trigger handlers
  document.querySelectorAll('[data-open-dialog]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dialogId = btn.getAttribute('data-open-dialog');
      if (dialogId) {
        const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
        dialog?.showModal();
      }
    });
  });

  document.querySelectorAll('[data-close-dialog]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dialogId = btn.getAttribute('data-close-dialog');
      if (dialogId) {
        const dialog = document.getElementById(dialogId) as HTMLDialogElement | null;
        dialog?.close();
      }
    });
  });
</script>
