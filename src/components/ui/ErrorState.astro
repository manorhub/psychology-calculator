---
import Button from './Button.astro';

interface Props {
  title?: string;
  message?: string;
  retryHref?: string;
  class?: string;
}

const {
  title = 'Something went wrong',
  message = 'We encountered an unexpected error while processing your request. Please try again.',
  retryHref = '/',
  class: className = ''
} = Astro.props;
---

<div class={`text-center py-12 px-4 rounded-2xl border border-rose-100 bg-rose-50/40 ${className}`}>
  <div class="mx-auto w-12 h-12 rounded-full bg-rose-100 flex items-center justify-center text-rose-600 mb-4">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
    </svg>
  </div>
  <h3 class="text-lg font-semibold text-slate-900 mb-2">{title}</h3>
  <p class="text-sm text-slate-600 max-w-md mx-auto mb-6">{message}</p>
  <div class="flex items-center justify-center gap-3">
    <Button href={retryHref} variant="outline" size="sm">
      Return Home
    </Button>
    <Button onclick="window.location.reload()" variant="primary" size="sm">
      Try Again
    </Button>
  </div>
</div>
