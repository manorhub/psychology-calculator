---
import type { ResultSnapshotData } from '@/types/database';

interface Props {
  snapshot: ResultSnapshotData;
  isSharedView?: boolean;
  activeShareToken?: string | null;
}

const { snapshot, isSharedView = false, activeShareToken = null } = Astro.props;

const scorePercent = Math.min(100, Math.max(0, Math.round(snapshot.totalNormalizedScore)));
const durationMins = Math.max(1, Math.round(snapshot.durationSeconds / 60));

// Resolve dynamic score level badge label & color
const levelLabel =
  snapshot.primaryResultType?.name ||
  (scorePercent >= 70 ? 'High Level' : scorePercent >= 35 ? 'Moderate Level' : 'Low Level');

const levelBadgeColor =
  scorePercent >= 70
    ? 'bg-emerald-500/20 text-emerald-300 border-emerald-500/40'
    : scorePercent >= 35
    ? 'bg-teal-500/20 text-teal-300 border-teal-500/40'
    : 'bg-amber-500/20 text-amber-300 border-amber-500/40';
---

<header id="overview" class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-slate-950 via-slate-900 to-teal-950 text-white shadow-xl border border-teal-900/40 p-6 sm:p-10 lg:p-12 space-y-8">
  <!-- Subtle Background Glows -->
  <div class="absolute -top-24 -right-24 w-80 h-80 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute -bottom-24 -left-24 w-80 h-80 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <!-- Top Metadata & Status -->
  <div class="relative z-10 flex flex-wrap items-center justify-between gap-3 border-b border-slate-800/80 pb-5">
    <div class="inline-flex items-center gap-2 px-3 py-1 bg-teal-900/60 border border-teal-700/50 rounded-full text-xs font-bold text-teal-200">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>YOUR PSYCHOMETRIC EVALUATION IS READY</span>
    </div>

    <div class="text-xs text-slate-400 font-mono flex items-center gap-3">
      <span>Completed in {durationMins} min</span>
      <span>•</span>
      <span>{new Date(snapshot.completedAt).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })}</span>
      <span>•</span>
      <span>v{snapshot.assessmentVersion}</span>
    </div>
  </div>

  <!-- Main Hero Grid -->
  <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
    <!-- Left: Assessment & Outcome Identification -->
    <div class="lg:col-span-8 space-y-4 text-left">
      <div class="space-y-1">
        <span class="text-xs font-bold uppercase tracking-widest text-teal-400 block font-mono">
          {snapshot.assessmentName}
        </span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tight leading-tight">
          {snapshot.primaryResultType?.name || 'Primary Assessment Profile'}
        </h1>
      </div>

      {snapshot.primaryResultType?.description && (
        <p class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-2xl font-normal">
          {snapshot.primaryResultType.description}
        </p>
      )}

      <!-- Dynamic psychological framing indicator -->
      <div class="pt-2 flex items-center gap-2 text-xs text-teal-200/90 font-medium">
        <span>🔍</span>
        <span>Based on your standardized psychometric responses across {snapshot.dimensionScores.length} construct {snapshot.dimensionScores.length === 1 ? 'dimension' : 'dimensions'}.</span>
      </div>
    </div>

    <!-- Right: Visual Circular / Radial Score Meter Component -->
    <div class="lg:col-span-4 flex flex-col items-center justify-center">
      <div class="relative w-44 h-44 sm:w-48 sm:h-48 flex items-center justify-center">
        <!-- SVG Circular Progress Meter -->
        <svg class="w-full h-full transform -rotate-90" viewBox="0 0 160 160">
          <circle
            cx="80"
            cy="80"
            r="68"
            stroke="currentColor"
            stroke-width="12"
            class="text-slate-800/80"
            fill="transparent"
          />
          <circle
            cx="80"
            cy="80"
            r="68"
            stroke="currentColor"
            stroke-width="12"
            stroke-dasharray={2 * Math.PI * 68}
            stroke-dashoffset={(2 * Math.PI * 68) * (1 - scorePercent / 100)}
            stroke-linecap="round"
            class="text-teal-400 transition-all duration-1000 ease-out"
            fill="transparent"
          />
        </svg>

        <!-- Inner Score Value Display -->
        <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-4">
          <span class="text-3xl sm:text-4xl font-black font-mono text-white tracking-tight">
            {scorePercent}%
          </span>
          <span class="text-[11px] font-mono text-slate-400 uppercase tracking-wider block mt-0.5">
            Score: {snapshot.totalRawScore} / {snapshot.totalMaxScore}
          </span>
        </div>
      </div>

      <!-- Result Level Badge -->
      <div class="mt-3 text-center">
        <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-extrabold border uppercase tracking-wider ${levelBadgeColor}`}>
          <span>★</span>
          <span>{levelLabel}</span>
        </span>
      </div>
    </div>
  </div>

  <!-- Bottom Actions & Share Row -->
  {!isSharedView && (
    <div class="relative z-10 pt-6 border-t border-slate-800/80 flex flex-wrap items-center justify-between gap-4 no-print">
      <div class="text-xs text-slate-300 flex items-center gap-2">
        <span>📄</span>
        <span>Official verified psychometric outcome</span>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <a
          href={`/api/v1/results/${snapshot.attemptId}/pdf`}
          download
          class="px-4 py-2.5 text-xs font-bold bg-teal-800/80 hover:bg-teal-700 text-teal-100 border border-teal-600/60 rounded-xl shadow-xs transition-all flex items-center gap-1.5 focus:ring-2 focus:ring-teal-400"
        >
          <span>📄</span>
          <span>Download Result PDF</span>
        </a>

        <button
          type="button"
          id="share-result-btn"
          data-attempt-id={snapshot.attemptId}
          class="px-4 py-2.5 text-xs font-bold bg-white text-slate-950 hover:bg-teal-50 rounded-xl shadow-xs transition-all cursor-pointer flex items-center gap-1.5 focus:ring-2 focus:ring-white"
        >
          <span>🔗</span>
          <span id="share-btn-text">{activeShareToken ? 'Copy Share Link' : 'Generate Share Link'}</span>
        </button>

        <a
          href={`/assessments/${snapshot.assessmentSlug}/take`}
          class="px-4 py-2.5 text-xs font-semibold text-slate-300 hover:text-white hover:bg-slate-800/80 border border-slate-700/60 rounded-xl transition-all flex items-center gap-1.5"
        >
          <span>🔄</span>
          <span>Retake</span>
        </a>
      </div>
    </div>
  )}
</header>
