---
interface Props {
  attemptId: string;
  assessmentName: string;
  existingReportId?: string | null;
  isGuest?: boolean;
  userCredits?: number;
  creditCost?: number;
}

const {
  attemptId,
  assessmentName,
  existingReportId = null,
  isGuest = false,
  userCredits = 0,
  creditCost = 5
} = Astro.props;

const hasSufficientCredits = userCredits >= creditCost;
---

<section
  id="ai-report"
  class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-indigo-950 via-slate-900 to-indigo-900 text-white p-8 sm:p-12 shadow-xl border border-indigo-800/50 space-y-8"
>
  <!-- Background Glows -->
  <div class="absolute top-0 right-0 w-96 h-96 bg-indigo-500/15 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-80 h-80 bg-teal-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-8">
    <div class="space-y-4 max-w-2xl">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-indigo-800/70 border border-indigo-600/50 rounded-full text-xs font-bold text-indigo-200">
        <span>✨ PREMIUM AI NARRATIVE REPORT</span>
      </div>

      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-black text-white tracking-tight leading-tight">
        Unlock Your In-Depth AI Personality & Behavioral Dossier
      </h2>

      <p class="text-xs sm:text-sm text-indigo-100/90 leading-relaxed font-normal">
        Go beyond your basic score with an exhaustive, multi-dimensional narrative synthesized exclusively for your response pattern on <strong class="text-white font-semibold">{assessmentName}</strong>.
      </p>

      <!-- Feature Grid Checklist -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
        <div class="flex items-center gap-2 text-xs text-indigo-200">
          <span class="w-5 h-5 rounded-full bg-indigo-500/30 text-indigo-300 flex items-center justify-center text-xs font-bold">✓</span>
          <span>Cross-construct correlation analysis</span>
        </div>
        <div class="flex items-center gap-2 text-xs text-indigo-200">
          <span class="w-5 h-5 rounded-full bg-indigo-500/30 text-indigo-300 flex items-center justify-center text-xs font-bold">✓</span>
          <span>Cognitive blindspots & trigger mapping</span>
        </div>
        <div class="flex items-center gap-2 text-xs text-indigo-200">
          <span class="w-5 h-5 rounded-full bg-indigo-500/30 text-indigo-300 flex items-center justify-center text-xs font-bold">✓</span>
          <span>Communication & relationship deep-dive</span>
        </div>
        <div class="flex items-center gap-2 text-xs text-indigo-200">
          <span class="w-5 h-5 rounded-full bg-indigo-500/30 text-indigo-300 flex items-center justify-center text-xs font-bold">✓</span>
          <span>High-resolution vector PDF export included</span>
        </div>
      </div>
    </div>

    <!-- CTA Button Block -->
    <div class="relative z-10 flex-shrink-0 w-full lg:w-auto flex flex-col items-center lg:items-end gap-3.5">
      {existingReportId ? (
        <div class="w-full lg:w-auto space-y-2.5">
          <div class="flex flex-col sm:flex-row items-center gap-2.5">
            <a
              href={`/reports/${existingReportId}`}
              class="w-full sm:w-auto px-6 py-3.5 text-xs sm:text-sm font-black text-slate-950 bg-white hover:bg-indigo-50 rounded-2xl shadow-lg transition-all flex items-center justify-center gap-2"
            >
              <span>View Detailed Report</span>
              <span>→</span>
            </a>

            <a
              href={`/api/v1/reports/${existingReportId}/pdf`}
              download
              class="w-full sm:w-auto px-5 py-3.5 text-xs sm:text-sm font-bold text-white bg-indigo-700/80 hover:bg-indigo-600 rounded-2xl border border-indigo-500/40 shadow-sm transition-all flex items-center justify-center gap-2"
            >
              <span>Download PDF</span>
              <span>📥</span>
            </a>
          </div>

          <button
            type="button"
            id="regenerate-ai-btn"
            data-attempt-id={attemptId}
            class="w-full text-center text-[11px] font-bold text-indigo-300 hover:text-white transition-colors cursor-pointer py-1"
          >
            Regenerate Report ({creditCost} credits) ↺
          </button>
        </div>
      ) : isGuest ? (
        <div class="w-full lg:w-auto space-y-2 text-center lg:text-right">
          <button
            type="button"
            id="generate-ai-btn"
            data-attempt-id={attemptId}
            class="w-full lg:w-auto px-8 py-4 text-xs sm:text-sm font-black text-white bg-indigo-600 hover:bg-indigo-500 rounded-2xl shadow-lg hover:shadow-indigo-500/30 transition-all cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Generate Detailed Report ({creditCost} Credits) ✨</span>
          </button>
          <p class="text-[11px] text-indigo-300">
            Sign in or create a free account to unlock
          </p>
        </div>
      ) : hasSufficientCredits ? (
        <div class="w-full lg:w-auto space-y-2 text-center lg:text-right">
          <button
            type="button"
            id="generate-ai-btn"
            data-attempt-id={attemptId}
            class="w-full lg:w-auto px-8 py-4 text-xs sm:text-sm font-black text-white bg-indigo-600 hover:bg-indigo-500 rounded-2xl shadow-lg hover:shadow-indigo-500/30 transition-all cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Generate Detailed Report ({creditCost} Credits) ✨</span>
          </button>
          <p class="text-[11px] text-indigo-300">
            Your Balance: <strong>{userCredits} credits</strong> (Remaining after: {userCredits - creditCost} credits)
          </p>
        </div>
      ) : (
        <div class="w-full lg:w-auto space-y-2.5 text-center lg:text-right bg-indigo-900/60 p-5 rounded-2xl border border-indigo-700/60">
          <div class="text-xs text-indigo-200">
            Your Balance: <strong class="text-white font-mono">{userCredits} credits</strong> • Requires: <strong class="text-white font-mono">{creditCost} credits</strong>
          </div>
          <a
            href="/pricing"
            class="w-full lg:w-auto px-7 py-3.5 text-xs sm:text-sm font-black text-slate-950 bg-teal-400 hover:bg-teal-300 active:scale-[0.99] rounded-xl shadow-md transition-all flex items-center justify-center gap-2"
          >
            <span>Get 20 Credits — $4.00 One-Time</span>
            <span>→</span>
          </a>
          <p class="text-[10px] text-indigo-300">
            Unlocks 4 in-depth reports • Credits never expire
          </p>
        </div>
      )}
    </div>
  </div>
</section>
