---
interface Props {
  value: number; // 0 - 100
  max?: number;
  label?: string;
  showText?: boolean;
  colorClass?: string;
}

const {
  value,
  max = 100,
  label = 'Score',
  showText = true,
  colorClass = 'bg-teal-600'
} = Astro.props;

const percentage = Math.min(100, Math.max(0, Math.round((value / max) * 100)));
---

<div class="space-y-1.5" role="progressbar" aria-valuenow={value} aria-valuemin={0} aria-valuemax={max} aria-label={label}>
  {showText && (
    <div class="flex items-center justify-between text-xs">
      <span class="font-semibold text-slate-700">{label}</span>
      <span class="font-mono font-bold text-slate-900">{percentage}%</span>
    </div>
  )}

  <div class="w-full bg-slate-100 rounded-full h-3 overflow-hidden border border-slate-200 p-0.5">
    <div
      class={`h-full rounded-full transition-all duration-500 ${colorClass}`}
      style={`width: ${percentage}%;`}
    ></div>
  </div>

  <div class="flex justify-between text-[10px] text-slate-400 font-mono">
    <span>0% (Low)</span>
    <span>50% (Moderate)</span>
    <span>100% (High)</span>
  </div>
</div>
