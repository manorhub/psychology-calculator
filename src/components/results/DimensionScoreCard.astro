---
import Card from '@/components/ui/Card.astro';
import ScoreBar from './ScoreBar.astro';
import type { SnapshotDimensionScore } from '@/types/database';

interface Props {
  dimension: SnapshotDimensionScore;
}

const { dimension } = Astro.props;
---

<Card class="p-6 space-y-4">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 class="text-sm sm:text-base font-bold text-slate-900">{dimension.dimensionName}</h3>
      {dimension.resultTypeName && (
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-teal-50 text-teal-800 border border-teal-200 mt-1">
          {dimension.resultTypeName}
        </span>
      )}
    </div>

    <div class="text-right flex-shrink-0">
      <span class="text-xl sm:text-2xl font-black text-slate-900 font-mono">
        {dimension.normalizedScore}%
      </span>
      <span class="text-[10px] text-slate-400 font-mono block">
        Raw: {dimension.rawScore} / {dimension.maxScore}
      </span>
    </div>
  </div>

  <ScoreBar
    value={dimension.normalizedScore}
    max={100}
    showText={false}
    label={dimension.dimensionName}
  />
</Card>
