---
import type { SnapshotResultContent } from '@/types/database';

interface Props {
  growthContent?: SnapshotResultContent | null;
  fallbackGrowth?: string[];
}

const { growthContent = null, fallbackGrowth = [] } = Astro.props;

let items: string[] = [];

if (growthContent?.content) {
  items = growthContent.content
    .split(/\n|•|-|\*/)
    .map((s) => s.trim())
    .filter((s) => s.length > 3);
}

if (items.length === 0 && fallbackGrowth.length > 0) {
  items = fallbackGrowth;
}

const icons = ['🌱', '🧭', '🔄', '⚖️', '🔎', '🛡️'];
---

{items.length > 0 && (
  <section id="growth" class="space-y-6">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-teal-50 text-teal-700 flex items-center justify-center text-lg border border-teal-200">
        🌱
      </div>
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          {growthContent?.title || 'Areas to Consider & Growth Pathways'}
        </h2>
        <p class="text-xs sm:text-sm text-slate-500">
          Constructive, non-judgmental opportunities for self-awareness and deliberate equilibrium
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {items.map((item, idx) => (
        <div class="bg-white rounded-3xl p-6 border border-slate-200 shadow-2xs space-y-3 hover:border-teal-300 transition-all flex items-start gap-4">
          <div class="w-8 h-8 rounded-xl bg-teal-100/80 text-teal-800 flex items-center justify-center text-sm font-bold flex-shrink-0 mt-0.5">
            {icons[idx % icons.length]}
          </div>
          <div class="space-y-1">
            <p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-medium">
              {item}
            </p>
          </div>
        </div>
      ))}
    </div>
  </section>
)}
