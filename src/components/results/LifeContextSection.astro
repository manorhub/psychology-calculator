---
import type { SnapshotResultContent } from '@/types/database';

interface Props {
  contextContents: SnapshotResultContent[];
}

const { contextContents } = Astro.props;

// Map section types to visual icons & badges
const contextMeta: Record<string, { icon: string; label: string; badgeColor: string; borderColor: string }> = {
  work_style: { icon: '💼', label: 'Work & Professional Life', badgeColor: 'bg-indigo-50 text-indigo-700 border-indigo-200', borderColor: 'border-indigo-100' },
  communication: { icon: '💬', label: 'Communication & Expression', badgeColor: 'bg-sky-50 text-sky-700 border-sky-200', borderColor: 'border-sky-100' },
  relationships: { icon: '🤝', label: 'Relationships & Social Dynamics', badgeColor: 'bg-rose-50 text-rose-700 border-rose-200', borderColor: 'border-rose-100' },
  recommendations: { icon: '🧭', label: 'Applied Daily Practices', badgeColor: 'bg-teal-50 text-teal-700 border-teal-200', borderColor: 'border-teal-100' },
  custom: { icon: '🔍', label: 'Contextual Pattern', badgeColor: 'bg-slate-100 text-slate-700 border-slate-200', borderColor: 'border-slate-200' }
};
---

{contextContents.length > 0 && (
  <section id="contexts" class="space-y-6">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-2xl bg-indigo-50 text-indigo-700 flex items-center justify-center text-lg border border-indigo-200">
        💼
      </div>
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          How This May Show Up in Daily Life
        </h2>
        <p class="text-xs sm:text-sm text-slate-500">
          Practical behavioral manifestations across professional, interpersonal, and personal domains
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
      {contextContents.map((content) => {
        const meta = contextMeta[content.section_type] || contextMeta.custom;

        return (
          <div class={`bg-white rounded-3xl p-6 sm:p-8 border ${meta.borderColor} shadow-2xs space-y-4 hover:shadow-xs transition-all`}>
            <div class="flex items-center justify-between gap-3">
              <span class={`inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold border ${meta.badgeColor}`}>
                <span>{meta.icon}</span>
                <span>{meta.label}</span>
              </span>
            </div>

            <h3 class="text-lg font-bold text-slate-900 tracking-tight">
              {content.title}
            </h3>

            <div class="text-xs sm:text-sm text-slate-700 leading-relaxed whitespace-pre-line space-y-2">
              {content.content}
            </div>
          </div>
        );
      })}
    </div>
  </section>
)}
