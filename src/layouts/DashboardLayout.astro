---
import BaseLayout from './BaseLayout.astro';
import { getD1Database } from '@/lib/db/client';
import { CreditService } from '@/services/credit.service';
import { NotificationService } from '@/services/notifications/notification.service';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Manage your assessments, psychological evaluations, and AI reports.' } = Astro.props;

const currentUser = Astro.locals.user;
if (!currentUser) {
  return Astro.redirect(`/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const creditService = new CreditService(db);
const notificationService = new NotificationService(db);

const [creditBalance, unreadNotifs] = await Promise.all([
  creditService.getUserBalance(currentUser.id),
  notificationService.getUnreadCount(currentUser.id)
]);

const pathname = Astro.url.pathname;

const navItems = [
  { name: 'Dashboard', href: '/dashboard', icon: '📊' },
  { name: 'My Assessments', href: '/dashboard/assessments', icon: '📝' },
  { name: 'My Results', href: '/dashboard/results', icon: '🎯' },
  { name: 'AI Reports', href: '/dashboard/reports', icon: '✨' },
  { name: 'Notifications', href: '/dashboard/notifications', icon: '🔔', badge: unreadNotifs > 0 ? unreadNotifs : undefined },
  { name: 'Subscription', href: '/dashboard/subscription', icon: '💳' },
  { name: 'Credits & Usage', href: '/dashboard/credits', icon: '💎' },
  { name: 'Profile', href: '/dashboard/profile', icon: '👤' },
  { name: 'Settings', href: '/dashboard/settings', icon: '⚙️' }
];

const initials = currentUser.profile.displayName
  ? currentUser.profile.displayName.substring(0, 2).toUpperCase()
  : currentUser.email.substring(0, 2).toUpperCase();
---

<BaseLayout title={`${title} | Psychology Calculator`} description={description}>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <div class="min-h-screen bg-slate-50 flex flex-col md:flex-row">
    <!-- Desktop Sidebar -->
    <aside class="hidden md:flex flex-col w-64 bg-white border-r border-slate-200 min-h-screen p-4 justify-between">
      <div class="space-y-6">
        <!-- Logo & Branding -->
        <a href="/dashboard" class="flex items-center gap-2 px-2 py-1">
          <div class="w-8 h-8 rounded-xl bg-teal-600 flex items-center justify-center text-white font-black text-base shadow-xs">
            Ψ
          </div>
          <div>
            <span class="font-extrabold text-sm text-slate-900 tracking-tight block">Psychology Calculator</span>
            <span class="text-[10px] text-teal-700 font-semibold uppercase tracking-wider block">User Portal</span>
          </div>
        </a>

        <!-- Credits Pill -->
        <a
          href="/dashboard/credits"
          class="flex items-center justify-between p-3 bg-gradient-to-r from-teal-50 to-indigo-50 border border-teal-100 rounded-2xl hover:border-teal-300 transition-colors shadow-2xs"
        >
          <div class="flex items-center gap-2">
            <span class="text-base">💎</span>
            <div>
              <span class="text-[10px] uppercase font-bold text-slate-500 block">AI Credits</span>
              <span class="text-xs font-black text-teal-900 font-mono">{creditBalance.balance} Balance</span>
            </div>
          </div>
          <span class="text-[10px] text-teal-700 font-bold">Manage →</span>
        </a>

        <!-- Navigation Links -->
        <nav class="space-y-1">
          {navItems.map((item) => {
            const isActive = pathname === item.href || (item.href !== '/dashboard' && pathname.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all ${
                  isActive
                    ? 'bg-teal-600 text-white shadow-xs'
                    : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'
                }`}
              >
                <div class="flex items-center gap-3">
                  <span>{item.icon}</span>
                  <span>{item.name}</span>
                </div>
                {item.badge && (
                  <span class={`px-2 py-0.5 text-[10px] font-black rounded-full ${isActive ? 'bg-white text-teal-800' : 'bg-rose-500 text-white'}`}>
                    {item.badge}
                  </span>
                )}
              </a>
            );
          })}
        </nav>
      </div>

      <!-- User Profile & Sign Out Footer -->
      <div class="pt-4 border-t border-slate-100 space-y-3">
        <div class="flex items-center gap-3 px-2">
          <div class="w-8 h-8 rounded-full bg-slate-900 text-white flex items-center justify-center font-bold text-xs shadow-xs">
            {initials}
          </div>
          <div class="overflow-hidden">
            <span class="font-bold text-xs text-slate-900 block truncate">
              {currentUser.profile.displayName || 'Member'}
            </span>
            <span class="text-[10px] text-slate-400 block truncate">{currentUser.email}</span>
          </div>
        </div>

        <div class="flex items-center justify-between px-2 pt-1">
          <a href="/" class="text-[11px] font-semibold text-slate-500 hover:text-teal-700">
            ← Explore Tests
          </a>
          <button
            type="button"
            id="sidebar-logout-btn"
            class="text-[11px] font-semibold text-rose-600 hover:text-rose-700 cursor-pointer"
          >
            Sign Out
          </button>
        </div>
      </div>
    </aside>

    <!-- Mobile Header & Navigation -->
    <div class="md:hidden bg-white border-b border-slate-200 p-4 sticky top-0 z-30 flex items-center justify-between">
      <a href="/dashboard" class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-xl bg-teal-600 flex items-center justify-center text-white font-black text-sm">
          Ψ
        </div>
        <span class="font-extrabold text-xs text-slate-900">Psychology Calculator</span>
      </a>

      <div class="flex items-center gap-2">
        <a href="/dashboard/credits" class="px-2.5 py-1 bg-teal-50 border border-teal-200 rounded-lg text-xs font-mono font-bold text-teal-800">
          💎 {creditBalance.balance}
        </a>
        <button
          type="button"
          id="mobile-menu-btn"
          class="p-2 text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg text-xs font-bold"
          aria-label="Toggle Navigation"
        >
          ☰
        </button>
      </div>
    </div>

    <!-- Mobile Drawer -->
    <div id="mobile-drawer" class="hidden md:hidden bg-white border-b border-slate-200 p-4 space-y-2">
      <nav class="space-y-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`flex items-center gap-3 px-3 py-2 rounded-xl text-xs font-bold ${
              pathname === item.href ? 'bg-teal-600 text-white' : 'text-slate-600 hover:bg-slate-100'
            }`}
          >
            <span>{item.icon}</span>
            <span>{item.name}</span>
          </a>
        ))}
      </nav>
      <div class="pt-2 border-t border-slate-100 flex items-center justify-between text-xs">
        <span class="text-slate-500 truncate">{currentUser.email}</span>
        <button type="button" id="mobile-logout-btn" class="text-rose-600 font-bold">
          Sign Out
        </button>
      </div>
    </div>

    <!-- Main Content Area -->
    <main class="flex-1 p-4 sm:p-8 lg:p-10 max-w-6xl w-full mx-auto">
      <slot />
    </main>
  </div>
</BaseLayout>

<script is:inline>
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileDrawer = document.getElementById('mobile-drawer');

  mobileBtn?.addEventListener('click', () => {
    mobileDrawer?.classList.toggle('hidden');
  });

  const handleLogout = async () => {
    try {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/login';
    } catch {
      window.location.href = '/login';
    }
  };

  document.getElementById('sidebar-logout-btn')?.addEventListener('click', handleLogout);
  document.getElementById('mobile-logout-btn')?.addEventListener('click', handleLogout);
</script>
