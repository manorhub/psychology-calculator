---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import { ConfigService } from '@/services/config.service';
import { getD1Database } from '@/lib/db/client';
import { normalizeLocale } from '@/i18n';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  locale?: string;
}

const { title, description, canonicalUrl, ogImage, ogType, noindex, locale: propLocale } = Astro.props;
const currentLocale = normalizeLocale(propLocale || Astro.currentLocale || Astro.url.pathname.split('/')[1]);

// Resolve dynamic configuration from D1 (or fallback defaults)
const env = Astro.locals.runtime?.env;
const db = getD1Database(env);
const configService = new ConfigService(db);
const siteConfig = await configService.getSiteConfig();
---

<BaseLayout
  title={title}
  description={description || siteConfig.siteDescription}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  ogType={ogType}
  noindex={noindex}
  locale={currentLocale}
>
  <slot name="head" slot="head" />
  <Header config={siteConfig} locale={currentLocale} />
  <main class="flex-1">
    <slot />
  </main>
  <Footer config={siteConfig} locale={currentLocale} />
</BaseLayout>
