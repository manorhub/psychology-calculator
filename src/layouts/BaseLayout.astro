---
import '@/styles/global.css';
import SEOHead from '@/components/seo/SEOHead.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
}

const { title, description, canonicalUrl, ogImage, noindex } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body class="min-h-full flex flex-col bg-slate-50 text-slate-900 selection:bg-teal-500 selection:text-white">
    <slot />
  </body>
</html>
