---
import '@/styles/global.css';
import SEOHead from '@/components/seo/SEOHead.astro';
import { normalizeLocale, SUPPORTED_LANGUAGES, DEFAULT_LOCALE } from '@/i18n';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
  locale?: string;
}

const { title, description, canonicalUrl, ogImage, noindex, locale: propLocale } = Astro.props;
const currentLocale = normalizeLocale(propLocale || Astro.currentLocale || Astro.url.pathname.split('/')[1]);
const langInfo = SUPPORTED_LANGUAGES[currentLocale] || SUPPORTED_LANGUAGES[DEFAULT_LOCALE];
---

<!doctype html>
<html lang={currentLocale} dir={langInfo.dir} class="h-full">
  <head>
    <SEOHead
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      ogImage={ogImage}
      noindex={noindex}
      locale={currentLocale}
    />
    <slot name="head" />
  </head>
  <body class="min-h-full flex flex-col bg-slate-50 text-slate-900 selection:bg-teal-500 selection:text-white">
    <slot />
  </body>
</html>
