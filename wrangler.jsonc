{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "psychology-saas",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  // Cloudflare D1 Database Binding
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "psychology_db",
      "database_id": "2efb24b6-eccc-496d-a18e-cc6d03c07460",
      "migrations_dir": "migrations"
    }
  ],
  // Cloudflare R2 Bucket Binding
  "r2_buckets": [
    {
      "binding": "STORAGE",
      "bucket_name": "psychology-assets"
    }
  ],
  // Cloudflare KV Namespace for Sessions
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "fc9b3f4a20974cc0af6be368975dc939"
    }
  ],
  // Public/Runtime Environment Variables
  "vars": {
    "APP_ENV": "production",
    "APP_URL": "https://www.psychologycalculator.com",
    "SITE_NAME": "Psychology Calculator"
  }
}
