# ==========================================
# Psychology SaaS - Environment Variables Template
# Copy this file to .env for local development
# NEVER commit real secrets to source control.
# ==========================================

# --- Runtime & App Environment ---
APP_ENV=development
APP_URL=http://localhost:4321
SITE_NAME=MindMetrics

# --- Cloudflare Bindings (Auto-bound in Cloudflare Workers / Wrangler) ---
# D1: DB
# R2: STORAGE

# --- Authentication Secrets (Phase 1+) ---
# AUTH_SECRET=your-random-32-byte-secret-hex
# ADMIN_EMAIL=admin@example.com

# --- AI Provider API Keys (Phase 2+) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...

# --- Payment & Billing Secrets (Phase 3+) ---
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Analytics & Monitoring ---
# PUBLIC_PLAUSIBLE_DOMAIN=
# PUBLIC_GA_ID=
